# Stable AIDL v2 allocator; its mapper suffix is quest2 (native mapper5).
service vendor.graphics.allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service default
    class hal animation
    interface aidl android.hardware.graphics.allocator.IAllocator/default
    user system
    seclabel u:r:hal_graphics_allocator_default:s0
    group graphics drmrpc
    capabilities SYS_NICE
    setenv LD_LIBRARY_PATH /vendor/lib64/sq2-qti-display:/system/lib64:/apex/com.android.i18n/lib64:/apex/com.android.tethering/lib64:/vendor/lib64
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow
