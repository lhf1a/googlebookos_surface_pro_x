  "prerequisite_analysis": {
    "upstream_commit": "60a4e18e0e8ab27d7dfd1316eab31706176481e9",
    "title": "drm/msm/adreno: Do CX GBIF config before GMU start",
    "author": "Akhil P Oommen <akhilpo@oss.qualcomm.com>",
    "date": "2025-11-18",
    "upstream_release": "6.19",
    "present_in_6.18.60": false,
    "evidence": "6.18.60 has no gbif_cx member in struct a6xx_info, no a640_gbif register list, and still programs REG_A6XX_GBIF_QSB_SIDE0..3 in a6xx_gpu.c hw_init(). Patch 0001 supplies the a6xx/A7xx subset of 60a4e18e0e8a; patch 0002 then adds the missing A640/A680 catalog entries.",
    "risk": "0001 is a local delta that does not exist in any release. If 6.18 LTS later backports 60a4e18e0e8a (or a vendor tree already contains it), drop 0001 and re-adapt 0002 to that shape instead of stacking both.",
    "kept_behaviour": "The legacy hw_init() GBIF_QSB_SIDE0..3 writes are retained so no existing GPU family loses its configuration; the catalog list additionally programs CX GBIF before the GMU is woken up."
  },
