CONFIG_LOCALVERSION="-sq2-test3"
CONFIG_HID_MULTITOUCH=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_SPI_HID=m
CONFIG_RTC_DRV_SURFACE=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_RFKILL=y
CONFIG_DEBUG_FS=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
# QEMU transport for end-to-end SSH tests (unused on the Surface).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
