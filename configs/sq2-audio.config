# Physical SQ2 audio: load platform drivers explicitly after ADSP/SSH startup.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_PCM=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_QCOM=m
CONFIG_QCOM_APR=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SDM845=m
CONFIG_SLIMBUS=m
CONFIG_DMADEVICES=y
CONFIG_QCOM_BAM_DMA=m
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_MFD_WCD934X=m
CONFIG_GPIO_WCD934X=m
CONFIG_SND_SOC_WCD934X=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SOC_WSA881X=m
# Useful for future external audio testing; no synthetic ALSA sound card.
CONFIG_SND_USB_AUDIO=m
