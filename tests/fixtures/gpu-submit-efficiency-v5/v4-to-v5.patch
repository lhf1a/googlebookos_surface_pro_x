+/* All descriptors have been looked up and own GEM references before these
+ * loops.  Hint a bounded future object, never userspace data or fence-list
+ * contents.  This changes neither traversal order nor synchronization.
+ */
+static inline struct drm_gem_object *
+submit_bo_lookahead(struct msm_gem_submit *submit, unsigned i)
+{
+	const unsigned distance = 8;
+
+	if (i >= submit->nr_bos || submit->nr_bos - i <= distance)
+		return NULL;
+	return submit->bos[i + distance].obj;
+}
+
+static inline void submit_prefetch_resv(struct msm_gem_submit *submit, unsigned i)
+{
+	struct drm_gem_object *obj = submit_bo_lookahead(submit, i);
+
+	if (obj) {
+		prefetch(obj);
+		prefetch(obj->resv);
+	}
+}
+
+static inline void submit_prefetch_object(struct msm_gem_submit *submit, unsigned i)
+{
+	struct drm_gem_object *obj = submit_bo_lookahead(submit, i);
+
+	if (obj) {
+		prefetch(&obj->gpuva);
+		prefetch(&obj->lru);
+		prefetch(&to_msm_bo(obj)->madv);
+	}
+}
