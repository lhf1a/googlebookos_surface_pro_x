on post-fs
    restorecon /vendor/bin/hw/android.hardware.biometrics.face-service.default
    restorecon /vendor/bin/spx-face-cli
    restorecon /vendor/etc/vintf/manifest/android.hardware.biometrics.face-service.spx.xml
    restorecon /vendor/etc/init/android.hardware.biometrics.face-service.spx.rc
    restorecon /vendor/etc/permissions/android.hardware.biometrics.face.xml
    restorecon /vendor/overlay/spx-face-overlay.apk

on post-fs-data
    mkdir /data/vendor_de/0/facedata 0700 system system
    restorecon /data/vendor_de/0/facedata

service vendor.face-default /vendor/bin/hw/android.hardware.biometrics.face-service.default
    class hal
    user system
    group system camera input
    interface aidl android.hardware.biometrics.face.IFace/default
