#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Result { uint words[]; } result;
layout(push_constant) uniform Params { uint seed; uint iterations; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint value = i * 1664525u + params.seed;
    for (uint step = 0u; step < params.iterations; step++)
        value = value * 1664525u + 1013904223u;
    result.words[i] = value ^ 0x9e3779b9u;
}
