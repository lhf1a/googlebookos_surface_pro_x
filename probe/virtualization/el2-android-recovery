#!/bin/busybox sh
case " $(cat /proc/cmdline) " in *' sq2.el2=experimental '*) ;; *) exit 1;; esac
echo 'EL2 Android v15: automatic normal recovery in 360 seconds unless /run/el2-control-keep exists'
sleep 180
echo '=== Android status at 180 seconds ==='
nsenter -t 1 -m -r -- /system/bin/getprop sys.boot_completed
ls /sys/class/net
ls -l /dev/kvm /dev/vhost-vsock /dev/video0
cat /logs/el2-terminal.txt
cat /proc/sys/kernel/random/boot_id
for p in /sys/class/remoteproc/remoteproc*; do cat "$p/name" "$p/state"; done
sleep 180
if [ -e /run/el2-control-keep ]; then echo 'Recovery canceled after operator validation'; exit 0; fi
echo 'EL2 control finished; returning to normal default'
sync
nsenter -t 1 -m -r -- /system/bin/setprop sys.powerctl reboot
sleep 15
sync
reboot -f
