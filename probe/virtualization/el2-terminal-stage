#!/bin/busybox sh
# EL2 prerequisites; original images and account credentials untouched.
set -eu
case " $(cat /proc/cmdline) " in *' sq2.el2=experimental '*|*' sq2.el2=1 '*) ;; *) exit 0;; esac
# Preserve the normal hardware-decoder path in the full Android candidate.
case " $(cat /proc/cmdline) " in *' sq2.video=0 '*) exit 1;; esac
test -f /etc/sq2-video-native/venus-core.ko
test -f /etc/sq2-video-native/venus-dec.ko
test -c /dev/kvm
test -c /dev/vhost-vsock
# Netd creates the upstream clsact qdisc before Terminal starts.
modprobe sch_ingress
modprobe cls_bpf
grep -q '^overlay /newroot/vendor overlay ' /proc/mounts
f=/newroot/vendor/etc/vintf/manifest/android.hardware.security.secretkeeper.trusty.xml
test -f "$f"
grep -q '<name>android.hardware.security.secretkeeper</name>' "$f"
# This Surface has no working Trusty Secretkeeper; do not advertise it to AVF.
# Only the ephemeral vendor overlay is changed, never /data or saved secrets.
rm "$f"
printf 'SQ2_EL2_TERMINAL_STAGE_READY: normal (non-protected) KVM only\n'
