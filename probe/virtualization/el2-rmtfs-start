#!/bin/busybox sh
# Preserve normal modem start; paired EFI handoff must not reset it again.
case " $(cat /proc/cmdline) " in
    *' sq2.el2=experimental '*) ;;
    *) exec rmtfs -r -o /run/rmtfs -s -v ;;
esac
found=0
for p in /sys/class/remoteproc/remoteproc*; do
    [ "$(cat "$p/name" 2>/dev/null)" = 4080000.remoteproc ] || continue
    [ "$(cat "$p/state" 2>/dev/null)" = attached ] || {
        echo 'EL2 RMTFS: modem was not attached; refusing a firmware restart' >&2
        exit 1
    }
    [ "$(cat "$p/firmware" 2>/dev/null)" = qcom/msft/surface/pro-x-sq2/qcmpss8180.mbn ] || exit 1
    found=$((found + 1))
done
[ "$found" = 1 ] || { echo 'EL2 RMTFS: expected one verified modem' >&2; exit 1; }
test -c /dev/qcom_rmtfs_mem1 || exit 1
exec rmtfs -r -o /run/rmtfs -v
