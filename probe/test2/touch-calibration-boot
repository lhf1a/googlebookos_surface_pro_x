#!/bin/busybox sh
# Per-device first-run calibration. No HID reader, network changes or input logging.
set -eu
export PATH=/bin:/sbin
grep -qE 'sq2.rescue=1|sq2.calibration=0' /proc/cmdline && exit 0
mkdir /run/touch-calibration-lock 2>/dev/null || exit 0
trap 'rmdir /run/touch-calibration-lock 2>/dev/null || true' EXIT
android() { timeout "${ANDROID_COMMAND_TIMEOUT:-15}" nsenter -t 1 -m -r -- /system/bin/"$@"; }
tool=/bin/touch-calibration-profile
for n in $(seq 1 240); do
    [ "$(android getprop sys.boot_completed 2>/dev/null || true)" = 1 ] && break
    sleep 1
done
[ "$(android getprop sys.boot_completed)" = 1 ] || exit 1
# Wait for the existing post-framework reinitialization, avoiding concurrent restarts.
for n in $(seq 1 60); do
    grep -q SQ2_COVER_AND_POWER_INPUT_READY /logs/power-input-boot.txt 2>/dev/null && break
    sleep 1
done
sensor=
for d in /sys/class/hidraw/hidraw*; do
    if grep -qE '^HID_ID=001C:0000045E:0000(0C21|0996)$' "$d/device/uevent"; then sensor=$d; break; fi
done
[ -n "$sensor" ] || { echo CALIBRATION_UNSUPPORTED_SENSOR; exit 0; }
# Keep this result tied to this board, display EDID and HID descriptor; not Android's fixed lab serial.
[ -s /sys/class/dmi/id/product_uuid ] || exit 1
[ "$(wc -c < /sys/class/drm/card0-eDP-1/edid)" -ge 128 ] || exit 1
device=$({ cat /sys/class/dmi/id/product_uuid; cat /sys/class/drm/card0-eDP-1/edid; cat "$sensor/device/report_descriptor"; } | sha256sum | cut -d ' ' -f1)
store=/proc/1/root/data/vendor/sq2-touch-calibration
mkdir -p "$store"; chmod 700 "$store"
saved=$store/$device.profile
noise=/run/iptsd-noise
mkdir -p "$noise"; chmod 700 "$noise"
noise_saved=$store/$device.noise
noise_preview=0; noise_until=0
noise_cmd() {
    printf '%s %s %s\n' "$1" "$device" "$2" > "$noise/command.new"
    mv "$noise/command.new" "$noise/command"
}
noise_begin() {
    noise_cmd "$1" "$2"
    for i in $(seq 1 25); do
        [ "$(head -n 1 "$noise/status" 2>/dev/null | cut -d ' ' -f1,2)" = "$2 learning" ] && return 0
        sleep .2
    done
    return 1
}
noise_reload() {
    noise_cmd reload "$1"
    for i in $(seq 1 25); do
        [ "$(head -n 1 "$noise/status" 2>/dev/null | cut -d ' ' -f1,2)" = "$1 applied" ] && return 0
        sleep .2
    done
    return 1
}
noise_restore() {
    if [ -f "$noise/previous" ]; then cp "$noise/previous" "$noise/active.new"; mv "$noise/active.new" "$noise/active"; else rm -f "$noise/active"; fi
    noise_cmd reload "restore-$(cut -d . -f1 /proc/uptime)"
    noise_preview=0
}
# Only a validated profile for this board+EDID+descriptor can be activated.
if [ -x /bin/touch-noise-profile ] && [ -f "$noise_saved" ] && [ ! -L "$noise_saved" ]; then
    /bin/touch-noise-profile "$device" < "$noise_saved" > "$noise/active.new" && mv "$noise/active.new" "$noise/active"
fi
tap_saved=$store/$device.tap
tap_preview=0; tap_until=0
tap_reload() {
    noise_cmd tapreload "$1"
    for i in $(seq 1 25); do
        [ "$(head -n 1 "$noise/tap-status" 2>/dev/null | cut -d ' ' -f1,2)" = "$1 applied" ] && return 0
        sleep .2
    done
    return 1
}
tap_restore() {
    if [ -f "$noise/tap-previous" ]; then cp "$noise/tap-previous" "$noise/tap-active.new"; mv "$noise/tap-active.new" "$noise/tap-active"; else rm -f "$noise/tap-active"; fi
    tap_preview=0
    tap_reload "taprestore-$(cut -d . -f1 /proc/uptime)"
}
if [ -x /bin/touch-tap-profile ] && [ -f "$tap_saved" ] && [ ! -L "$tap_saved" ]; then
    /bin/touch-tap-profile "$device" < "$tap_saved" > "$noise/tap-active.new" && mv "$noise/tap-active.new" "$noise/tap-active"
fi
base=/etc/iptsd.conf
effective=/run/iptsd-calibrated.conf
neutral=/run/touch-calibration-neutral.profile
printf 'Version=1\nDevice=%s\nCalibrationX=\nCalibrationY=\nCalibrationXTop=\nCalibrationTopStart=0.1\nCalibrationTopEnd=0.3\nContactSizeMax=2.0\n' "$device" > "$neutral"
apply() {
    "$tool" validate "$device" < "$1" > /run/touch-calibration-section.new || return 1
    { cat "$base"; printf '\n'; cat /run/touch-calibration-section.new; } > "$effective.new"
    mv "$effective.new" "$effective"
    # Coordinate previews restart IPTSd. Its new process must load the already
    # confirmed noise rule before sampling, not replay a stale learn command.
    reload_nonce="coordinate-$(cut -d ' ' -f1 /proc/uptime | tr -d .)"
    noise_cmd reload "$reload_nonce"
    /bin/touch-framework-ready || return 1
    if [ -s "$noise/version" ]; then noise_reload "$reload_nonce-ready" || return 1; fi
}
valid=0
if [ -f "$saved" ] && [ ! -L "$saved" ] && "$tool" validate "$device" < "$saved" > /dev/null; then valid=1; fi
if [ "$valid" = 1 ]; then cp "$saved" /run/touch-calibration-current.profile; else cp "$neutral" /run/touch-calibration-current.profile; fi
apply /run/touch-calibration-current.profile || { rm -f "$effective"; /bin/touch-services; exit 1; }
noise_cmd reload boot
user=$(android cmd activity get-current-user)
case "$user" in ''|*[!0-9]*) exit 1;; esac
pkg=org.surface.touchcalibration.unified
apk=/etc/sq2-touch-calibration/wizard.apk
installed=$(android pm path "$pkg" 2>/dev/null | sed -n 's/^package://p' | head -n 1)
if [ -n "$installed" ] && [ -f "/proc/1/root$installed" ] &&
   [ "$(sha256sum "/proc/1/root$installed" | cut -d ' ' -f1)" = "$(sha256sum "$apk" | cut -d ' ' -f1)" ]; then
    # A helper restart must not close an identical APK mid-calibration.
    echo 'Success (identical installed APK retained)' > /logs/touch-calibration-install.txt
else
    cp "$apk" /proc/1/root/data/local/tmp/sq2-touch-calibration.apk
    ANDROID_COMMAND_TIMEOUT=120 android pm install -r --user "$user" /data/local/tmp/sq2-touch-calibration.apk > /logs/touch-calibration-install.txt
    rm -f /proc/1/root/data/local/tmp/sq2-touch-calibration.apk
fi
# Preserve the old signed package/data for rollback; expose only the merged UI.
android pm disable-user --user "$user" org.surface.touchcalibration > /logs/touch-calibration-legacy-hidden.txt 2>&1 || true
files=/proc/1/root/data/user_de/$user/$pkg/files
if [ -d "$files" ] && [ ! -L "$files" ]; then rm -f "$files/request"; fi
if [ "$valid" = 0 ] && [ ! -e "$store/$device.prompted" ]; then
    # Nonblocking onboarding: never dismiss the lock screen or modify credentials.
    android am start --user "$user" -n "$pkg/org.surface.touchcalibration.MainActivity" > /dev/null
fi
preview=0;until_time=0;context_sent=0;cycles=0
reply() { printf '%s\n%s\n' "$nonce" "$1" | "$tool" publish "$files" reply; }
context() { "$tool" publish "$files" context < /run/touch-calibration-current.profile; }
restore() {
    apply /run/touch-calibration-current.profile
    preview=0;context_sent=0
}
cleanup() { if [ "$tap_preview" = 1 ]; then tap_restore || true; fi; if [ "$noise_preview" = 1 ]; then noise_restore || true; fi; if [ "$preview" = 1 ]; then restore || true; fi; rmdir /run/touch-calibration-lock 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 0' TERM INT
while true; do
    if [ "$tap_preview" = 1 ] && [ "$(cut -d . -f1 /proc/uptime)" -ge "$tap_until" ]; then tap_restore; fi
    if [ "$noise_preview" = 1 ] && [ "$(cut -d . -f1 /proc/uptime)" -ge "$noise_until" ]; then noise_restore; fi
    if [ "$preview" = 1 ] && [ "$(cut -d . -f1 /proc/uptime)" -ge "$until_time" ]; then restore; fi
    if [ -d "$files" ] && [ ! -L "$files" ]; then
        if [ "$context_sent" = 0 ]; then context; context_sent=1; fi
        if [ -f "$noise/status" ]; then { head -c 512 "$noise/status"; [ ! -f "$noise/power" ] || cat "$noise/power"; } | "$tool" publish "$files" noise-status; fi
        if [ -f "$noise/tap-status" ]; then head -c 512 "$noise/tap-status" | "$tool" publish "$files" tap-status; fi
        request=$files/request
        if [ -f "$request" ] && [ ! -L "$request" ] && [ "$(stat -c %s "$request")" -le 4096 ]; then
            cp "$request" /run/touch-calibration-request
            rm -f "$request"
            command=$(sed -n 1p /run/touch-calibration-request)
            nonce=$(sed -n 2p /run/touch-calibration-request)
            [ "${#nonce}" -le 64 ] || continue
            case "$nonce" in ''|*[!a-z0-9-]*) sleep 1; continue;; esac
            case "$command" in
                tap-begin)
                    if [ "$(cat "$noise/version" 2>/dev/null)" != 7 ] || [ ! -x /bin/touch-tap-profile ]; then reply ERROR;continue;fi
                    if [ "$tap_preview" = 1 ]; then tap_restore; fi
                    rm -f "$noise/tap-candidate"
                    noise_cmd taplearn "$nonce"
                    ok=0
                    for i in $(seq 1 25); do
                        [ "$(head -n 1 "$noise/tap-status" 2>/dev/null | cut -d ' ' -f1,2)" = "$nonce learning" ] && { ok=1; break; };sleep .2
                    done
                    if [ "$ok" = 1 ]; then reply OK;else reply ERROR;fi
                    ;;
                tap-finish)
                    noise_cmd tapfinish "$nonce";ok=0
                    for i in $(seq 1 25); do
                        [ "$(head -n 1 "$noise/tap-status" 2>/dev/null | cut -d ' ' -f1,2)" = "$nonce ready" ] && { ok=1; break; };sleep .2
                    done
                    if [ "$ok" = 1 ] && /bin/touch-tap-profile "$device" < "$noise/tap-candidate" > /dev/null; then
                        "$tool" publish "$files" tap-status < "$noise/tap-status";reply OK
                    else reply ERROR;fi
                    ;;
                tap-apply)
                    if [ "$tap_preview" = 1 ] || ! /bin/touch-tap-profile "$device" < "$noise/tap-candidate" > "$noise/tap-active.new"; then reply ERROR;continue;fi
                    rm -f "$noise/tap-previous"
                    [ ! -f "$noise/tap-active" ] || cp "$noise/tap-active" "$noise/tap-previous"
                    mv "$noise/tap-active.new" "$noise/tap-active"
                    tap_preview=1;tap_until=$(( $(cut -d . -f1 /proc/uptime) + 600 ))
                    if tap_reload "$nonce";then reply OK;else tap_restore;reply ERROR;fi
                    ;;
                tap-retest)
                    if [ "$tap_preview" != 1 ];then reply ERROR;continue;fi
                    tap_until=$(( $(cut -d . -f1 /proc/uptime) + 600 ));reply OK
                    ;;
                tap-save)
                    if [ "$tap_preview" = 1 ] && /bin/touch-tap-profile "$device" < "$noise/tap-active" > "$tap_saved.new"; then
                        chmod 600 "$tap_saved.new";sync;mv "$tap_saved.new" "$tap_saved";sync;tap_preview=0;if noise_reload "$nonce"; then reply OK;else reply ERROR;fi
                    else reply ERROR;fi
                    ;;
                tap-cancel)
                    if [ "$tap_preview" = 1 ];then tap_restore;else tap_reload "$nonce";fi
                    if noise_reload "$nonce"; then reply OK;else reply ERROR;fi
                    ;;
                noise-learn)
                    case "$(cat "$noise/version" 2>/dev/null)" in 7) ;; *) reply ERROR;continue;; esac
                    if [ ! -x /bin/touch-noise-profile ]; then reply ERROR;continue;fi
                    if [ "$noise_preview" = 1 ]; then noise_restore; fi
                    rm -f "$noise/candidate"
                    power=$(cat /sys/class/power_supply/ADP1/online 2>/dev/null || printf unknown)
                    case "$power" in 0|1) ;; *) power=unknown;; esac
                    printf 'power_online=%s\n' "$power" > "$noise/power"
                    if noise_begin learn "$nonce"; then reply OK;else noise_reload "$nonce-cancel";reply ERROR;fi
                    ;;
                noise-export)
                    state=$(head -n 1 "$noise/status" 2>/dev/null | cut -d ' ' -f2)
                    case "$state" in ready|line_noise) ;; *) reply ERROR;continue;; esac
                    if /bin/touch-noise-profile "$device" < "$noise/candidate" > "$noise/export.new"; then
                        "$tool" publish "$files" noise-patch < "$noise/export.new";reply OK
                    else reply ERROR; fi
                    ;;
                noise-retest|noise-slide)
                    # A timed-out preview must not silently become a baseline retest.
                    requested=$(sed -n 3p /run/touch-calibration-request)
                    if [ "$requested" = preview ] && [ "$noise_preview" != 1 ]; then reply ERROR;continue;fi
                    # Observe original heatmaps again, WITHOUT restoring the active patch.
                    # Android reports the post-mitigation contacts in the same window.
                    case "$(cat "$noise/version" 2>/dev/null)" in 7) ;; *) reply ERROR;continue;; esac
                    if [ "$noise_preview" = 1 ]; then noise_until=$(( $(cut -d . -f1 /proc/uptime) + 600 )); fi
                    power=$(cat /sys/class/power_supply/ADP1/online 2>/dev/null || printf unknown)
                    case "$power" in 0|1) ;; *) power=unknown;; esac
                    printf 'power_online=%s\n' "$power" > "$noise/power"
                    op=learn; [ "$command" != noise-slide ] || op=slide
                    [ "$requested" != preview ] || op=$op-test
                    if noise_begin "$op" "$nonce"; then reply OK;else noise_reload "$nonce-cancel";reply ERROR;fi
                    ;;
                noise-apply)
                    state=$(head -n 1 "$noise/status" 2>/dev/null | cut -d ' ' -f2)
                    case "$state" in ready|line_noise) ;; *) reply ERROR;continue;; esac
                    if ! /bin/touch-noise-profile "$device" < "$noise/candidate" > "$noise/active.new"; then reply ERROR; continue; fi
                    if [ "$noise_preview" != 1 ]; then
                        rm -f "$noise/previous"
                        [ ! -f "$noise/active" ] || cp "$noise/active" "$noise/previous"
                    fi
                    mv "$noise/active.new" "$noise/active"
                    noise_preview=1;noise_until=$(( $(cut -d . -f1 /proc/uptime) + 600 ))
                    if noise_reload "$nonce"; then reply OK; else noise_restore;reply ERROR; fi
                    ;;
                noise-save)
                    if [ "$noise_preview" = 1 ] && /bin/touch-noise-profile "$device" < "$noise/active" > "$noise_saved.new"; then
                        chmod 600 "$noise_saved.new";sync;mv "$noise_saved.new" "$noise_saved";sync
                        noise_preview=0;if noise_reload "$nonce"; then reply OK;else reply ERROR;fi
                    else reply ERROR; fi
                    ;;
                noise-resume)
                    if [ "$noise_preview" = 1 ]; then reply ERROR;continue;fi
                    if noise_reload "$nonce"; then reply OK;else reply ERROR;fi
                    ;;
                noise-cancel)
                    if [ "$noise_preview" = 1 ]; then noise_restore; else noise_cmd reload "$nonce"; fi
                    reply OK
                    ;;
                preview)
                    if [ "$preview" = 1 ]; then restore; fi
                    tail -n +3 /run/touch-calibration-request > /run/touch-calibration-candidate.profile
                    if "$tool" validate "$device" < /run/touch-calibration-candidate.profile > /dev/null && apply /run/touch-calibration-candidate.profile; then
                        preview=1;until_time=$(( $(cut -d . -f1 /proc/uptime) + 180 ));reply OK
                    else restore;reply ERROR; fi
                    ;;
                save)
                    if [ "$preview" = 1 ]; then
                        cp /run/touch-calibration-candidate.profile "$saved.new"
                        chmod 600 "$saved.new";sync;mv "$saved.new" "$saved";sync
                        cp "$saved" /run/touch-calibration-current.profile
                        preview=0;context_sent=0;touch "$store/$device.prompted";reply OK
                    else reply ERROR; fi
                    ;;
                cancel|skip)
                    if [ "$preview" = 1 ]; then restore; fi
                    touch "$store/$device.prompted";reply OK
                    ;;
                *) reply ERROR;;
            esac
        fi
    fi
    # A user switch closes the old preview and installs/serves the current user's UI.
    cycles=$((cycles+1))
    if [ "$cycles" -ge 10 ]; then
        cycles=0
        if [ "$(android cmd activity get-current-user)" != "$user" ]; then
            cleanup;trap - EXIT TERM INT;exec /bin/touch-calibration-boot
        fi
    fi
    sleep 2
done
