#!/bin/busybox sh
# Per-device first-run calibration. No HID reader, network changes or input logging.
set -eu
export PATH=/bin:/sbin
grep -qE 'sq2.rescue=1|sq2.calibration=0' /proc/cmdline && exit 0
mkdir /run/touch-calibration-lock 2>/dev/null || exit 0
trap 'rmdir /run/touch-calibration-lock 2>/dev/null || true' EXIT
android() { timeout "${ANDROID_COMMAND_TIMEOUT:-15}" nsenter -t 1 -m -r -- /system/bin/"$@"; }
tool=/bin/touch-calibration-profile
for n in $(seq 1 240); do
    [ "$(android getprop sys.boot_completed 2>/dev/null || true)" = 1 ] && break
    sleep 1
done
[ "$(android getprop sys.boot_completed)" = 1 ] || exit 1
# Wait for the existing post-framework reinitialization, avoiding concurrent restarts.
for n in $(seq 1 60); do
    grep -q SQ2_COVER_AND_POWER_INPUT_READY /logs/power-input-boot.txt 2>/dev/null && break
    sleep 1
done
sensor=
for d in /sys/class/hidraw/hidraw*; do
    if grep -q '^HID_ID=001C:0000045E:00000C21$' "$d/device/uevent"; then sensor=$d; break; fi
done
[ -n "$sensor" ] || { echo CALIBRATION_UNSUPPORTED_SENSOR; exit 0; }
# Keep this result tied to this board, display EDID and HID descriptor; not Android's fixed lab serial.
[ -s /sys/class/dmi/id/product_uuid ] || exit 1
[ "$(wc -c < /sys/class/drm/card0-eDP-1/edid)" -ge 128 ] || exit 1
device=$({ cat /sys/class/dmi/id/product_uuid; cat /sys/class/drm/card0-eDP-1/edid; cat "$sensor/device/report_descriptor"; } | sha256sum | cut -d ' ' -f1)
store=/proc/1/root/data/vendor/sq2-touch-calibration
mkdir -p "$store"; chmod 700 "$store"
saved=$store/$device.profile
base=/etc/iptsd.conf
effective=/run/iptsd-calibrated.conf
neutral=/run/touch-calibration-neutral.profile
printf 'Version=1\nDevice=%s\nCalibrationX=\nCalibrationY=\nCalibrationXTop=\nCalibrationTopStart=0.1\nCalibrationTopEnd=0.3\nContactSizeMax=2.0\n' "$device" > "$neutral"
apply() {
    "$tool" validate "$device" < "$1" > /run/touch-calibration-section.new || return 1
    { cat "$base"; printf '\n'; cat /run/touch-calibration-section.new; } > "$effective.new"
    mv "$effective.new" "$effective"
    /bin/touch-framework-ready
}
valid=0
if [ -f "$saved" ] && [ ! -L "$saved" ] && "$tool" validate "$device" < "$saved" > /dev/null; then valid=1; fi
if [ "$valid" = 1 ]; then cp "$saved" /run/touch-calibration-current.profile; else cp "$neutral" /run/touch-calibration-current.profile; fi
apply /run/touch-calibration-current.profile || { rm -f "$effective"; /bin/touch-services; exit 1; }
user=$(android cmd activity get-current-user)
case "$user" in ''|*[!0-9]*) exit 1;; esac
pkg=org.surface.touchcalibration
apk=/etc/sq2-touch-calibration/wizard.apk
cp "$apk" /proc/1/root/data/local/tmp/sq2-touch-calibration.apk
# Package replacement can include dex compilation, especially on first boot.
ANDROID_COMMAND_TIMEOUT=120 android pm install -r --user "$user" /data/local/tmp/sq2-touch-calibration.apk > /logs/touch-calibration-install.txt
rm -f /proc/1/root/data/local/tmp/sq2-touch-calibration.apk
files=/proc/1/root/data/user_de/$user/$pkg/files
if [ -d "$files" ] && [ ! -L "$files" ]; then rm -f "$files/request"; fi
if [ "$valid" = 0 ] && [ ! -e "$store/$device.prompted" ]; then
    # Nonblocking onboarding: never dismiss the lock screen or modify credentials.
    android am start --user "$user" -n "$pkg/.MainActivity" > /dev/null
fi
preview=0;until_time=0;context_sent=0;cycles=0
reply() { printf '%s\n%s\n' "$nonce" "$1" | "$tool" publish "$files" reply; }
context() { "$tool" publish "$files" context < /run/touch-calibration-current.profile; }
restore() {
    apply /run/touch-calibration-current.profile
    preview=0;context_sent=0
}
cleanup() { if [ "$preview" = 1 ]; then restore || true; fi; rmdir /run/touch-calibration-lock 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 0' TERM INT
while true; do
    if [ "$preview" = 1 ] && [ "$(cut -d . -f1 /proc/uptime)" -ge "$until_time" ]; then restore; fi
    if [ -d "$files" ] && [ ! -L "$files" ]; then
        if [ "$context_sent" = 0 ]; then context; context_sent=1; fi
        request=$files/request
        if [ -f "$request" ] && [ ! -L "$request" ] && [ "$(stat -c %s "$request")" -le 4096 ]; then
            cp "$request" /run/touch-calibration-request
            rm -f "$request"
            command=$(sed -n 1p /run/touch-calibration-request)
            nonce=$(sed -n 2p /run/touch-calibration-request)
            case "$nonce" in ''|*[!a-z0-9-]*) sleep 1; continue;; esac
            case "$command" in
                preview)
                    if [ "$preview" = 1 ]; then restore; fi
                    tail -n +3 /run/touch-calibration-request > /run/touch-calibration-candidate.profile
                    if "$tool" validate "$device" < /run/touch-calibration-candidate.profile > /dev/null && apply /run/touch-calibration-candidate.profile; then
                        preview=1;until_time=$(( $(cut -d . -f1 /proc/uptime) + 180 ));reply OK
                    else restore;reply ERROR; fi
                    ;;
                save)
                    if [ "$preview" = 1 ]; then
                        cp /run/touch-calibration-candidate.profile "$saved.new"
                        chmod 600 "$saved.new";sync;mv "$saved.new" "$saved";sync
                        cp "$saved" /run/touch-calibration-current.profile
                        preview=0;context_sent=0;touch "$store/$device.prompted";reply OK
                    else reply ERROR; fi
                    ;;
                cancel|skip)
                    if [ "$preview" = 1 ]; then restore; fi
                    touch "$store/$device.prompted";reply OK
                    ;;
                *) reply ERROR;;
            esac
        fi
    fi
    # A user switch closes the old preview and installs/serves the current user's UI.
    cycles=$((cycles+1))
    if [ "$cycles" -ge 10 ]; then
        cycles=0
        if [ "$(android cmd activity get-current-user)" != "$user" ]; then
            cleanup;trap - EXIT TERM INT;exec /bin/touch-calibration-boot
        fi
    fi
    sleep 2
done
