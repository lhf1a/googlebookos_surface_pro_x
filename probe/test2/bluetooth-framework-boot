#!/bin/busybox sh
# One kernel controller setup per boot; Android toggles retain the HCI_USER link.
set -eu
export PATH=/bin:/sbin
android() { timeout 10 nsenter -t 1 -m -r -- /system/bin/"$@"; }

# The BLE HID stack disconnects if EventHub misses the initial node-open race.
# Start once, including when this helper reuses an already-owned HCI transport.
start_input_watch() {
    test -x /bin/bluetooth-input-watch || { echo BT_INPUT_WATCH_MISSING; return 1; }
    if [ -r /run/sq2-bt-input-watch.pid ]; then
        watcher=$(cat /run/sq2-bt-input-watch.pid)
        case "$watcher" in
            ''|*[!0-9]*) ;;
            *) if kill -0 "$watcher" 2>/dev/null &&
                  grep -q '/bin/bluetooth-input-watch' "/proc/$watcher/cmdline" 2>/dev/null; then return 0; fi ;;
        esac
    fi
    /bin/bluetooth-input-watch > /logs/bluetooth-input-watch.txt 2>&1 < /dev/null &
    echo "$!" > /run/sq2-bt-input-watch.pid
}
start_input_watch

publish_transport() {
    # Kernel retries can outlast the old 150-second helper deadline. Reuse
    # this wait on rerun too, instead of abandoning a still-starting bridge.
    for n in $(seq 1 420); do
        if ! kill -0 "$bridge" 2>/dev/null; then
            echo SQ2_BLUETOOTH_BRIDGE_EXITED
            return 1
        fi
        if [ -L /dev/sq2-bt-h4 ] && [ -c /dev/sq2-bt-h4 ]; then
            android setprop vendor.sq2.bluetooth.ready 1
            echo SQ2_BLUETOOTH_TRANSPORT_READY
            return 0
        fi
        sleep 1
    done
    echo SQ2_BLUETOOTH_TRANSPORT_TIMEOUT
    # Never reset or spawn another owner while a kernel call may be stuck.
    return 1
}

# Do not bring an already-owned controller down if this helper is rerun.
if [ -r /run/sq2-bt-bridge.pid ]; then
    previous=$(cat /run/sq2-bt-bridge.pid)
    case "$previous" in ''|*[!0-9]*) exit 1;; esac
    if [ "$(cat /proc/$previous/comm 2>/dev/null || true)" = sq2-hci-bridge ]; then
        bridge=$previous
        publish_transport
        exit $?
    fi
fi
if [ -L /dev/sq2-bt-h4 ]; then rm /dev/sq2-bt-h4; fi
# Early concurrent bring-up has produced corrupt QCA firmware replies. Wait
# for Android's boot/firmware setup to settle before first opening the UART.
ready=0
for n in $(seq 1 240); do
    if [ "$(android getprop sys.boot_completed 2>/dev/null || true)" = 1 ]; then
        ready=1
        break
    fi
    sleep 1
done
test "$ready" = 1 || { echo ANDROID_BOOT_TIMEOUT; exit 1; }
sleep 8
echo "SQ2_BLUETOOTH_SAVED_STATE=$(android settings get global bluetooth_on)"
# Do not write bluetooth_on or issue enable/disable: BluetoothManager owns the
# persisted user choice, including airplane-mode policy and user switching.
android setprop vendor.sq2.bluetooth.ready 0
modprobe hci_uart
for n in $(seq 1 30); do
    [ -d /sys/class/bluetooth/hci0 ] && break
    sleep 1
done
test -d /sys/class/bluetooth/hci0
sleep 3
nohup /bin/sq2-hci-bridge 0 /dev/sq2-bt-h4 > /logs/bluetooth-bridge.txt 2>&1 < /dev/null &
bridge=$!
echo "$bridge" > /run/sq2-bt-bridge.pid
publish_transport
