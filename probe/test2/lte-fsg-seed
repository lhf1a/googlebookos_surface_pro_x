#!/bin/busybox sh
# Explicit lab-only own-unit FSG seed. Default boot: immediate silent exit.
# Never writes a block device, calibration store, APN, or modem operating mode.
set -eu
export PATH=/bin:/sbin
arm=/media/esp/EFI/SQ2LTE/fsg-seed.ARM
[ -f "$arm" ] || exit 0
case " $(cat /proc/cmdline) " in
 *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 0;;
 *' sq2.el2=1 '*) ;;
 *) echo 'LTE_FSG_REFUSED: not normal EL2'; exit 1;;
esac
[ "$(cat /sys/module/suspend/parameters/screen_only)" = Y ] || exit 1
case " $(cat /proc/cmdline) " in *' nohibernate '*) ;; *) exit 1;; esac
[ "$(tr -d '\000' < /proc/device-tree/model)" = 'Microsoft Surface Pro X (SQ2)' ] || exit 1
unit=$(cat /etc/sq2-lte/unit-serial)
actual=$(cat /sys/block/nvme0n1/device/serial | tr -d ' \r\n')
[ -n "$unit" ] && [ "$actual" = "$unit" ] || { echo 'LTE_FSG_REFUSED: unit mismatch'; exit 1; }
grep -qxF SQ2-INTERNAL-512-20261027 /media/esp/SQ2-SSD-ID.txt || exit 1
awk '$2=="/run" && $3=="tmpfs" {ok=1} END {exit !ok}' /proc/mounts || exit 1
[ -z "$(pidof rmtfs 2>/dev/null || true)" ] || { echo 'LTE_FSG_REFUSED: RMTFS already active'; exit 1; }
# Consume durably before inspecting or adopting the candidate. Failures below
# leave the original dummy intact, and cannot repeat the experiment next boot.
[ ! -e "$arm.used" ] || { echo 'LTE_FSG_REFUSED: prior request exists'; exit 1; }
mv "$arm" "$arm.used"
sync
[ "$(wc -c < /etc/sq2-lte/modem_fsg.bin)" = 2097152 ] || exit 1
( cd /etc/sq2-lte; sha256sum -c FSG.sha256 ) || exit 1
target=/run/rmtfs/modem_fsg
[ -f "$target" ] && [ "$(wc -c < "$target")" = 2097152 ] || exit 1
cp /etc/sq2-lte/modem_fsg.bin "$target.lte-new"
cmp /etc/sq2-lte/modem_fsg.bin "$target.lte-new"
chmod 600 "$target.lte-new"
mv "$target.lte-new" "$target"
echo 'LTE_FSG_SEEDED: own-unit opaque FSG in RAM; FS1/FS2 unchanged; existing rmtfs -r shadow writes only'
