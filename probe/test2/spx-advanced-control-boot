                    awk '{print}' "$_nfile"
                    printf '[/Noise]\n'
                fi
                if [ -f "$_tfile" ] && [ ! -L "$_tfile" ]; then
                    printf '[Tap]\n'
                    awk '{print}' "$_tfile"
                    printf '[/Tap]\n'
