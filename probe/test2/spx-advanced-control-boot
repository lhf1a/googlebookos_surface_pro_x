#!/bin/sh
# Built-in root/init bridge for Surface Advanced Settings (Vulkan, Performance, Touch & Debugging).
# Data-only boundary: validates every input token; never evals or hot-swaps active drivers.
set -eu

export PATH="${SPX_AC_PATH:-/bin:/sbin:/usr/bin:/usr/sbin:${PATH:-}}"

DATA_ROOT="${SPX_AC_ROOT:-/proc/1/root}"
SYSFS="${SPX_AC_SYSFS:-/sys}"
RUN_DIR="${SPX_AC_RUN:-/run}"
ETC_DIR="${SPX_AC_ETC:-/etc}"
HOME_ROOT="${SPX_AC_HOME_ROOT:-/root}"
LOGS_DIR="${SPX_AC_LOGS:-/logs}"
CMDLINE="${SPX_AC_CMDLINE:-/proc/cmdline}"
LOCK_DIR="${SPX_AC_LOCK_DIR:-/run/spx-advanced-control-lock}"
TMP_REQ="${SPX_AC_TMP_REQ:-/run/spx-advanced-control-request}"
TMP_TOUCH="${SPX_AC_TMP_TOUCH:-/run/spx-advanced-control-touch.tmp}"
PKG="org.surface.advancedcontrol"
TOUCH_PKG="org.surface.touchcalibration.unified"

TOUCH_CALIB_TOOL="${SPX_AC_CALIB_TOOL:-/bin/touch-calibration-profile}"
TOUCH_NOISE_TOOL="${SPX_AC_NOISE_TOOL:-/bin/touch-noise-profile}"
TOUCH_TAP_TOOL="${SPX_AC_TAP_TOOL:-/bin/touch-tap-profile}"
TOUCH_READY_TOOL="${SPX_AC_READY_TOOL:-/bin/touch-framework-ready}"
TOUCH_STORE="$DATA_ROOT/data/vendor/sq2-touch-calibration"
DROPBEAR_BIN="${SPX_AC_DROPBEAR_BIN:-dropbear}"
DROPBEARKEY_BIN="${SPX_AC_DROPBEARKEY_BIN:-dropbearkey}"
MKPASSWD_BIN="${SPX_AC_MKPASSWD_BIN:-mkpasswd}"
IP_BIN="${SPX_AC_IP_BIN:-ip}"
ADB_TCP_PORT="5555"
SSH_PORT="22"

run_with_timeout() {
    _rwt_sec=$1
    shift
    "$@" &
    _rwt_cmd=$!
    (
        trap - EXIT
        _rwt_armed=1
        trap 'if [ "$_rwt_armed" = 1 ] && [ -n "${!:-}" ] && [ "$!" != "$_rwt_cmd" ]; then kill "$!" 2>/dev/null || true; wait "$!" 2>/dev/null || true; fi; exit 0' TERM INT
        sleep "$_rwt_sec" </dev/null >/dev/null 2>&1 &
        wait "$!" 2>/dev/null || exit 0
        _rwt_armed=0
        kill -TERM "$_rwt_cmd" 2>/dev/null || true
        _rwt_armed=1
        sleep 1 </dev/null >/dev/null 2>&1 &
        wait "$!" 2>/dev/null || exit 0
        _rwt_armed=0
        kill -KILL "$_rwt_cmd" 2>/dev/null || true
    ) </dev/null >/dev/null 2>&1 &
    _rwt_wd=$!
    _rwt_rc=0
    wait "$_rwt_cmd" 2>/dev/null || _rwt_rc=$?
    kill -TERM "$_rwt_wd" 2>/dev/null || true
    _rwt_try=0
    while [ "$_rwt_try" -lt 20 ]; do
        _rwt_st=
        [ -r "/proc/$_rwt_wd/stat" ] || break
        { read -r _rwt_st < "/proc/$_rwt_wd/stat"; } 2>/dev/null || break
        case "$_rwt_st" in
            *') Z '*|*') X '*) break ;;
        esac
        kill -TERM "$_rwt_wd" 2>/dev/null || break
        sleep 0.05 2>/dev/null || break
        _rwt_try=$((_rwt_try + 1))
    done
    wait "$_rwt_wd" 2>/dev/null || true
    return "$_rwt_rc"
}

display_is_on() {
    _dio_found=0
    for _dio_en in "$SYSFS"/class/drm/card*-*/enabled; do
        [ -r "$_dio_en" ] || continue
        _dio_found=1
        read -r _dio_val < "$_dio_en" 2>/dev/null || _dio_val=
        if [ "$_dio_val" = enabled ]; then
            _dio_dpms="${_dio_en%/*}/dpms"
            if [ -r "$_dio_dpms" ]; then
                read -r _dio_dv < "$_dio_dpms" 2>/dev/null || _dio_dv=
                [ "$_dio_dv" = On ] || continue
            fi
            return 0
        fi
    done
    if [ "$_dio_found" = 1 ]; then
        return 1
    fi
    for _dio_bl in "$SYSFS"/class/backlight/*; do
        [ -d "$_dio_bl" ] || continue
        _dio_found=1
        if [ -r "$_dio_bl/bl_power" ]; then
            read -r _dio_bp < "$_dio_bl/bl_power" 2>/dev/null || _dio_bp=0
            [ "$_dio_bp" = 0 ] || continue
        fi
        if [ -r "$_dio_bl/brightness" ]; then
            read -r _dio_br < "$_dio_bl/brightness" 2>/dev/null || _dio_br=1
            [ "$_dio_br" != 0 ] || continue
        fi
        return 0
    done
    [ "$_dio_found" = 0 ]
}

android() {
    if [ -n "${SPX_AC_ANDROID_WRAPPER:-}" ]; then
        "$SPX_AC_ANDROID_WRAPPER" "$@"
    else
        run_with_timeout "${ANDROID_COMMAND_TIMEOUT:-15}" nsenter -t 1 -m -r -- /system/bin/"$@"
    fi
}

cleanup() {
    rm -f "$TMP_REQ" "$TMP_TOUCH" "$TMP_TOUCH".bundle "$TMP_TOUCH".prof "$TMP_TOUCH".noise "$TMP_TOUCH".noise.out "$TMP_TOUCH".tap "$TMP_TOUCH".tap.out "$TMP_TOUCH".neutral "$TMP_TOUCH".sshkeys 2>/dev/null || true
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

mkdir "$LOCK_DIR" 2>/dev/null || exit 0
trap cleanup EXIT
trap 'exit 0' TERM INT

if [ "${SPX_AC_BOOT_WAIT:-1}" != "0" ]; then
    for _i in $(seq 1 240); do
        if [ -x "$DATA_ROOT/system/bin/getprop" ] &&
           [ "$(android getprop sys.boot_completed 2>/dev/null || true)" = "1" ]; then
            break
        fi
        sleep 1
    done
    [ "$(android getprop sys.boot_completed 2>/dev/null || true)" = "1" ] || exit 1
fi

STORE="$DATA_ROOT/data/vendor/spx-advanced-control"
SSH_STORE="$STORE/ssh"
mkdir -p "$STORE"
chmod 700 "$STORE" 2>/dev/null || true

is_rescue_boot() {
    _cmd=" $(cat "$CMDLINE" 2>/dev/null || true) "
    case "$_cmd" in
        *' sq2.rescue=1 '*) return 0 ;;
        *) return 1 ;;
    esac
}

is_rescue_or_no_cpufreq() {
    _cmd=" $(cat "$CMDLINE" 2>/dev/null || true) "
    case "$_cmd" in
        *' sq2.rescue=1 '*|*' sq2.cpufreq=0 '*) return 0 ;;
        *) return 1 ;;
    esac
}

validate_nonce() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 64 ] || return 1
    case "$1" in
        *[!a-z0-9-]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_user() {
    [ -n "$1" ] || return 1
    case "$1" in
        *[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_driver() {
    case "$1" in
        ''|turnip|qcom) return 0 ;;
        *) return 1 ;;
    esac
}

validate_bool() {
    case "$1" in
        0|1) return 0 ;;
        *) return 1 ;;
    esac
}

is_hex64() {
    [ "${#1}" = 64 ] || return 1
    case "$1" in
        *[!0-9a-f]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_governor_token() {
    [ -n "$1" ] || return 1
    [ "${#1}" -le 32 ] || return 1
    case "$1" in
        *[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_pkg() {
    _p="$1"
    [ -n "$_p" ] || return 1
    [ "${#_p}" -lt 192 ] || return 1
    case "$_p" in
        *.* ) ;;
        * ) return 1 ;;
    esac
    case "$_p" in
        .*|*.|*..*|*[!A-Za-z0-9_.]*) return 1 ;;
    esac
    _old_ifs="$IFS"
    IFS='.'
    for _seg in $_p; do
        case "$_seg" in
            [A-Za-z]*) ;;
            *) IFS="$_old_ifs"; return 1 ;;
        esac
    done
    IFS="$_old_ifs"
    return 0
}

word_in_list() {
    _needle="$1"
    _hay="$2"
    for _w in $_hay; do
        if [ "$_w" = "$_needle" ]; then
            return 0
        fi
    done
    return 1
}

list_cpufreq_policies() {
    for _pol in "$SYSFS"/devices/system/cpu/cpufreq/policy*; do
        if [ -d "$_pol" ] && [ -f "$_pol/scaling_governor" ]; then
            printf '%s\n' "$_pol"
        fi
    done
}

common_available_governors() {
    _first=1
    _common=""
    for _pol in $(list_cpufreq_policies); do
        [ -r "$_pol/scaling_available_governors" ] || continue
        _avail="$(cat "$_pol/scaling_available_governors" 2>/dev/null || true)"
        if [ "$_first" = 1 ]; then
            _first=0
            _dedup=""
            for _g in $_avail; do
                validate_governor_token "$_g" || continue
                if ! word_in_list "$_g" "$_dedup"; then
                    _dedup="${_dedup:+$_dedup }$_g"
                fi
            done
            _common="$_dedup"
        else
            _next=""
            for _g in $_common; do
                if word_in_list "$_g" "$_avail"; then
                    _next="${_next:+$_next }$_g"
                fi
            done
            _common="$_next"
        fi
    done
    printf '%s' "$_common"
}

apply_cpu_governor_now() {
    _target="$1"
    validate_governor_token "$_target" || return 1
    _avail="$(common_available_governors)"
    word_in_list "$_target" "$_avail" || return 1
    _applied=0
    for _pol in $(list_cpufreq_policies); do
        printf '%s' "$_target" > "$_pol/scaling_governor" 2>/dev/null || return 1
        _actual="$(tr -d '\r\n' < "$_pol/scaling_governor" 2>/dev/null || true)"
        [ "$_actual" = "$_target" ] || return 1
        _applied=1
    done
    [ "$_applied" = 1 ] || return 1
    return 0
}

read_saved_governor() {
    _f="$STORE/cpu_governor"
    if [ -f "$_f" ] && [ ! -L "$_f" ]; then
        _val="$(head -n 1 "$_f" 2>/dev/null | tr -d '\r\n ')"
        if validate_governor_token "$_val"; then
            printf '%s' "$_val"
            return 0
        fi
    fi
    printf ''
}

restore_saved_governor_on_boot() {
    if is_rescue_or_no_cpufreq; then
        echo 'SPX_AC_BOOT_CPU_RESTORE_SKIPPED rescue_or_nocpufreq'
        return 0
    fi
    _saved="$(read_saved_governor)"
    [ -n "$_saved" ] || return 0
    if apply_cpu_governor_now "$_saved"; then
        echo "SPX_AC_BOOT_CPU_RESTORED $_saved"
    else
        echo "SPX_AC_BOOT_CPU_RESTORE_FAILED $_saved"
    fi
}

read_policy_conf_default() {
    _conf="$DATA_ROOT/vendor/etc/sq2-vulkan-policy.conf"
    if [ -r "$_conf" ]; then
        _val="$(sed -n 's/^[[:space:]]*default[[:space:]]*=[[:space:]]*\([A-Za-z0-9_]*\).*/\1/p' "$_conf" 2>/dev/null | tail -n 1)"
        case "$_val" in
            turnip|mesa) printf 'turnip'; return 0 ;;
            qcom|qti|adreno|closed) printf 'qcom'; return 0 ;;
        esac
    fi
    printf 'turnip'
}

# ---- Touch Calibration & Ghost-Touch Helpers ----

TOUCH_DEVICE=""
TOUCH_HID_ID=""

resolve_touch_device() {
    TOUCH_DEVICE=""
    TOUCH_HID_ID=""
    if [ -r "$RUN_DIR/iptsd-hid-id" ]; then
        TOUCH_HID_ID="$(head -n 1 "$RUN_DIR/iptsd-hid-id" 2>/dev/null | tr -d '\r\n ')"
    fi
    _t_node=""
    _has_iptsd_hidraw=0
    if [ -r "$RUN_DIR/iptsd-hidraw" ]; then
        read -r _t_node < "$RUN_DIR/iptsd-hidraw" || true
        [ -z "$_t_node" ] || _has_iptsd_hidraw=1
    fi
    if [ -z "$_t_node" ] && [ -r "$RUN_DIR/iptsd.pid" ]; then
        _ipid="$(tr -d '\r\n ' < "$RUN_DIR/iptsd.pid" 2>/dev/null || true)"
        case "$_ipid" in
            ''|*[!0-9]*) ;;
            *)
                if kill -0 "$_ipid" 2>/dev/null && [ -r "/proc/$_ipid/cmdline" ]; then
                    _t_node="$(tr '\0' '\n' < "/proc/$_ipid/cmdline" 2>/dev/null | grep -m 1 '^/dev/hidraw[0-9][0-9]*$' || true)"
                fi
                ;;
        esac
    fi
    _t_sensor=""
    if [ -n "$_t_node" ]; then
        _t_sensor="$SYSFS/class/hidraw/${_t_node##*/}"
    else
        for _d in "$SYSFS"/class/hidraw/hidraw*; do
            [ -r "$_d/device/uevent" ] || continue
            if grep -qE '^HID_ID=001C:0000045E:0000(0C21|0996)$' "$_d/device/uevent" 2>/dev/null; then
                _t_sensor="$_d"
                break
            fi
        done
    fi
    [ -n "$_t_sensor" ] || return 1
    [ -r "$_t_sensor/device/report_descriptor" ] || return 1
    [ -r "$_t_sensor/device/uevent" ] || return 1

    if [ -z "$TOUCH_HID_ID" ]; then
        _hid_raw="$(sed -n 's/^HID_ID=//p' "$_t_sensor/device/uevent" 2>/dev/null | head -n 1)"
        if [ -n "$_hid_raw" ]; then
            _rest="${_hid_raw#*:}"
            _v="${_rest%%:*}"
            _p="${_rest#*:}"
            TOUCH_HID_ID="$(printf '%04X:%04X' "$((0x$_v))" "$((0x$_p))" 2>/dev/null || true)"
        fi
    fi

    _t_display=""
    for _conn in "$SYSFS"/class/drm/card*-eDP-*; do
        [ -r "$_conn/status" ] || continue
        [ "$(tr -d '\r\n ' < "$_conn/status" 2>/dev/null || true)" = "connected" ] || continue
        [ -r "$_conn/edid" ] || continue
        [ "$(wc -c < "$_conn/edid" 2>/dev/null || echo 0)" -ge 128 ] || continue
        [ -z "$_t_display" ] || return 1
        _t_display="$_conn"
    done
    [ -n "$_t_display" ] || return 1
    [ -s "$SYSFS/class/dmi/id/product_uuid" ] || return 1

    _dev_new="$({
        cat "$SYSFS/class/dmi/id/product_uuid"
        cat "$_t_display/edid"
        grep '^HID_ID=' "$_t_sensor/device/uevent"
        cat "$_t_sensor/device/report_descriptor"
    } | sha256sum | cut -d ' ' -f1)"
    _dev_legacy="$({
        cat "$SYSFS/class/dmi/id/product_uuid"
        cat "$_t_display/edid"
        cat "$_t_sensor/device/report_descriptor"
    } | sha256sum | cut -d ' ' -f1)"

    # Prefer current repo's HID_ID-bound hash on new builds, while remaining compatible
    # with earlier SQ1/SQ2 images whose calibration-boot omitted HID_ID from the digest.
    _cur_dev=""
    if [ -r "$RUN_DIR/touch-calibration-current.profile" ]; then
        _cur_dev="$(read_profile_kv "$RUN_DIR/touch-calibration-current.profile" "Device" | tr -d ' ')"
    fi
    if [ -n "$_cur_dev" ] && [ "$_cur_dev" = "$_dev_new" ]; then
        TOUCH_DEVICE="$_dev_new"
    elif [ -n "$_cur_dev" ] && [ "$_cur_dev" = "$_dev_legacy" ]; then
        TOUCH_DEVICE="$_dev_legacy"
    elif [ "$_has_iptsd_hidraw" = "1" ] ||
         [ -f "$TOUCH_STORE/$_dev_new.profile" ] ||
         [ -f "$TOUCH_STORE/$_dev_new.noise" ] ||
         [ -f "$TOUCH_STORE/$_dev_new.tap" ]; then
        TOUCH_DEVICE="$_dev_new"
    elif [ -f "$TOUCH_STORE/$_dev_legacy.profile" ] ||
         [ -f "$TOUCH_STORE/$_dev_legacy.noise" ] ||
         [ -f "$TOUCH_STORE/$_dev_legacy.tap" ]; then
        TOUCH_DEVICE="$_dev_legacy"
    else
        TOUCH_DEVICE="$_dev_new"
    fi
    is_hex64 "$TOUCH_DEVICE" || { TOUCH_DEVICE=""; return 1; }
    return 0
}

is_iptsd_running() {
    [ -r "$RUN_DIR/iptsd.pid" ] || return 1
    _ipid="$(tr -d '\r\n ' < "$RUN_DIR/iptsd.pid" 2>/dev/null || true)"
    case "$_ipid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$_ipid" 2>/dev/null || return 1
    return 0
}

read_saved_touch_disabled() {
    _td_f="$STORE/touch_disabled"
    if [ -f "$_td_f" ] && [ ! -L "$_td_f" ]; then
        _td_val="$(head -n 1 "$_td_f" 2>/dev/null | tr -d '\r\n ')"
        if [ "$_td_val" = "1" ]; then
            printf '1'
            return 0
        fi
    fi
    printf '0'
}

is_touch_disabled() {
    [ -e "$RUN_DIR/touch-disabled" ] || [ "$(read_saved_touch_disabled)" = "1" ]
}

stop_iptsd_now() {
    _pidfile="$RUN_DIR/iptsd.pid"
    if [ -r "$_pidfile" ]; then
        _ipid="$(tr -d '\r\n ' < "$_pidfile" 2>/dev/null || true)"
        case "$_ipid" in
            ''|*[!0-9]*) ;;
            *)
                if kill -0 "$_ipid" 2>/dev/null; then
                    kill "$_ipid" 2>/dev/null || true
                    _i=0
                    while [ "$_i" -lt 30 ]; do
                        kill -0 "$_ipid" 2>/dev/null || break
                        sleep 0.1
                        _i=$((_i + 1))
                    done
                    kill -9 "$_ipid" 2>/dev/null || true
                fi
                ;;
        esac
        rm -f "$_pidfile" 2>/dev/null || true
    fi
    ! is_iptsd_running
}

apply_touch_disabled() {
    _dis="$1"
    _rnonce="$2"
    if [ "$_dis" = "1" ]; then
        : > "$RUN_DIR/touch-disabled"
        chmod 644 "$RUN_DIR/touch-disabled" 2>/dev/null || true
        stop_iptsd_now || return 1
        return 0
    fi
    rm -f "$RUN_DIR/touch-disabled" 2>/dev/null || true
    if [ -x "$TOUCH_READY_TOOL" ]; then
        "$TOUCH_READY_TOOL" >/dev/null 2>&1 || return 1
    fi
    if [ -d "$RUN_DIR/iptsd-noise" ] && is_iptsd_running; then
        if [ -z "$TOUCH_DEVICE" ]; then
            resolve_touch_device || true
        fi
        if [ -n "$TOUCH_DEVICE" ]; then
            touch_reload_noise "${_rnonce}-ready" || true
        fi
    fi
    return 0
}

restore_touch_disabled_on_boot() {
    if is_rescue_boot; then
        echo 'SPX_AC_BOOT_TOUCH_DISABLE_SKIPPED rescue'
        return 0
    fi
    if [ "$(read_saved_touch_disabled)" = "1" ]; then
        : > "$RUN_DIR/touch-disabled"
        chmod 644 "$RUN_DIR/touch-disabled" 2>/dev/null || true
        if stop_iptsd_now; then
            echo 'SPX_AC_BOOT_TOUCH_DISABLED 1'
        else
            echo 'SPX_AC_BOOT_TOUCH_DISABLE_FAILED'
        fi
    fi
}

touch_reload_noise() {
    _rnonce="$1"
    _ndir="$RUN_DIR/iptsd-noise"
    [ -d "$_ndir" ] || return 0
    printf 'reload %s %s\n' "$TOUCH_DEVICE" "$_rnonce" > "$_ndir/command.new" 2>/dev/null || return 1
    mv -f "$_ndir/command.new" "$_ndir/command" 2>/dev/null || return 1
    if [ -s "$_ndir/version" ] && is_iptsd_running; then
        for _k in $(seq 1 25); do
            _st="$(head -n 1 "$_ndir/status" 2>/dev/null || true)"
            case "$_st" in
                "$_rnonce applied"*) return 0 ;;
                "$_rnonce error"*) return 1 ;;
            esac
            sleep 0.1
        done
        return 1
    fi
    return 0
}

touch_publish_wizard_context() {
    _cprofile="$1"
    [ -n "${active_user:-}" ] || return 0
    _tcb_files="$DATA_ROOT/data/user_de/$active_user/$TOUCH_PKG/files"
    if [ -d "$_tcb_files" ] && [ ! -L "$_tcb_files" ] && [ -x "$TOUCH_CALIB_TOOL" ] && [ -r "$_cprofile" ]; then
        "$TOUCH_CALIB_TOOL" publish "$_tcb_files" context < "$_cprofile" >/dev/null 2>&1 || true
    fi
}

touch_apply_profile_file() {
    _src_prof="$1"
    _rnonce="$2"
    [ -x "$TOUCH_CALIB_TOOL" ] || return 1
    "$TOUCH_CALIB_TOOL" validate "$TOUCH_DEVICE" < "$_src_prof" > "$RUN_DIR/touch-calibration-section.new" 2>/dev/null || return 1
    {
        if [ -r "$ETC_DIR/iptsd.conf" ]; then
            cat "$ETC_DIR/iptsd.conf"
        fi
        printf '\n'
        cat "$RUN_DIR/touch-calibration-section.new"
    } > "$RUN_DIR/iptsd-calibrated.conf.new" || return 1
    mv -f "$RUN_DIR/iptsd-calibrated.conf.new" "$RUN_DIR/iptsd-calibrated.conf" || return 1
    cp "$_src_prof" "$RUN_DIR/touch-calibration-current.profile.new" || return 1
    chmod 600 "$RUN_DIR/touch-calibration-current.profile.new" 2>/dev/null || true
    mv -f "$RUN_DIR/touch-calibration-current.profile.new" "$RUN_DIR/touch-calibration-current.profile" || return 1
    if ! is_touch_disabled && [ -x "$TOUCH_READY_TOOL" ]; then
        "$TOUCH_READY_TOOL" >/dev/null 2>&1 || return 1
    fi
    if [ -d "$RUN_DIR/iptsd-noise" ]; then
        touch_reload_noise "${_rnonce}-ready" || true
    fi
    touch_publish_wizard_context "$RUN_DIR/touch-calibration-current.profile"
    return 0
}

touch_noise_summary_line() {
    _nf="$1"
    [ -f "$_nf" ] && [ ! -L "$_nf" ] || { printf ''; return 0; }
    _raw="$(head -n 1 "$_nf" 2>/dev/null | tr -d '\r')"
    case "$_raw" in
        SPXNOISE3\ *)
            printf '%s\n' "$_raw" | awk '
            BEGIN { h="0123456789abcdef" }
            {
                hex=tolower($7); total=int($5)*int($6); nz=0; mx=0;
                n=length(hex);
                for (i=1; i+1<=n; i+=2) {
                    hi=index(h, substr(hex,i,1))-1;
                    lo=index(h, substr(hex,i+1,1))-1;
                    if (hi>=0 && lo>=0) {
                        v=hi*16+lo;
                        if (v>0) { nz++; if (v>mx) mx=v; }
                    }
                }
                printf "SPXNOISE3 %s %s %s %s %s nonzero=%d/%d max=%d", $2, $3, $4, $5, $6, nz, total, mx;
            }'
            ;;
        SPXNOISE1\ *|SPXNOISE2\ *)
            printf '%s' "$_raw"
            ;;
        *)
            printf ''
            ;;
    esac
}

read_profile_kv() {
    _pf="$1"
    _k="$2"
    sed -n "s/^${_k}=//p" "$_pf" 2>/dev/null | head -n 1 | tr -d '\r'
}

extract_touch_section() {
    awk -v s="$2" -v e="$3" '
        $0 == s { in_sec=1; next }
        $0 == e { in_sec=0; exit }
        in_sec { print }
    ' "$1" > "$4"
}

check_touch_section_pair() {
    _bf="$1"
    _bs="$2"
    _be="$3"
    if grep -qxF "$_bs" "$_bf" 2>/dev/null; then
        grep -qxF "$_be" "$_bf" 2>/dev/null || return 1
    fi
    return 0
}

# ---- Network ADB & SSH Helpers ----

write_atomic_file() {
    _target="$1"
    _mode="$2"
    _content="$3"
    _parent="$(dirname "$_target")"
    mkdir -p "$_parent"
    _tmp="${_target}.$$.tmp"
    rm -f "$_tmp" 2>/dev/null || true
    printf '%s' "$_content" > "$_tmp" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    chmod "$_mode" "$_tmp" 2>/dev/null || true
    mv -f "$_tmp" "$_target" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    return 0
}

tcp_port_firewall() {
    _action="$1"
    _port="$2"
    _tag="$3"
    for _ipt in iptables ip6tables; do
        if [ "$_action" = "1" ]; then
            if ! android "$_ipt" -w -C INPUT -p tcp --dport "$_port" -m comment --comment "$_tag" -j ACCEPT >/dev/null 2>&1; then
                android "$_ipt" -w -I INPUT 1 -p tcp --dport "$_port" -m comment --comment "$_tag" -j ACCEPT >/dev/null 2>&1 || true
            fi
        else
            while android "$_ipt" -w -C INPUT -p tcp --dport "$_port" -m comment --comment "$_tag" -j ACCEPT >/dev/null 2>&1; do
                android "$_ipt" -w -D INPUT -p tcp --dport "$_port" -m comment --comment "$_tag" -j ACCEPT >/dev/null 2>&1 || break
            done
        fi
    done
}

DEBUG_VM_IP=""
DEBUG_LAN_IPS=""

read_debug_network_ips() {
    DEBUG_VM_IP=""
    DEBUG_LAN_IPS=""
    _ip_lines="$("$IP_BIN" -4 -o addr show scope global 2>/dev/null || true)"
    [ -n "$_ip_lines" ] || return 0
    while IFS= read -r _line; do
        [ -n "$_line" ] || continue
        set -f
        # shellcheck disable=SC2086
        set -- $_line
        set +f
        _iface="${2:-}"
        _fam="${3:-}"
        _cidr="${4:-}"
        [ "$_fam" = "inet" ] || continue
        _iface="${_iface%%@*}"
        _iface="${_iface%:}"
        _ip="${_cidr%%/*}"
        case "$_ip" in
            ''|*[!0-9.]*) continue ;;
        esac
        case "$_iface" in
            avf_tap*|vmnic*|crosvm*)
                [ -n "$DEBUG_VM_IP" ] || DEBUG_VM_IP="$_ip"
                ;;
            lo|rmnet*|ccmni*|dummy*|tun*|ip_vti*|sit*|v4-*)
                ;;
            *)
                [ -n "$_iface" ] && DEBUG_LAN_IPS="${DEBUG_LAN_IPS:+$DEBUG_LAN_IPS,}${_iface}:${_ip}"
                ;;
        esac
    done <<EOF
$_ip_lines
EOF
}

read_saved_adb_tcp() {
    _f="$STORE/adb_tcp_enabled"
    if [ -f "$_f" ] && [ ! -L "$_f" ]; then
        _v="$(head -n 1 "$_f" 2>/dev/null | tr -d '\r\n ')"
        if [ "$_v" = "1" ]; then
            printf '1'
            return 0
        fi
    fi
    printf '0'
}

restart_adbd() {
    android setprop ctl.stop adbd >/dev/null 2>&1 || true
    _i=0
    while [ "$_i" -lt 20 ]; do
        _svc="$(android getprop init.svc.adbd 2>/dev/null | tr -d '\r\n' || true)"
        [ "$_svc" = "running" ] || break
        sleep 0.1
        _i=$((_i + 1))
    done
    android setprop ctl.start adbd >/dev/null 2>&1 || return 1
    _i=0
    while [ "$_i" -lt 30 ]; do
        _svc="$(android getprop init.svc.adbd 2>/dev/null | tr -d '\r\n' || true)"
        if [ -z "$_svc" ] || [ "$_svc" = "running" ]; then
            return 0
        fi
        sleep 0.1
        _i=$((_i + 1))
    done
    return 0
}

apply_adb_tcp() {
    _enable="$1"
    if [ "$_enable" = "1" ]; then
        android settings put global adb_enabled 1 >/dev/null 2>&1 || true
        android setprop service.adb.tcp.port "$ADB_TCP_PORT" >/dev/null 2>&1 || return 1
        _actual="$(android getprop service.adb.tcp.port 2>/dev/null | tr -d '\r\n' || true)"
        [ "$_actual" = "$ADB_TCP_PORT" ] || return 1
        restart_adbd || return 1
        tcp_port_firewall 1 "$ADB_TCP_PORT" "spx_ac_adb_tcp"
    else
        tcp_port_firewall 0 "$ADB_TCP_PORT" "spx_ac_adb_tcp"
        android setprop service.adb.tcp.port -1 >/dev/null 2>&1 || return 1
        restart_adbd || true
    fi
    return 0
}

is_dropbear_running() {
    _pidfile="$RUN_DIR/dropbear.pid"
    [ -r "$_pidfile" ] || return 1
    _dpid="$(head -n 1 "$_pidfile" 2>/dev/null | tr -d '\r\n ')"
    case "$_dpid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$_dpid" -gt 1 ] || return 1
    kill -0 "$_dpid" 2>/dev/null || return 1
    if [ -r "/proc/$_dpid/cmdline" ]; then
        _dcmd="$(tr '\000' ' ' < "/proc/$_dpid/cmdline" 2>/dev/null || true)"
        case "$_dcmd" in
            *dropbear*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    return 0
}

read_saved_ssh_enabled() {
    _f="$SSH_STORE/enabled"
    if [ -f "$_f" ] && [ ! -L "$_f" ]; then
        _v="$(head -n 1 "$_f" 2>/dev/null | tr -d '\r\n ')"
        case "$_v" in
            0|1) printf '%s' "$_v"; return 0 ;;
        esac
    fi
    printf ''
}

validate_shadow_hash() {
    _h="$1"
    case "$_h" in
        '$6$'*|'$5$'*|'$y$'*|'$1$'*) ;;
        *) return 1 ;;
    esac
    [ "${#_h}" -ge 12 ] || return 1
    case "$_h" in
        *:*|*\\*|*' '*|*'	'*) return 1 ;;
    esac
    _bad="$(printf '%s' "$_h" | tr -dc '\000-\037\177')"
    [ -z "$_bad" ] || return 1
    return 0
}

write_root_shadow_hash() {
    _hash="$1"
    if [ "$_hash" != "!" ]; then
        validate_shadow_hash "$_hash" || return 1
    fi
    mkdir -p "$ETC_DIR"
    _shadow="$ETC_DIR/shadow"
    _tmp="${_shadow}.ac.$$.tmp"
    rm -f "$_tmp" 2>/dev/null || true
    if [ -r "$_shadow" ]; then
        awk -F: -v h="$_hash" 'BEGIN{OFS=":"} $1=="root"{$2=h; found=1} {print} END{if(!found) print "root:" h ":0:0:99999:7:::"}' "$_shadow" > "$_tmp" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    else
        printf 'root:%s:0:0:99999:7:::\n' "$_hash" > "$_tmp" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    fi
    chmod 600 "$_tmp" 2>/dev/null || true
    mv -f "$_tmp" "$_shadow" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    return 0
}

read_saved_ssh_shadow_hash() {
    _f="$SSH_STORE/root_shadow_hash"
    if [ -f "$_f" ] && [ ! -L "$_f" ]; then
        _h="$(head -n 1 "$_f" 2>/dev/null | tr -d '\r\n')"
        if validate_shadow_hash "$_h"; then
            printf '%s' "$_h"
            return 0
        fi
    fi
    printf ''
}

is_ssh_password_set() {
    if [ -n "$(read_saved_ssh_shadow_hash)" ]; then
        return 0
    fi
    if [ -z "$(read_saved_ssh_enabled)" ] && [ -r "$ETC_DIR/shadow" ]; then
        _cur="$(awk -F: '$1 == "root" { print $2; exit }' "$ETC_DIR/shadow" 2>/dev/null || true)"
        validate_shadow_hash "$_cur" && return 0
    fi
    return 1
}

hash_ssh_password() {
    _pw="$1"
    _h=""
    if command -v "$MKPASSWD_BIN" >/dev/null 2>&1; then
        _h="$(printf '%s\n' "$_pw" | "$MKPASSWD_BIN" -m sha512 -P 0 2>/dev/null || true)"
        if [ -z "$_h" ]; then
            _h="$("$MKPASSWD_BIN" -m sha512 -- "$_pw" 2>/dev/null || true)"
        fi
    fi
    if [ -z "$_h" ] && command -v busybox >/dev/null 2>&1; then
        _h="$(printf '%s\n' "$_pw" | busybox mkpasswd -m sha512 -P 0 2>/dev/null || true)"
    fi
    validate_shadow_hash "$_h" || return 1
    printf '%s' "$_h"
}

normalize_ssh_key_line() {
    _raw="$1"
    set -f
    # shellcheck disable=SC2086
    set -- $_raw
    set +f
    _ktype="${1:-}"
    _kb64="${2:-}"
    case "$_ktype" in
        ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com) ;;
        *) return 1 ;;
    esac
    [ "${#_kb64}" -ge 16 ] || return 1
    case "$_kb64" in
        *[!A-Za-z0-9+/=]*) return 1 ;;
    esac
    shift 2 || true
    _comment="$*"
    if [ -n "$_comment" ]; then
        _bad="$(printf '%s' "$_comment" | tr -dc '\000-\037\177')"
        [ -z "$_bad" ] || return 1
        printf '%s %s %s' "$_ktype" "$_kb64" "$_comment"
    else
        printf '%s %s' "$_ktype" "$_kb64"
    fi
}

append_unique_ssh_key_to_file() {
    _norm="$1"
    _dest="$2"
    set -f
    # shellcheck disable=SC2086
    set -- $_norm
    set +f
    if ! awk -v kt="$1" -v kb="$2" '$1==kt && $2==kb {f=1; exit} END{exit !f}' "$_dest"; then
        printf '%s\n' "$_norm" >> "$_dest"
        return 0
    fi
    return 1
}

count_ssh_authorized_keys() {
    _kf=""
    if [ -f "$SSH_STORE/authorized_keys" ] && [ ! -L "$SSH_STORE/authorized_keys" ]; then
        _kf="$SSH_STORE/authorized_keys"
    elif [ -f "$HOME_ROOT/.ssh/authorized_keys" ] && [ ! -L "$HOME_ROOT/.ssh/authorized_keys" ]; then
        _kf="$HOME_ROOT/.ssh/authorized_keys"
    fi
    if [ -z "$_kf" ]; then
        printf '0'
        return 0
    fi
    _cnt="$(grep -Ec '^(ssh-|ecdsa-|sk-)' "$_kf" 2>/dev/null || true)"
    printf '%s' "${_cnt:-0}"
}

sync_ssh_authorized_keys() {
    _src="$SSH_STORE/authorized_keys"
    [ -f "$_src" ] && [ ! -L "$_src" ] || return 0
    mkdir -p "$HOME_ROOT" "$HOME_ROOT/.ssh"
    chmod 700 "$HOME_ROOT" "$HOME_ROOT/.ssh" 2>/dev/null || true
    _dst="$HOME_ROOT/.ssh/authorized_keys"
    _tmp="${_dst}.ac.$$.tmp"
    rm -f "$_tmp" 2>/dev/null || true
    cp "$_src" "$_tmp" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    chmod 600 "$_tmp" 2>/dev/null || true
    if [ "$(id -u)" = "0" ]; then
        chown 0:0 "$HOME_ROOT" "$HOME_ROOT/.ssh" "$_tmp" 2>/dev/null || true
    fi
    mv -f "$_tmp" "$_dst" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    return 0
}

ensure_ssh_host_key() {
    _db_dir="$ETC_DIR/dropbear"
    _host_key="$_db_dir/dropbear_ed25519_host_key"
    _saved_key="$SSH_STORE/dropbear_ed25519_host_key"
    mkdir -p "$_db_dir" "$SSH_STORE"
    chmod 700 "$_db_dir" "$SSH_STORE" 2>/dev/null || true
    if [ -s "$_saved_key" ] && [ ! -L "$_saved_key" ]; then
        _tmp="${_host_key}.ac.$$.tmp"
        cp "$_saved_key" "$_tmp" && chmod 600 "$_tmp" 2>/dev/null && mv -f "$_tmp" "$_host_key" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    elif [ -s "$_host_key" ] && [ ! -L "$_host_key" ]; then
        _tmp="${_saved_key}.ac.$$.tmp"
        cp "$_host_key" "$_tmp" && chmod 600 "$_tmp" 2>/dev/null && mv -f "$_tmp" "$_saved_key" || rm -f "$_tmp" 2>/dev/null || true
    elif command -v "$DROPBEARKEY_BIN" >/dev/null 2>&1; then
        mkdir -p "$LOGS_DIR"
        "$DROPBEARKEY_BIN" -t ed25519 -f "$_host_key" >> "$LOGS_DIR/spx-advanced-control-dropbearkey.txt" 2>&1 || return 1
        chmod 600 "$_host_key" 2>/dev/null || true
        _tmp="${_saved_key}.ac.$$.tmp"
        cp "$_host_key" "$_tmp" && chmod 600 "$_tmp" 2>/dev/null && mv -f "$_tmp" "$_saved_key" || rm -f "$_tmp" 2>/dev/null || true
    fi
    return 0
}

ssh_start_now() {
    command -v "$DROPBEAR_BIN" >/dev/null 2>&1 || return 1
    mkdir -p "$RUN_DIR" "$LOGS_DIR"
    if [ "$ETC_DIR" = "/etc" ] && [ "$(id -u)" = "0" ]; then
        mkdir -p /dev/pts
        grep -q ' /dev/pts ' /proc/mounts 2>/dev/null || mount -t devpts devpts /dev/pts -o mode=620,ptmxmode=666 || true
    fi
    _saved_hash="$(read_saved_ssh_shadow_hash)"
    if [ -n "$_saved_hash" ]; then
        write_root_shadow_hash "$_saved_hash" || return 1
    fi
    sync_ssh_authorized_keys || return 1
    ensure_ssh_host_key || return 1
    if ! is_dropbear_running; then
        if [ -s "$ETC_DIR/dropbear/dropbear_ed25519_host_key" ]; then
            "$DROPBEAR_BIN" -E -p "$SSH_PORT" -P "$RUN_DIR/dropbear.pid" -r "$ETC_DIR/dropbear/dropbear_ed25519_host_key" 2>> "$LOGS_DIR/ssh.txt"
        else
            "$DROPBEAR_BIN" -R -E -p "$SSH_PORT" -P "$RUN_DIR/dropbear.pid" -r "$ETC_DIR/dropbear/dropbear_ed25519_host_key" 2>> "$LOGS_DIR/ssh.txt"
        fi
        _i=0
        while [ "$_i" -lt 15 ]; do
            is_dropbear_running && break
            sleep 0.1
            _i=$((_i + 1))
        done
    fi
    is_dropbear_running || return 1
    tcp_port_firewall 1 "$SSH_PORT" "spx_ac_ssh"
    return 0
}

ssh_stop_now() {
    _pidfile="$RUN_DIR/dropbear.pid"
    if is_dropbear_running; then
        _dpid="$(head -n 1 "$_pidfile" 2>/dev/null | tr -d '\r\n ')"
        kill "$_dpid" 2>/dev/null || true
        _i=0
        while [ "$_i" -lt 30 ]; do
            kill -0 "$_dpid" 2>/dev/null || break
            sleep 0.1
            _i=$((_i + 1))
        done
        kill -9 "$_dpid" 2>/dev/null || true
    fi
    rm -f "$_pidfile"
    tcp_port_firewall 0 "$SSH_PORT" "spx_ac_ssh"
    if [ -r "$ETC_DIR/shadow" ]; then
        write_root_shadow_hash "!" || true
    fi
    return 0
}

restore_debug_settings_on_boot() {
    if is_rescue_boot; then
        echo 'SPX_AC_BOOT_DEBUG_RESTORE_SKIPPED rescue'
        return 0
    fi
    if [ "$(read_saved_adb_tcp)" = "1" ]; then
        if apply_adb_tcp 1; then
            echo 'SPX_AC_BOOT_ADB_TCP_RESTORED 1'
        else
            echo 'SPX_AC_BOOT_ADB_TCP_RESTORE_FAILED'
        fi
    fi
    sync_ssh_authorized_keys || true
    if [ -s "$SSH_STORE/dropbear_ed25519_host_key" ] && [ ! -L "$SSH_STORE/dropbear_ed25519_host_key" ]; then
        ensure_ssh_host_key || true
    fi
    _ssh_saved="$(read_saved_ssh_enabled)"
    if [ "$_ssh_saved" = "1" ]; then
        if ssh_start_now; then
            echo 'SPX_AC_BOOT_SSH_RESTORED 1'
        else
            echo 'SPX_AC_BOOT_SSH_RESTORE_FAILED'
        fi
    elif [ "$_ssh_saved" = "0" ]; then
        ssh_stop_now
        echo 'SPX_AC_BOOT_SSH_STOPPED 0'
    fi
}

publish_file() {
    _dir="$1"
    _name="$2"
    _content="$3"
    [ -d "$_dir" ] && [ ! -L "$_dir" ] || return 1
    _tmp="$_dir/.bridge-$$.tmp"
    rm -f "$_tmp" 2>/dev/null || true
    [ ! -L "$_tmp" ] || return 1
    printf '%s' "$_content" > "$_tmp" || return 1
    chmod 600 "$_tmp" 2>/dev/null || true
    _owner="$(stat -c '%u:%g' "$_dir" 2>/dev/null || true)"
    if [ -n "$_owner" ] && [ "$(id -u)" = "0" ]; then
        chown "$_owner" "$_tmp" 2>/dev/null || true
    fi
    mv -f "$_tmp" "$_dir/$_name" || { rm -f "$_tmp" 2>/dev/null || true; return 1; }
    return 0
}

publish_state() {
    _dir="$1"
    _vk_avail=0
    if [ -f "$DATA_ROOT/vendor/lib64/hw/vulkan.turnip.so" ] &&
       [ -f "$DATA_ROOT/vendor/lib64/hw/vulkan.qti.so" ] &&
       [ -f "$DATA_ROOT/vendor/etc/surface-vulkan-app-routing.version" ]; then
        _vk_avail=1
    fi
    _vk_def="$(android getprop persist.sq2.vulkan.driver 2>/dev/null | tr -d '\r\n' || true)"
    _pol_def="$(read_policy_conf_default)"
    _avail_gov="$(common_available_governors)"
    _saved_gov="$(read_saved_governor)"
    _policies=""
    _cur_gov=""
    _mixed=0
    for _pol in $(list_cpufreq_policies); do
        _pname="${_pol##*/}"
        _pgov="$(tr -d '\r\n ' < "$_pol/scaling_governor" 2>/dev/null || true)"
        _policies="${_policies:+$_policies,}${_pname}:${_pgov}"
        if [ -z "$_cur_gov" ]; then
            _cur_gov="$_pgov"
        elif [ "$_cur_gov" != "$_pgov" ]; then
            _mixed=1
        fi
    done
    if [ "$_mixed" = 1 ]; then
        _cur_gov="mixed"
    fi

    _t_avail=0
    _t_running=0
    if is_iptsd_running; then
        _t_running=1
    fi
    _t_disabled=0
    if is_touch_disabled; then
        _t_disabled=1
    fi
    _t_dev=""
    _t_hid=""
    _t_prof_saved=0
    _t_px=""
    _t_py=""
    _t_ptop=""
    _t_pstart="0.1"
    _t_pend="0.3"
    _t_psize="2.0"
    _t_noise_saved=0
    _t_noise_enabled=0
    _t_noise_info=""
    _t_tap_saved=0
    _t_tap_line=""

    if resolve_touch_device; then
        _t_avail=1
        _t_dev="$TOUCH_DEVICE"
        _t_hid="$TOUCH_HID_ID"

        _pfile="$TOUCH_STORE/$TOUCH_DEVICE.profile"
        if [ -f "$_pfile" ] && [ ! -L "$_pfile" ]; then
            _t_prof_saved=1
        elif [ -f "$RUN_DIR/touch-calibration-current.profile" ] && [ ! -L "$RUN_DIR/touch-calibration-current.profile" ]; then
            _pfile="$RUN_DIR/touch-calibration-current.profile"
        else
            _pfile=""
        fi
        if [ -n "$_pfile" ]; then
            _t_px="$(read_profile_kv "$_pfile" "CalibrationX")"
            _t_py="$(read_profile_kv "$_pfile" "CalibrationY")"
            _t_ptop="$(read_profile_kv "$_pfile" "CalibrationXTop")"
            _s="$(read_profile_kv "$_pfile" "CalibrationTopStart")"
            [ -z "$_s" ] || _t_pstart="$_s"
            _e="$(read_profile_kv "$_pfile" "CalibrationTopEnd")"
            [ -z "$_e" ] || _t_pend="$_e"
            _z="$(read_profile_kv "$_pfile" "ContactSizeMax")"
            [ -z "$_z" ] || _t_psize="$_z"
        fi

        _nfile="$TOUCH_STORE/$TOUCH_DEVICE.noise"
        if [ -f "$_nfile" ] && [ ! -L "$_nfile" ]; then
            _t_noise_saved=1
            _t_noise_info="$(touch_noise_summary_line "$_nfile")"
            if [ ! -e "$_nfile.disabled" ]; then
                if [ -s "$RUN_DIR/iptsd-noise/version" ]; then
                    if [ -s "$RUN_DIR/iptsd-noise/active" ]; then
                        _t_noise_enabled=1
                    fi
                else
                    _t_noise_enabled=1
                fi
            fi
        fi

        _tfile="$TOUCH_STORE/$TOUCH_DEVICE.tap"
        if [ -f "$_tfile" ] && [ ! -L "$_tfile" ]; then
            _t_tap_saved=1
            _t_tap_line="$(head -n 1 "$_tfile" 2>/dev/null | tr -d '\r')"
        fi
    fi

    read_debug_network_ips
    _adb_saved="$(read_saved_adb_tcp)"
    _adb_prop="$(android getprop service.adb.tcp.port 2>/dev/null | tr -d '\r\n' || true)"
    _adb_active=0
    case "$_adb_prop" in
        ''|-1|0) _adb_active=0 ;;
        *[!0-9]*) _adb_active=0 ;;
        *) _adb_active=1 ;;
    esac
    _ssh_avail=0
    command -v "$DROPBEAR_BIN" >/dev/null 2>&1 && _ssh_avail=1
    _ssh_run=0
    is_dropbear_running && _ssh_run=1
    _ssh_saved="$(read_saved_ssh_enabled)"
    if [ -n "$_ssh_saved" ]; then
        _ssh_en="$_ssh_saved"
    else
        _ssh_en="$_ssh_run"
    fi
    _ssh_pw_set=0
    is_ssh_password_set && _ssh_pw_set=1
    _ssh_keys="$(count_ssh_authorized_keys)"

    _body="bridge_version=1
vulkan_available=$_vk_avail
vulkan_default=$_vk_def
policy_default=$_pol_def
cpu_available_governors=$_avail_gov
cpu_current_governor=$_cur_gov
cpu_saved_governor=$_saved_gov
cpu_policies=$_policies
touch_available=$_t_avail
touch_iptsd_running=$_t_running
touch_disabled=$_t_disabled
touch_device_id=$_t_dev
touch_hid_id=$_t_hid
touch_profile_saved=$_t_prof_saved
touch_profile_x=$_t_px
touch_profile_y=$_t_py
touch_profile_x_top=$_t_ptop
touch_profile_top_start=$_t_pstart
touch_profile_top_end=$_t_pend
touch_profile_size_max=$_t_psize
touch_noise_saved=$_t_noise_saved
touch_noise_enabled=$_t_noise_enabled
touch_noise_info=$_t_noise_info
touch_tap_saved=$_t_tap_saved
touch_tap_line=$_t_tap_line
adb_tcp_enabled=$_adb_saved
adb_tcp_active=$_adb_active
adb_tcp_port=$_adb_prop
ssh_available=$_ssh_avail
ssh_enabled=$_ssh_en
ssh_running=$_ssh_run
ssh_port=$SSH_PORT
ssh_password_set=$_ssh_pw_set
ssh_key_count=$_ssh_keys
debug_vm_ip=$DEBUG_VM_IP
debug_lan_ips=$DEBUG_LAN_IPS
"
    publish_file "$_dir" "state" "$_body"
}

send_reply() {
    _dir="$1"
    _nonce="$2"
    _status="$3"
    _detail="${4:-}"
    if [ -n "$_detail" ]; then
        publish_file "$_dir" "reply" "$(printf '%s\n%s\n%s\n' "$_nonce" "$_status" "$_detail")"
    else
        publish_file "$_dir" "reply" "$(printf '%s\n%s\n' "$_nonce" "$_status")"
    fi
}

handle_request() {
    _dir="$1"
    _user="$2"
    _req="$_dir/request"
    [ -f "$_req" ] && [ ! -L "$_req" ] || return 1
    _size="$(stat -c %s "$_req" 2>/dev/null || echo 999999)"
    if [ "$_size" -gt 140000 ]; then
        rm -f "$_req" 2>/dev/null || true
        return 0
    fi
    cp "$_req" "$TMP_REQ" 2>/dev/null || return 1
    rm -f "$_req" 2>/dev/null || true

    _cmd="$(sed -n '1p' "$TMP_REQ" | tr -d '\r')"
    _nonce="$(sed -n '2p' "$TMP_REQ" | tr -d '\r')"
    if ! validate_nonce "$_nonce"; then
        return 0
    fi

    case "$_cmd" in
        refresh)
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-app-vulkan)
            _req_user="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            _pkg="$(sed -n '4p' "$TMP_REQ" | tr -d '\r')"
            _drv="$(sed -n '5p' "$TMP_REQ" | tr -d '\r')"
            _stop="$(sed -n '6p' "$TMP_REQ" | tr -d '\r')"
            if ! validate_user "$_req_user" || [ "$_req_user" != "$_user" ] ||
               ! validate_pkg "$_pkg" || ! validate_driver "$_drv" || ! validate_bool "$_stop"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_arguments"
                return 0
            fi
            _key="persist.sq2.vulkan.app.${_req_user}.${_pkg}"
            if ! android setprop "$_key" "$_drv" >/dev/null 2>&1; then
                send_reply "$_dir" "$_nonce" "ERROR" "setprop_failed"
                return 0
            fi
            _actual="$(android getprop "$_key" 2>/dev/null | tr -d '\r\n' || true)"
            if [ "$_actual" != "$_drv" ]; then
                send_reply "$_dir" "$_nonce" "ERROR" "verify_mismatch"
                return 0
            fi
            if [ "$_stop" = "1" ]; then
                if ! android am force-stop --user "$_req_user" "$_pkg" >/dev/null 2>&1; then
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "ERROR" "force_stop_failed"
                    return 0
                fi
            fi
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-default-vulkan)
            _drv="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            if ! validate_driver "$_drv"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_driver"
                return 0
            fi
            if ! android setprop persist.sq2.vulkan.driver "$_drv" >/dev/null 2>&1; then
                send_reply "$_dir" "$_nonce" "ERROR" "setprop_failed"
                return 0
            fi
            _actual="$(android getprop persist.sq2.vulkan.driver 2>/dev/null | tr -d '\r\n' || true)"
            if [ "$_actual" != "$_drv" ]; then
                send_reply "$_dir" "$_nonce" "ERROR" "verify_mismatch"
                return 0
            fi
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-cpu-governor)
            _gov="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            if [ -z "$_gov" ]; then
                rm -f "$STORE/cpu_governor" 2>/dev/null || true
                _avail="$(common_available_governors)"
                if word_in_list "schedutil" "$_avail"; then
                    if ! apply_cpu_governor_now "schedutil"; then
                        publish_state "$_dir" || true
                        send_reply "$_dir" "$_nonce" "ERROR" "restore_default_failed"
                        return 0
                    fi
                fi
                publish_state "$_dir" || true
                send_reply "$_dir" "$_nonce" "OK"
                return 0
            fi
            if ! validate_governor_token "$_gov"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_governor"
                return 0
            fi
            if ! apply_cpu_governor_now "$_gov"; then
                publish_state "$_dir" || true
                send_reply "$_dir" "$_nonce" "ERROR" "apply_governor_failed"
                return 0
            fi
            _tmp_store="$STORE/.cpu_governor.$$.tmp"
            printf '%s\n' "$_gov" > "$_tmp_store"
            chmod 600 "$_tmp_store" 2>/dev/null || true
            mv -f "$_tmp_store" "$STORE/cpu_governor"
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-touch-disabled)
            _disable="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            if ! validate_bool "$_disable"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_arguments"
                return 0
            fi
            if [ "$_disable" = "1" ]; then
                write_atomic_file "$STORE/touch_disabled" 600 "$(printf '1\n')" || {
                    send_reply "$_dir" "$_nonce" "ERROR" "persist_failed"
                    return 0
                }
                sync 2>/dev/null || true
                if ! apply_touch_disabled 1 "$_nonce"; then
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "ERROR" "touch_disable_failed"
                    return 0
                fi
            else
                rm -f "$STORE/touch_disabled" "$RUN_DIR/touch-disabled" 2>/dev/null || true
                sync 2>/dev/null || true
                if ! apply_touch_disabled 0 "$_nonce"; then
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "ERROR" "touch_enable_failed"
                    return 0
                fi
            fi
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-touch-ghost-patch)
            _enable="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            if ! validate_bool "$_enable"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_arguments"
                return 0
            fi
            if ! resolve_touch_device; then
                send_reply "$_dir" "$_nonce" "ERROR" "touch_device_unavailable"
                return 0
            fi
            mkdir -p "$TOUCH_STORE"
            chmod 700 "$TOUCH_STORE" 2>/dev/null || true
            _nfile="$TOUCH_STORE/$TOUCH_DEVICE.noise"
            _ndir="$RUN_DIR/iptsd-noise"
            if [ "$_enable" = "0" ]; then
                : > "$_nfile.disabled"
                chmod 600 "$_nfile.disabled" 2>/dev/null || true
                rm -f "$_ndir/active" 2>/dev/null || true
                if [ -d "$_ndir" ] && ! touch_reload_noise "$_nonce"; then
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "ERROR" "touch_reload_failed"
                    return 0
                fi
            else
                if [ ! -f "$_nfile" ] || [ -L "$_nfile" ]; then
                    send_reply "$_dir" "$_nonce" "ERROR" "no_noise_patch"
                    return 0
                fi
                [ -x "$TOUCH_NOISE_TOOL" ] || { send_reply "$_dir" "$_nonce" "ERROR" "noise_tool_missing"; return 0; }
                if [ -d "$_ndir" ]; then
                    if ! "$TOUCH_NOISE_TOOL" "$TOUCH_DEVICE" < "$_nfile" > "$_ndir/active.new" 2>/dev/null; then
                        rm -f "$_ndir/active.new" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_noise_patch"
                        return 0
                    fi
                    mv -f "$_ndir/active.new" "$_ndir/active"
                else
                    "$TOUCH_NOISE_TOOL" "$TOUCH_DEVICE" < "$_nfile" > /dev/null 2>&1 || {
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_noise_patch"
                        return 0
                    }
                fi
                rm -f "$_nfile.disabled" 2>/dev/null || true
                if [ -d "$_ndir" ] && ! touch_reload_noise "$_nonce"; then
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "ERROR" "touch_reload_failed"
                    return 0
                fi
            fi
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        clear-touch-calibration)
            if ! resolve_touch_device; then
                send_reply "$_dir" "$_nonce" "ERROR" "touch_device_unavailable"
                return 0
            fi
            mkdir -p "$TOUCH_STORE"
            chmod 700 "$TOUCH_STORE" 2>/dev/null || true
            rm -f "$TOUCH_STORE/$TOUCH_DEVICE.profile" \
                  "$TOUCH_STORE/$TOUCH_DEVICE.noise" \
                  "$TOUCH_STORE/$TOUCH_DEVICE.noise.disabled" \
                  "$TOUCH_STORE/$TOUCH_DEVICE.tap" 2>/dev/null || true
            : > "$TOUCH_STORE/$TOUCH_DEVICE.prompted"
            chmod 644 "$TOUCH_STORE/$TOUCH_DEVICE.prompted" 2>/dev/null || true
            rm -f "$RUN_DIR/iptsd-noise/active" "$RUN_DIR/iptsd-noise/tap-active" 2>/dev/null || true
            if [ -d "$RUN_DIR/iptsd-noise" ]; then
                touch_reload_noise "$_nonce" || true
            fi
            printf 'Version=1\nDevice=%s\nCalibrationX=\nCalibrationY=\nCalibrationXTop=\nCalibrationTopStart=0.1\nCalibrationTopEnd=0.3\nContactSizeMax=2.0\n' "$TOUCH_DEVICE" > "$TMP_TOUCH"
            if ! touch_apply_profile_file "$TMP_TOUCH" "$_nonce"; then
                rm -f "$TMP_TOUCH" 2>/dev/null || true
                publish_state "$_dir" || true
                send_reply "$_dir" "$_nonce" "ERROR" "clear_apply_failed"
                return 0
            fi
            rm -f "$TMP_TOUCH" 2>/dev/null || true
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        import-touch-calibration)
            if ! resolve_touch_device; then
                send_reply "$_dir" "$_nonce" "ERROR" "touch_device_unavailable"
                return 0
            fi
            tail -n +3 "$TMP_REQ" | tr -d '\r' > "$TMP_TOUCH"
            _first="$(awk 'NF{print;exit}' "$TMP_TOUCH" 2>/dev/null || true)"
            mkdir -p "$TOUCH_STORE"
            chmod 700 "$TOUCH_STORE" 2>/dev/null || true
            case "$_first" in
                SPXTOUCH1)
                    _hdev="$(awk '/^\[/{exit} /^Device=/{sub(/^Device=/,""); gsub(/[[:space:]]/,""); print; exit}' "$TMP_TOUCH" 2>/dev/null || true)"
                    if is_hex64 "$_hdev" && [ "$_hdev" != "$TOUCH_DEVICE" ]; then
                        rm -f "$TMP_TOUCH"* 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                        return 0
                    fi
                    _ndis="$(awk '/^\[/{exit} /^NoiseDisabled=/{sub(/^NoiseDisabled=/,""); gsub(/[[:space:]]/,""); print; exit}' "$TMP_TOUCH" 2>/dev/null || true)"
                    case "$_ndis" in
                        ''|0|1) ;;
                        *)
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                            return 0
                            ;;
                    esac
                    if ! check_touch_section_pair "$TMP_TOUCH" "[Profile]" "[/Profile]" ||
                       ! check_touch_section_pair "$TMP_TOUCH" "[Noise]" "[/Noise]" ||
                       ! check_touch_section_pair "$TMP_TOUCH" "[Tap]" "[/Tap]"; then
                        rm -f "$TMP_TOUCH"* 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    _bprof="$TMP_TOUCH.prof"
                    _bnoise="$TMP_TOUCH.noise"
                    _btap="$TMP_TOUCH.tap"
                    extract_touch_section "$TMP_TOUCH" "[Profile]" "[/Profile]" "$_bprof"
                    extract_touch_section "$TMP_TOUCH" "[Noise]" "[/Noise]" "$_bnoise"
                    extract_touch_section "$TMP_TOUCH" "[Tap]" "[/Tap]" "$_btap"
                    if [ ! -s "$_bprof" ] && [ ! -s "$_bnoise" ] && [ ! -s "$_btap" ]; then
                        rm -f "$TMP_TOUCH"* 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    if [ -s "$_bprof" ]; then
                        _fdev="$(read_profile_kv "$_bprof" "Device" | tr -d ' ')"
                        if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                            return 0
                        fi
                        [ -x "$TOUCH_CALIB_TOOL" ] || { rm -f "$TMP_TOUCH"* 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "calib_tool_missing"; return 0; }
                        if ! "$TOUCH_CALIB_TOOL" validate "$TOUCH_DEVICE" < "$_bprof" >/dev/null 2>&1; then
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                            return 0
                        fi
                    fi
                    if [ -s "$_bnoise" ]; then
                        _nf="$(awk 'NF{print;exit}' "$_bnoise" 2>/dev/null || true)"
                        _fdev="$(printf '%s\n' "$_nf" | awk '{print $2}')"
                        if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                            return 0
                        fi
                        [ -x "$TOUCH_NOISE_TOOL" ] || { rm -f "$TMP_TOUCH"* 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "noise_tool_missing"; return 0; }
                        if ! "$TOUCH_NOISE_TOOL" "$TOUCH_DEVICE" < "$_bnoise" > "$_bnoise.out" 2>/dev/null; then
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                            return 0
                        fi
                    fi
                    if [ -s "$_btap" ]; then
                        _tf="$(awk 'NF{print;exit}' "$_btap" 2>/dev/null || true)"
                        _fdev="$(printf '%s\n' "$_tf" | awk '{print $2}')"
                        if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                            return 0
                        fi
                        [ -x "$TOUCH_TAP_TOOL" ] || { rm -f "$TMP_TOUCH"* 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "tap_tool_missing"; return 0; }
                        if ! "$TOUCH_TAP_TOOL" "$TOUCH_DEVICE" < "$_btap" > "$_btap.out" 2>/dev/null; then
                            rm -f "$TMP_TOUCH"* 2>/dev/null || true
                            send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                            return 0
                        fi
                    fi

                    _tfile="$TOUCH_STORE/$TOUCH_DEVICE.tap"
                    if [ -s "$_btap.out" ]; then
                        cp "$_btap.out" "$_tfile.new"
                        chmod 600 "$_tfile.new" 2>/dev/null || true
                        mv -f "$_tfile.new" "$_tfile"
                        if [ -d "$RUN_DIR/iptsd-noise" ]; then
                            cp "$_tfile" "$RUN_DIR/iptsd-noise/tap-active.new"
                            mv -f "$RUN_DIR/iptsd-noise/tap-active.new" "$RUN_DIR/iptsd-noise/tap-active"
                        fi
                    else
                        rm -f "$_tfile" "$RUN_DIR/iptsd-noise/tap-active" 2>/dev/null || true
                    fi

                    _nfile="$TOUCH_STORE/$TOUCH_DEVICE.noise"
                    if [ -s "$_bnoise.out" ]; then
                        cp "$_bnoise.out" "$_nfile.new"
                        chmod 600 "$_nfile.new" 2>/dev/null || true
                        mv -f "$_nfile.new" "$_nfile"
                        if [ "$_ndis" = "1" ]; then
                            : > "$_nfile.disabled"
                            chmod 600 "$_nfile.disabled" 2>/dev/null || true
                            rm -f "$RUN_DIR/iptsd-noise/active" 2>/dev/null || true
                        else
                            rm -f "$_nfile.disabled" 2>/dev/null || true
                            if [ -d "$RUN_DIR/iptsd-noise" ]; then
                                cp "$_nfile" "$RUN_DIR/iptsd-noise/active.new"
                                mv -f "$RUN_DIR/iptsd-noise/active.new" "$RUN_DIR/iptsd-noise/active"
                            fi
                        fi
                    else
                        rm -f "$_nfile" "$_nfile.disabled" "$RUN_DIR/iptsd-noise/active" 2>/dev/null || true
                    fi

                    _pfile="$TOUCH_STORE/$TOUCH_DEVICE.profile"
                    if [ -s "$_bprof" ]; then
                        cp "$_bprof" "$_pfile.new"
                        chmod 600 "$_pfile.new" 2>/dev/null || true
                        mv -f "$_pfile.new" "$_pfile"
                        _apply_src="$_pfile"
                    else
                        rm -f "$_pfile" 2>/dev/null || true
                        printf 'Version=1\nDevice=%s\nCalibrationX=\nCalibrationY=\nCalibrationXTop=\nCalibrationTopStart=0.1\nCalibrationTopEnd=0.3\nContactSizeMax=2.0\n' "$TOUCH_DEVICE" > "$TMP_TOUCH.neutral"
                        _apply_src="$TMP_TOUCH.neutral"
                    fi
                    if ! touch_apply_profile_file "$_apply_src" "$_nonce"; then
                        rm -f "$TMP_TOUCH"* 2>/dev/null || true
                        publish_state "$_dir" || true
                        send_reply "$_dir" "$_nonce" "ERROR" "apply_profile_failed"
                        return 0
                    fi
                    : > "$TOUCH_STORE/$TOUCH_DEVICE.prompted"
                    rm -f "$TMP_TOUCH"* 2>/dev/null || true
                    sync 2>/dev/null || true
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "OK" "bundle"
                    ;;
                SPXNOISE1\ *|SPXNOISE2\ *|SPXNOISE3\ *)
                    _fdev="$(printf '%s\n' "$_first" | awk '{print $2}')"
                    if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                        return 0
                    fi
                    [ -x "$TOUCH_NOISE_TOOL" ] || { rm -f "$TMP_TOUCH" 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "noise_tool_missing"; return 0; }
                    _nfile="$TOUCH_STORE/$TOUCH_DEVICE.noise"
                    if ! "$TOUCH_NOISE_TOOL" "$TOUCH_DEVICE" < "$TMP_TOUCH" > "$_nfile.new" 2>/dev/null; then
                        rm -f "$_nfile.new" "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    chmod 600 "$_nfile.new" 2>/dev/null || true
                    mv -f "$_nfile.new" "$_nfile"
                    rm -f "$_nfile.disabled" 2>/dev/null || true
                    if [ -d "$RUN_DIR/iptsd-noise" ]; then
                        cp "$_nfile" "$RUN_DIR/iptsd-noise/active.new"
                        mv -f "$RUN_DIR/iptsd-noise/active.new" "$RUN_DIR/iptsd-noise/active"
                        if ! touch_reload_noise "$_nonce"; then
                            rm -f "$TMP_TOUCH" 2>/dev/null || true
                            publish_state "$_dir" || true
                            send_reply "$_dir" "$_nonce" "ERROR" "touch_reload_failed"
                            return 0
                        fi
                    fi
                    : > "$TOUCH_STORE/$TOUCH_DEVICE.prompted"
                    rm -f "$TMP_TOUCH" 2>/dev/null || true
                    sync 2>/dev/null || true
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "OK" "noise"
                    ;;
                SPXTAP1\ *)
                    _fdev="$(printf '%s\n' "$_first" | awk '{print $2}')"
                    if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                        return 0
                    fi
                    [ -x "$TOUCH_TAP_TOOL" ] || { rm -f "$TMP_TOUCH" 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "tap_tool_missing"; return 0; }
                    _tfile="$TOUCH_STORE/$TOUCH_DEVICE.tap"
                    if ! "$TOUCH_TAP_TOOL" "$TOUCH_DEVICE" < "$TMP_TOUCH" > "$_tfile.new" 2>/dev/null; then
                        rm -f "$_tfile.new" "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    chmod 600 "$_tfile.new" 2>/dev/null || true
                    mv -f "$_tfile.new" "$_tfile"
                    if [ -d "$RUN_DIR/iptsd-noise" ]; then
                        cp "$_tfile" "$RUN_DIR/iptsd-noise/tap-active.new"
                        mv -f "$RUN_DIR/iptsd-noise/tap-active.new" "$RUN_DIR/iptsd-noise/tap-active"
                        if ! touch_reload_noise "$_nonce"; then
                            rm -f "$TMP_TOUCH" 2>/dev/null || true
                            publish_state "$_dir" || true
                            send_reply "$_dir" "$_nonce" "ERROR" "touch_reload_failed"
                            return 0
                        fi
                    fi
                    : > "$TOUCH_STORE/$TOUCH_DEVICE.prompted"
                    rm -f "$TMP_TOUCH" 2>/dev/null || true
                    sync 2>/dev/null || true
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "OK" "tap"
                    ;;
                *)
                    _fdev="$(read_profile_kv "$TMP_TOUCH" "Device" | tr -d ' ')"
                    if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                        return 0
                    fi
                    [ -x "$TOUCH_CALIB_TOOL" ] || { rm -f "$TMP_TOUCH" 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "calib_tool_missing"; return 0; }
                    if ! "$TOUCH_CALIB_TOOL" validate "$TOUCH_DEVICE" < "$TMP_TOUCH" > /dev/null 2>&1; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    _pfile="$TOUCH_STORE/$TOUCH_DEVICE.profile"
                    cp "$TMP_TOUCH" "$_pfile.new"
                    chmod 600 "$_pfile.new" 2>/dev/null || true
                    mv -f "$_pfile.new" "$_pfile"
                    if ! touch_apply_profile_file "$_pfile" "$_nonce"; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        publish_state "$_dir" || true
                        send_reply "$_dir" "$_nonce" "ERROR" "apply_profile_failed"
                        return 0
                    fi
                    : > "$TOUCH_STORE/$TOUCH_DEVICE.prompted"
                    rm -f "$TMP_TOUCH" 2>/dev/null || true
                    sync 2>/dev/null || true
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "OK" "profile"
                    ;;
            esac
            ;;
        export-touch-calibration)
            if ! resolve_touch_device; then
                send_reply "$_dir" "$_nonce" "ERROR" "touch_device_unavailable"
