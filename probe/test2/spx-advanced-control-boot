            _nfile="$TOUCH_STORE/$TOUCH_DEVICE.noise"
            _tfile="$TOUCH_STORE/$TOUCH_DEVICE.tap"
            _has_any=0
            [ -f "$_pfile" ] && [ ! -L "$_pfile" ] && _has_any=1
            [ -f "$_nfile" ] && [ ! -L "$_nfile" ] && _has_any=1
            [ -f "$_tfile" ] && [ ! -L "$_tfile" ] && _has_any=1
            if [ "$_has_any" = "0" ]; then
                send_reply "$_dir" "$_nonce" "ERROR" "not_found"
                return 0
            fi
            _ndis=0
            [ -e "$_nfile.disabled" ] && _ndis=1
            _btmp="$TMP_TOUCH.bundle"
            rm -f "$_btmp" 2>/dev/null || true
            if ! {
                printf 'SPXTOUCH1\nDevice=%s\nNoiseDisabled=%s\n' "$TOUCH_DEVICE" "$_ndis"
                if [ -f "$_pfile" ] && [ ! -L "$_pfile" ]; then
                    printf '[Profile]\n'
                    awk '{print}' "$_pfile"
                    printf '[/Profile]\n'
                fi
                if [ -f "$_nfile" ] && [ ! -L "$_nfile" ]; then
                    printf '[Noise]\n'
                    awk '{print}' "$_nfile"
                    printf '[/Noise]\n'
                fi
                if [ -f "$_tfile" ] && [ ! -L "$_tfile" ]; then
                    printf '[Tap]\n'
                    awk '{print}' "$_tfile"
                    printf '[/Tap]\n'
                fi
            } > "$_btmp" 2>/dev/null; then
                rm -f "$_btmp" 2>/dev/null || true
                send_reply "$_dir" "$_nonce" "ERROR" "export_failed"
                return 0
            fi
            _esize="$(stat -c %s "$_btmp" 2>/dev/null || echo 999999)"
            if [ "$_esize" -le 0 ] || [ "$_esize" -gt 132096 ]; then
                rm -f "$_btmp" 2>/dev/null || true
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                return 0
            fi
            _tmp="$_dir/.bridge-$$.tmp"
            rm -f "$_tmp" 2>/dev/null || true
            if ! { printf '%s\nOK\n' "$_nonce"; cat "$_btmp"; } > "$_tmp" 2>/dev/null; then
                rm -f "$_tmp" "$_btmp" 2>/dev/null || true
                send_reply "$_dir" "$_nonce" "ERROR" "export_failed"
                return 0
            fi
            rm -f "$_btmp" 2>/dev/null || true
            chmod 600 "$_tmp" 2>/dev/null || true
            _owner="$(stat -c '%u:%g' "$_dir" 2>/dev/null || true)"
            if [ -n "$_owner" ] && [ "$(id -u)" = "0" ]; then
                chown "$_owner" "$_tmp" 2>/dev/null || true
            fi
            mv -f "$_tmp" "$_dir/reply" || { rm -f "$_tmp" 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "export_failed"; return 0; }
            ;;
        set-adb-tcp)
            _enable="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            if ! validate_bool "$_enable"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_arguments"
                return 0
            fi
            if ! apply_adb_tcp "$_enable"; then
                publish_state "$_dir" || true
                send_reply "$_dir" "$_nonce" "ERROR" "adb_tcp_failed"
                return 0
            fi
            write_atomic_file "$STORE/adb_tcp_enabled" 600 "$(printf '%s\n' "$_enable")" || {
                send_reply "$_dir" "$_nonce" "ERROR" "persist_failed"
                return 0
            }
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-ssh-enabled)
            _enable="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            if ! validate_bool "$_enable"; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_arguments"
                return 0
            fi
            if [ "$_enable" = "1" ]; then
                if ! ssh_start_now; then
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "ERROR" "ssh_start_failed"
                    return 0
                fi
            else
                ssh_stop_now || true
            fi
            write_atomic_file "$SSH_STORE/enabled" 600 "$(printf '%s\n' "$_enable")" || {
                send_reply "$_dir" "$_nonce" "ERROR" "persist_failed"
                return 0
            }
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        set-ssh-password)
            _pw="$(sed -n '3p' "$TMP_REQ" | tr -d '\r')"
            rm -f "$TMP_REQ" 2>/dev/null || true
            if [ -z "$_pw" ]; then
                rm -f "$SSH_STORE/root_shadow_hash" 2>/dev/null || true
                if [ -r "$ETC_DIR/shadow" ]; then
                    write_root_shadow_hash "!" || {
                        send_reply "$_dir" "$_nonce" "ERROR" "shadow_write_failed"
                        return 0
                    }
                fi
                sync 2>/dev/null || true
                publish_state "$_dir" || true
                send_reply "$_dir" "$_nonce" "OK"
                return 0
            fi
            _bad_pw="$(printf '%s' "$_pw" | tr -dc '\000-\037\177')"
            if [ "${#_pw}" -gt 128 ] || [ -n "$_bad_pw" ]; then
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_password"
                return 0
            fi
            _hash="$(hash_ssh_password "$_pw" || true)"
            if ! validate_shadow_hash "$_hash"; then
                send_reply "$_dir" "$_nonce" "ERROR" "mkpasswd_failed"
                return 0
            fi
            write_atomic_file "$SSH_STORE/root_shadow_hash" 600 "$(printf '%s\n' "$_hash")" || {
                send_reply "$_dir" "$_nonce" "ERROR" "persist_failed"
                return 0
            }
            if [ "$(read_saved_ssh_enabled)" = "1" ] || is_dropbear_running; then
                write_root_shadow_hash "$_hash" || {
                    send_reply "$_dir" "$_nonce" "ERROR" "shadow_write_failed"
                    return 0
                }
            fi
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        import-ssh-keys)
            tail -n +3 "$TMP_REQ" | tr -d '\r' > "$TMP_TOUCH"
            rm -f "$TMP_REQ" 2>/dev/null || true
            : > "$TMP_TOUCH.sshkeys"
            for _seed in "$SSH_STORE/authorized_keys" "$HOME_ROOT/.ssh/authorized_keys"; do
                if [ -f "$_seed" ] && [ ! -L "$_seed" ]; then
                    while IFS= read -r _sline || [ -n "$_sline" ]; do
                        _sline="$(printf '%s' "$_sline" | tr -d '\r')"
                        case "$_sline" in
                            ''|'#'*) continue ;;
                        esac
                        if _snorm="$(normalize_ssh_key_line "$_sline")"; then
                            append_unique_ssh_key_to_file "$_snorm" "$TMP_TOUCH.sshkeys" || true
                        fi
                    done < "$_seed"
                    break
                fi
            done
            _seen_valid=0
            _added=0
            _invalid=0
            while IFS= read -r _kline || [ -n "$_kline" ]; do
                _trimmed="$(printf '%s' "$_kline" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                case "$_trimmed" in
                    ''|'#'*) continue ;;
                esac
                if ! _knorm="$(normalize_ssh_key_line "$_trimmed")"; then
                    _invalid=1
                    break
                fi
                _seen_valid=$((_seen_valid + 1))
                if append_unique_ssh_key_to_file "$_knorm" "$TMP_TOUCH.sshkeys"; then
                    _added=$((_added + 1))
                fi
            done < "$TMP_TOUCH"
            if [ "$_invalid" = "1" ] || [ "$_seen_valid" -eq 0 ]; then
                rm -f "$TMP_TOUCH" "$TMP_TOUCH.sshkeys" 2>/dev/null || true
                send_reply "$_dir" "$_nonce" "ERROR" "invalid_ssh_key"
                return 0
            fi
            mkdir -p "$SSH_STORE"
            chmod 700 "$SSH_STORE" 2>/dev/null || true
            _auth_tmp="$SSH_STORE/authorized_keys.$$.tmp"
            cp "$TMP_TOUCH.sshkeys" "$_auth_tmp" && chmod 600 "$_auth_tmp" 2>/dev/null && mv -f "$_auth_tmp" "$SSH_STORE/authorized_keys" || {
                rm -f "$_auth_tmp" "$TMP_TOUCH" "$TMP_TOUCH.sshkeys" 2>/dev/null || true
                send_reply "$_dir" "$_nonce" "ERROR" "persist_failed"
                return 0
            }
            rm -f "$TMP_TOUCH" "$TMP_TOUCH.sshkeys" 2>/dev/null || true
            sync_ssh_authorized_keys || {
                send_reply "$_dir" "$_nonce" "ERROR" "sync_keys_failed"
                return 0
            }
            _total="$(count_ssh_authorized_keys)"
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK" "$_added $_total"
            ;;
        clear-ssh-keys)
            rm -f "$SSH_STORE/authorized_keys" 2>/dev/null || true
            if [ -d "$HOME_ROOT/.ssh" ] && [ ! -L "$HOME_ROOT/.ssh" ]; then
                write_atomic_file "$HOME_ROOT/.ssh/authorized_keys" 600 "" || true
            fi
            sync 2>/dev/null || true
            publish_state "$_dir" || true
            send_reply "$_dir" "$_nonce" "OK"
            ;;
        *)
            send_reply "$_dir" "$_nonce" "ERROR" "unknown_command"
            ;;
    esac
    return 0
}

