                        send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                        return 0
                    fi
                    [ -x "$TOUCH_TAP_TOOL" ] || { rm -f "$TMP_TOUCH" 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "tap_tool_missing"; return 0; }
                    _tfile="$TOUCH_STORE/$TOUCH_DEVICE.tap"
                    if ! "$TOUCH_TAP_TOOL" "$TOUCH_DEVICE" < "$TMP_TOUCH" > "$_tfile.new" 2>/dev/null; then
                        rm -f "$_tfile.new" "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    chmod 600 "$_tfile.new" 2>/dev/null || true
                    mv -f "$_tfile.new" "$_tfile"
                    if [ -d "$RUN_DIR/iptsd-noise" ]; then
                        cp "$_tfile" "$RUN_DIR/iptsd-noise/tap-active.new"
                        mv -f "$RUN_DIR/iptsd-noise/tap-active.new" "$RUN_DIR/iptsd-noise/tap-active"
                        if ! touch_reload_noise "$_nonce"; then
                            rm -f "$TMP_TOUCH" 2>/dev/null || true
                            publish_state "$_dir" || true
                            send_reply "$_dir" "$_nonce" "ERROR" "touch_reload_failed"
                            return 0
                        fi
                    fi
                    : > "$TOUCH_STORE/$TOUCH_DEVICE.prompted"
                    rm -f "$TMP_TOUCH" 2>/dev/null || true
                    sync 2>/dev/null || true
                    publish_state "$_dir" || true
                    send_reply "$_dir" "$_nonce" "OK" "tap"
                    ;;
                *)
                    _fdev="$(read_profile_kv "$TMP_TOUCH" "Device" | tr -d ' ')"
                    if is_hex64 "$_fdev" && [ "$_fdev" != "$TOUCH_DEVICE" ]; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "device_mismatch"
                        return 0
                    fi
                    [ -x "$TOUCH_CALIB_TOOL" ] || { rm -f "$TMP_TOUCH" 2>/dev/null || true; send_reply "$_dir" "$_nonce" "ERROR" "calib_tool_missing"; return 0; }
                    if ! "$TOUCH_CALIB_TOOL" validate "$TOUCH_DEVICE" < "$TMP_TOUCH" > /dev/null 2>&1; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        send_reply "$_dir" "$_nonce" "ERROR" "invalid_calibration_file"
                        return 0
                    fi
                    _pfile="$TOUCH_STORE/$TOUCH_DEVICE.profile"
                    cp "$TMP_TOUCH" "$_pfile.new"
                    chmod 600 "$_pfile.new" 2>/dev/null || true
                    mv -f "$_pfile.new" "$_pfile"
                    if ! touch_apply_profile_file "$_pfile" "$_nonce"; then
                        rm -f "$TMP_TOUCH" 2>/dev/null || true
                        publish_state "$_dir" || true
                        send_reply "$_dir" "$_nonce" "ERROR" "apply_profile_failed"
                        return 0
