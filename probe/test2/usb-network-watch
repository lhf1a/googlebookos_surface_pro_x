#!/bin/busybox sh
# Only load matching USB drivers. Android owns Ethernet, DHCP and saved Wi-Fi.
# No association, addresses, routes, DHCP client, module removal or radio policy.
set -u
export PATH=/bin:/sbin
case " $(cat /proc/cmdline) " in *' sq2.rescue=1 '*|*' sq2.usb=0 '*) exit 0;; esac
[ -s /etc/sq2-usb-network.aliases ] || exit 0
cache=/run/sq2-usb-network
mkdir -p "$cache"
if [ "${1:-}" != --once ]; then
    if [ -r "$cache/pid" ] && kill -0 "$(cat "$cache/pid")" 2>/dev/null; then exit 0; fi
    echo $$ > "$cache/pid"
fi
while true; do
    ready=$(nsenter -t 1 -m -r -- /system/bin/getprop sys.boot_completed 2>/dev/null)
    if [ "$ready" != 1 ]; then
        [ "${1:-}" = --once ] && exit 1
        sleep 2
        continue
    fi
    for d in /sys/bus/usb/devices/*:*; do
        [ -e "$d/driver" ] && continue
        alias=$(cat "$d/modalias" 2>/dev/null) || continue
        case "$alias" in usb:*) ;; *) continue;; esac
        id=$(basename "$d")
        physical=${d%:*}
        serial=$(cat "$physical/devnum" 2>/dev/null) || continue
        identity=$serial:$alias
        [ "$(cat "$cache/$id" 2>/dev/null)" = "$identity" ] && continue
        # The whitelist is produced from the audited additive module set.
        # Resolving a USB alias must not pull in arbitrary platform drivers.
        while read pattern module; do
            case "$alias" in $pattern)
                # BusyBox small modprobe may first try the leaf module. Preload
                # depmod's ordered dependencies to avoid unknown-symbol probes.
                line=$(grep "/$module.ko:" /lib/modules/"$(uname -r)"/modules.dep | head -n 1)
                deps=${line#*:}
                ordered=
                for dependency in $deps; do ordered="$dependency $ordered"; done
                for dependency in $ordered; do
                    dependency=${dependency##*/}
                    modprobe "${dependency%.ko}" || break
                done
                if modprobe "$module"; then
                    echo "USB_NETWORK_MODULE=$module $id"
                else
                    echo "USB_NETWORK_LOAD_FAILED=$module $id" >&2
                fi
                ;;
            esac
        done < /etc/sq2-usb-network.aliases
        printf '%s\n' "$identity" > "$cache/$id"
    done
    [ "${1:-}" = --once ] && exit 0
    sleep 2
done
