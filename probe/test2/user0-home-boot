#!/bin/busybox sh
# Bounded first-boot repair; never replace a user's chosen HOME application.
set -eu
a() { timeout 5 nsenter -t 1 -m -r -- /system/bin/"$@"; }
n=0
while [ "$n" -lt 1800 ]; do
    if [ "$(a getprop sys.boot_completed 2>/dev/null || true)" = 1 ]; then
        [ "$(a getprop ro.fw.mu.headless_system_user)" = false ] || exit 0
        [ "$(a am get-current-user)" = 0 ] || exit 0
        # boot_completed can precede completion/skip of Setup Wizard. Do not
        # mistake its temporary HOME (or early Nexus selection) for a choice.
        provisioned=$(a settings get global device_provisioned 2>/dev/null || true)
        setup=$(a settings --user 0 get secure user_setup_complete 2>/dev/null || true)
        if [ "$provisioned" = 1 ] && [ "$setup" = 1 ]; then
            home=$(a cmd package resolve-activity --brief --user 0 \
                -a android.intent.action.MAIN -c android.intent.category.HOME 2>/dev/null || true)
            case "$home" in
                *com.google.android.desktop.identity.login/*LoginLauncherActivity*)
                    /bin/apply-sq2-user0-home
                    # Changing HOME alone does not dismiss the already focused
                    # LoginLauncher mask. Enter the resolved launcher explicitly.
                    a am start -W --user 0 -a android.intent.action.MAIN -c android.intent.category.HOME
                    exit 0 ;;
                *com.google.android.setupwizard/*|*com.google.android.desktop.setupwizard/*|*ResolverActivity*|'')
                    : ;; # Package manager/setup is still transitioning.
                */*) exit 0 ;; # Retain Nexus or a user's other chosen launcher.
            esac
        fi
    fi
    n=$((n+1))
    sleep 2
done
echo 'USER0_HOME: setup/HOME did not become ready within the one-shot window' >&2
exit 1
