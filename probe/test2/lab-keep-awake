#!/bin/busybox sh
# Screen-only policy: a partial framework lock reduces autosuspend attempts.
# The kernel's read-only suspend.screen_only guard is the actual protection.
# Do not hold the display awake or override a user's normal screen timeout.
export PATH=/bin:/sbin
android() { timeout 8 nsenter -t 1 -m -r -- /system/bin/"$@"; }
configured=
ticks=0
echo 'LAB_SCREEN_ONLY: partial wakelock; kernel guard blocks system suspend.'
while true; do
    locks=$(android cmd power set-wakelock list 2>/dev/null)
    if ! printf '%s\n' "$locks" | grep 'PARTIAL_WAKE_LOCK:.*held=true' >/dev/null; then
        result=$(android cmd power set-wakelock acquire PARTIAL_WAKE_LOCK 2>&1)
        case "$result" in
            *held=true*) date -u; echo "$result"; configured= ;;
        esac
    fi
    if [ "$(android getprop sys.boot_completed 2>/dev/null)" = 1 ]; then
        server=$(pidof system_server)
        user=$(android cmd activity get-current-user 2>/dev/null)
        case "$user" in ''|*[!0-9]*) user= ;; esac
        if [ -n "$server" ] && [ -n "$user" ] && [ "$configured" != "$server:$user" ]; then
            # Migrate only the old lab's effectively infinite timeout.
            # Preserve any finite timeout the user selected.
            for target in 0 "$user"; do
                value=$(android settings --user "$target" get system screen_off_timeout)
                if [ "$value" = 2147483647 ]; then
                    android settings --user "$target" put system screen_off_timeout 120000
                fi
            done
            configured=$server:$user
            echo "LAB_SCREEN_ONLY: system_server=$server user=$user"
        fi
    fi
    if [ "$ticks" = 0 ]; then
        {
            date -u
            cat /proc/uptime
            android cmd power set-wakelock list
            android dumpsys suspend_control_internal --suspend_controls --kernel_suspends
        } > /logs/power-state-next.txt 2>&1
        mv /logs/power-state-next.txt /logs/power-state-latest.txt
    fi
    ticks=$(( (ticks + 1) % 4 ))
    sleep 15
done
