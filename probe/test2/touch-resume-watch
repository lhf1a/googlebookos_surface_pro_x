#!/bin/busybox sh
# Follow the selected transport; USB/I2C/other HID devices without this SPI
# driver's resume counter are not subjected to SPI-specific restarts.
set -u
export PATH="${SPX_TOUCH_PATH:-/bin:/sbin:${PATH:-}}"

SYSFS="${SPX_TOUCH_SYSFS:-/sys}"
RUN_DIR="${SPX_TOUCH_RUN:-/run}"
DATA_ROOT="${SPX_TOUCH_ROOT:-/proc/1/root}"
TOUCH_SERVICES="${SPX_TOUCH_SERVICES:-/bin/touch-services}"
TOUCH_DISABLED="${SPX_TOUCH_DISABLED:-/run/touch-disabled}"
POLL_SLEEP="${SPX_TOUCH_POLL_SLEEP:-0.5}"
READY_POLLS="${SPX_TOUCH_READY_POLLS:-60}"
READY_SLEEP="${SPX_TOUCH_READY_SLEEP:-0.1}"
RECOVERY_ATTEMPTS="${SPX_TOUCH_RECOVERY_ATTEMPTS:-2}"
RECOVERY_SLEEP="${SPX_TOUCH_RECOVERY_SLEEP:-0.5}"
MAX_LOOPS="${SPX_TOUCH_MAX_LOOPS:-0}"

is_touch_disabled() {
    [ -e "$TOUCH_DISABLED" ] && return 0
    [ -f "$DATA_ROOT/data/vendor/spx-advanced-control/touch_disabled" ] || return 1
    [ "$(tr -d '\r\n ' < "$DATA_ROOT/data/vendor/spx-advanced-control/touch_disabled" 2>/dev/null || true)" = "1" ]
}

stop_iptsd() {
    [ -r "$RUN_DIR/iptsd.pid" ] || return 0
    pid=$(cat "$RUN_DIR/iptsd.pid")
    case "$pid" in ''|*[!0-9]*) exit 1;; esac
    if [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = iptsd ]; then
        kill "$pid" 2>/dev/null || true
        for w in $(seq 1 10); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
    fi
    rm -f "$RUN_DIR/iptsd.pid"
}

panel_is_on() {
    for _pio_en in "$SYSFS"/class/drm/card*-eDP-*/enabled; do
        [ -r "$_pio_en" ] || continue
        read -r _pio_val < "$_pio_en" 2>/dev/null || _pio_val=
        [ "$_pio_val" = enabled ] || return 1
        _pio_dpms="${_pio_en%/*}/dpms"
        if [ -r "$_pio_dpms" ]; then
            read -r _pio_dv < "$_pio_dpms" 2>/dev/null || _pio_dv=
            [ "$_pio_dv" = On ] || return 1
        fi
    done
    for _pio_bl in "$SYSFS"/class/backlight/*; do
        [ -d "$_pio_bl" ] || continue
        if [ -r "$_pio_bl/bl_power" ]; then
            read -r _pio_bp < "$_pio_bl/bl_power" 2>/dev/null || _pio_bp=0
            [ "$_pio_bp" = 0 ] || return 1
        fi
        if [ -r "$_pio_bl/brightness" ]; then
            read -r _pio_br < "$_pio_bl/brightness" 2>/dev/null || _pio_br=1
            [ "$_pio_br" != 0 ] || return 1
        fi
    done
    return 0
}

previous=
watched=
pending_reinit=0
pending_count=
loops=0
while :; do
    if [ ! -r "$RUN_DIR/iptsd-hidraw" ]; then
        loops=$((loops + 1))
        if [ "$MAX_LOOPS" -gt 0 ] && [ "$loops" -ge "$MAX_LOOPS" ]; then exit 0; fi
        sleep "$POLL_SLEEP"
        continue
    fi
    [ -r "$RUN_DIR/iptsd-ready" ] || exit 0
    read -r ready_path < "$RUN_DIR/iptsd-ready"
    counter=${ready_path%/*}/resume_count
    [ -r "$counter" ] || exit 0
    current=$(cat "$counter" 2>/dev/null) || {
        loops=$((loops + 1))
        if [ "$MAX_LOOPS" -gt 0 ] && [ "$loops" -ge "$MAX_LOOPS" ]; then exit 0; fi
        sleep "$POLL_SLEEP"
        continue
    }
    if [ "$watched" != "$counter" ]; then previous=$current; watched=$counter; pending_reinit=0; fi
    if [ "$current" != "$previous" ]; then
        previous=$current
        pending_reinit=1
        pending_count=$current
    fi
    if [ "$pending_reinit" = 1 ] && panel_is_on; then
        pending_reinit=0
        ready=0
        for n in $(seq 1 "$READY_POLLS"); do
            if [ "$(cat "$ready_path" 2>/dev/null)" = ready ]; then ready=1; break; fi
            sleep "$READY_SLEEP"
        done
        if [ "$ready" = 0 ]; then
            echo "TOUCH_RESUME_NOT_READY count=$pending_count"
            if is_touch_disabled; then
                stop_iptsd
                : > "$TOUCH_DISABLED"
                echo "TOUCH_RESUME_SKIPPED_DISABLED count=$pending_count"
            else
                attempt=1
                while [ "$attempt" -le "$RECOVERY_ATTEMPTS" ]; do
                    if ! panel_is_on; then
                        pending_reinit=1
                        break
                    fi
                    latest=$(cat "$counter" 2>/dev/null || true)
                    if [ -n "$latest" ] && [ "$latest" != "$previous" ]; then
                        previous=$latest
                        pending_count=$latest
                    fi
                    stop_iptsd
                    sleep "$RECOVERY_SLEEP"
                    echo "TOUCH_RESUME_RECOVER_CYCLE count=$pending_count attempt=$attempt"
                    if "$TOUCH_SERVICES"; then
                        echo "TOUCH_RESUME_RECOVERED count=$pending_count attempt=$attempt"
                        break
                    fi
                    echo "TOUCH_RESUME_RECOVER_FAILED count=$pending_count attempt=$attempt"
                    attempt=$((attempt + 1))
                done
            fi
        else
            stop_iptsd
            if is_touch_disabled; then
                : > "$TOUCH_DISABLED"
                echo "TOUCH_RESUME_SKIPPED_DISABLED count=$pending_count"
            else
                echo "TOUCH_RESUME_REINITIALIZE count=$pending_count"
                "$TOUCH_SERVICES" || echo "TOUCH_RESUME_FAILED count=$pending_count"
            fi
        fi
    fi
    loops=$((loops + 1))
    if [ "$MAX_LOOPS" -gt 0 ] && [ "$loops" -ge "$MAX_LOOPS" ]; then exit 0; fi
    if [ "$pending_reinit" = 0 ] && [ "$MAX_LOOPS" = 0 ] && [ -r "$ready_path" ] && command -v spx-event-wait >/dev/null 2>&1; then
        spx-event-wait --oneshot --sysfs "$ready_path" --check-file-diff "$counter:$previous" --debounce-ms 100 --timeout-ms 30000 >/dev/null 2>&1 || sleep "$POLL_SLEEP"
    else
        sleep "$POLL_SLEEP"
    fi
done
