#!/bin/busybox sh
# Private lab helper in retained initramfs. Never unloads resident providers.
# Run after Android boot; the paired C2 service may register before this.
set -eu
case " $(cat /proc/cmdline) " in *' sq2.video=0 '*) exit 0;; esac
case " $(cat /proc/cmdline) " in *' sq2.rescue=1 '*) exit 0;; esac
case " $(cat /proc/cmdline) " in *' sq2.video.c2=experimental '*) ;; *) exit 0;; esac
test "$(uname -r)" = 6.3.8-sq2-android1
test "$(cat /sys/module/suspend/parameters/screen_only)" = Y
test "$(nsenter -t 1 -m -r -- /system/bin/getprop sys.boot_completed)" = 1
cd /etc/sq2-video-native
sha256sum -c SHA256SUMS
printf '%s\n' '4e93d34504da96320775476bbd509aa06f985b48fb781d4436c8eb812b929928  /lib/firmware/qcom/venus-5.2/venus.mbn' | sha256sum -c -
for module in sq2_iris1_identify sq2_hfi_overlay videocc_sm8150 venus_core venus_dec sq2_iris1_phase; do
 test ! -d "/sys/module/$module" || { echo "RESIDENT_REFUSED=$module"; exit 3; }
done
test ! -e /tmp/sq2-native-pas-attempted
# Serialize attempts before any device publication. A failed attempt requires reboot.
mkdir /tmp/sq2-video-start-once
for module in videodev videobuf2-common videobuf2-memops videobuf2-v4l2 videobuf2-dma-contig v4l2-mem2mem; do
 insmod "$module.ko"
done
insmod sq2_iris1_identify.ko allow=1
insmod videocc-sm8150.ko
test -L /sys/bus/platform/devices/ab00000.clock-controller/driver
ph=$(od -An -tx1 /sys/firmware/devicetree/base/soc@0/clock-controller@ab00000/phandle | tr -d ' \n')
test "$ph" = 000000b5
insmod venus-core.ko sq2_platform_allow=1
insmod venus-dec.ko
cat /proc/sys/kernel/random/boot_id > /tmp/sq2-native-pas-attempted
insmod sq2_hfi_overlay.ko allow=1
test -L /sys/bus/platform/devices/aa00000.venus-sq2/driver
test -c /dev/video0
echo SQ2_NATIVE_VIDEO_READY_NOT_FRAME_PROOF
