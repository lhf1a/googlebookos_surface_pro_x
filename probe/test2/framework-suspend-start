#!/bin/busybox sh
# Let only the verified native Android suspend process use the opt-in gate.
set -eu
export PATH=/bin:/sbin
if [ "$(cat /sys/module/suspend/parameters/screen_only 2>/dev/null)" != Y ]; then
    echo UNRESTRICTED_SUSPEND_NO_OWNER_REGISTRATION
    exit 0
fi
case " $(cat /proc/cmdline) " in *" sq2.rescue=1 "*) exit 0;; esac
case " $(cat /proc/cmdline) " in *" suspend.screen_only_autosuspend=1 "*) ;; *) exit 0;; esac
params=/sys/module/suspend/parameters
[ "$(cat "$params/screen_only")" = Y ]
[ "$(cat "$params/screen_only_autosuspend")" = Y ]
expected=$(cat /etc/surface-pm/system-suspend.sha256)
case "$expected" in *[!0-9a-f]*|'') echo INVALID_OWNER_MANIFEST; exit 1;; esac
[ "${#expected}" = 64 ]
for attempt in $(seq 1 180); do
 if [ "$(timeout 5 nsenter -t 1 -m -r -- /system/bin/getprop sys.boot_completed 2>/dev/null || true)" = 1 ]; then
  pids=$(pidof android.system.suspend-service || true)
  set -- $pids
  if [ "$#" = 1 ]; then
   pid=$1
   if [ "$(readlink "/proc/$pid/exe")" = /system/bin/hw/android.system.suspend-service ] &&
      [ "$(awk '/^Uid:/{print $2 ":" $3 ":" $4 ":" $5}' "/proc/$pid/status")" = 1000:1000:1000:1000 ]; then
    actual=$(sha256sum "/proc/$pid/exe"); actual=${actual%% *}
    [ "$actual" = "$expected" ] || { echo OWNER_EXECUTABLE_MISMATCH; exit 1; }
    echo "$pid" > "$params/autosuspend_tgid"
    [ "$(cat "$params/autosuspend_tgid")" = "$pid" ]
    echo "ANDROID_AUTOSUSPEND_OWNER_READY tgid=$pid sha256=$actual"
    exit 0
   fi
  fi
 fi
 sleep 1
done
echo ANDROID_AUTOSUSPEND_OWNER_NOT_READY
exit 1
