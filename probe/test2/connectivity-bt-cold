#!/bin/busybox sh
# One attempt per boot. Never unload a live QCA UART driver during this test.
set -eu
test ! -e /sys/module/hci_uart
root=/proc/1/root
nsenter -t 1 -m -r -- /system/bin/setprop ctl.stop vendor.bluetooth-aidl-qti
# Use the patched modules installed in this boot's initramfs. No live unload.
tar -xzf /tmp/qca-firmware.tar.gz -C "$root/debug_ramdisk/sq2-firmware"
ln -sf crbtfw21.tlv "$root/debug_ramdisk/sq2-firmware/qca/crbtfw01.tlv"
ln -sf crnv21.bin "$root/debug_ramdisk/sq2-firmware/qca/crnv01.bin"
cp /tmp/android.hardware.bluetooth-service.cuttlefish "$root/vendor/bin/hw/sq2-bluetooth"
chmod 755 "$root/vendor/bin/hw/sq2-bluetooth" /tmp/sq2-hci-bridge
modprobe hci_uart
sleep 3
nohup /tmp/sq2-hci-bridge 0 /dev/sq2-bt-h4 > /logs/bluetooth-bridge.txt 2>&1 < /dev/null &
echo $! > /run/sq2-bt-bridge.pid
for attempt in $(seq 1 80); do
    test -L /dev/sq2-bt-h4 && break
    kill -0 "$(cat /run/sq2-bt-bridge.pid)" || exit 1
    sleep 1
done
test -L /dev/sq2-bt-h4
nsenter -t 1 -m -r -- /system/bin/sh -c '/vendor/bin/hw/sq2-bluetooth --serial /dev/sq2-bt-h4 > /debug_ramdisk/logs/bluetooth-hal.txt 2>&1 < /dev/null &'
sleep 2
nsenter -t 1 -m -r -- /system/bin/cmd bluetooth_manager enable
