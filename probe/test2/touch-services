#!/bin/busybox sh
# Discover the actual IPTS protocol/type, not a CPU name or VID:PID allowlist.
if [ -r /run/iptsd.pid ] && kill -0 "$(cat /run/iptsd.pid)" 2>/dev/null; then exit 0; fi
mkdir -p /logs
[ -c /dev/uinput ] || { echo UINPUT_MISSING > /logs/touch-service.txt; exit 1; }
rm -f /run/iptsd-hidraw /run/iptsd-hid-id /run/iptsd-ready
: > /logs/touch-service.txt
selected=
selected_sys=
selected_ready=
for d in /sys/class/hidraw/hidraw*; do
    [ -r "$d/device/report_descriptor" ] || continue
    node=/dev/${d##*/}
    exec 3<> "$node" || continue
    # SPI controller numbering is not stable. Use this HID device's ancestry.
    ancestor=$(readlink -f "$d/device")
    ready=
    while [ -n "$ancestor" ] && [ "$ancestor" != / ]; do
        if [ -r "$ancestor/ready" ]; then ready=$ancestor/ready;break;fi
        ancestor=${ancestor%/*}
    done
    if [ -n "$ready" ]; then
        for i in $(seq 1 12); do
            [ "$(cat "$ready" 2>/dev/null)" = ready ] && break
            sleep 1
        done
        if [ "$(cat "$ready" 2>/dev/null)" != ready ]; then
            echo "TRANSPORT_NOT_READY=$node" >> /logs/touch-service.txt
            exec 3>&-;continue
        fi
    fi
    timeout 15 iptsd-check-device -t touchscreen "$node" >> /logs/touch-service.txt 2>&1
    checked=$?
    if [ "$checked" -ne 0 ] && [ -n "$ready" ]; then
        sleep 2
        timeout 15 iptsd-check-device -t touchscreen "$node" >> /logs/touch-service.txt 2>&1
        checked=$?
    fi
    if [ "$checked" -ne 0 ]; then exec 3>&-;continue;fi
    if [ -n "$selected" ]; then
        echo "MULTIPLE_IPTS_TOUCHSCREENS: $selected $node; no arbitrary selection" >> /logs/touch-service.txt
        exit 2
    fi
    selected=$node;selected_sys=$d;selected_ready=$ready
    # Keep the accepted transport powered until the daemon owns its handle.
    exec 4<&3
    exec 3>&-
done
[ -n "$selected" ] || { echo NO_SUPPORTED_IPTS_TOUCHSCREEN >> /logs/touch-service.txt; exit 2; }
hid=$(sed -n 's/^HID_ID=//p' "$selected_sys/device/uevent")
rest=${hid#*:};vendor=${rest%%:*};product=${rest#*:}
case "$vendor$product" in ''|*[!0-9a-fA-F]*) exit 1;; esac
printf '%04X:%04X\n' "$((0x$vendor))" "$((0x$product))" > /run/iptsd-hid-id
[ -z "$selected_ready" ] || printf '%s\n' "$selected_ready" > /run/iptsd-ready
printf '%s\n' "$selected" > /run/iptsd-hidraw
echo "SELECTED=$selected HID_ID=$hid" >> /logs/touch-service.txt
if [ -f /run/iptsd-calibrated.conf ]; then export IPTSD_CONFIG_FILE=/run/iptsd-calibrated.conf;fi
iptsd "$selected" 4>&- > /logs/iptsd.txt 2>&1 &
echo "$!" > /run/iptsd.pid
sleep 4
if ! kill -0 "$(cat /run/iptsd.pid)" 2>/dev/null; then echo IPTSD_EXITED >> /logs/touch-service.txt;exit 1;fi
echo "IPTSD_RUNNING device=$selected" >> /logs/touch-service.txt
if [ -x /proc/1/root/system/bin/getprop ] && command -v refresh-iptsd-input-nodes >/dev/null 2>&1; then
    refresh-iptsd-input-nodes >> /logs/touch-service.txt 2>&1 || exit $?
fi
exit 0
