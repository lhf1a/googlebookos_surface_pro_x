#!/bin/sh
# Lower connector only. Standard Android init/adbd owns ADB descriptors and auth.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

android() {
 if [ -n "${SPX_LOWER_USB_ANDROID_WRAPPER:-}" ]; then
  "$SPX_LOWER_USB_ANDROID_WRAPPER" "$@"
 else
  nsenter -t 1 -m -r -- "$@"
 fi
}
get() { android /system/bin/getprop "$1"; }
setprop() { android /system/bin/setprop "$1" "$2"; }

root=${SPX_LOWER_USB_ROOT:-/proc/1/root}
sysfs=${SPX_LOWER_USB_SYSFS:-/sys}
role=${SPX_LOWER_USB_ROLE:-$sysfs/bus/platform/devices/surface-typec/lower_data_role}
typec_dir=${role%/*}
auto_dp=${SPX_LOWER_USB_AUTO_DP:-$typec_dir/lower_auto_dp}
dp_state_node=${SPX_LOWER_USB_DP_STATE:-$typec_dir/lower_dp_state}
storage_node=${SPX_LOWER_USB_STORAGE:-$typec_dir/storage_ports}
watch_bin=${SPX_LOWER_USB_WATCH_BIN:-/bin/spx-lower-usb-watch}
logs_dir=${SPX_LOWER_USB_LOGS:-/logs}
if [ -n "${SPX_LOWER_USB_RUN:-}" ]; then
 run_dir=$SPX_LOWER_USB_RUN
elif [ -n "${SPX_LOWER_USB_ROOT:-}" ]; then
 run_dir=$root/run
else
 run_dir=/run
fi
pidfile=$run_dir/spx-lower-usb-watch.pid
lock_dir=$run_dir/spx-lower-usb.lock
state=$root/data/vendor/surface-usb
g=$root/config/usb_gadget/g1
usb_vintf=${SPX_USB_VINTF:-$root/vendor/etc/vintf/manifest/android.hardware.usb-service.qti.xml}

qti_usb_hal_declared() { [ -r "$usb_vintf" ] && grep -Fq 'IUsb/default' "$usb_vintf"; }

is_boot_storage_locked() {
 [ -r "$storage_node" ] || return 1
 mask=$(cat "$storage_node" 2>/dev/null || echo 0)
 case "$mask" in ''|*[!0-9]*) mask=0 ;; esac
 [ $((mask & 1)) -ne 0 ]
}

read_saved_mode() {
 if [ -f "$state/lower-mode" ]; then
  cat "$state/lower-mode"
 else
  echo auto
 fi
}

is_watch_running() {
 [ -r "$pidfile" ] || return 1
 wpid=$(head -n 1 "$pidfile" 2>/dev/null | tr -d '\r\n ')
 case "$wpid" in ''|*[!0-9]*) return 1 ;; esac
 [ "$wpid" -gt 1 ] || return 1
 kill -0 "$wpid" 2>/dev/null || return 1
 if [ -r "/proc/$wpid/cmdline" ]; then
  wcmd=$(tr '\000' ' ' < "/proc/$wpid/cmdline" 2>/dev/null || true)
  case "$wcmd" in
   *spx-lower-usb-watch*) return 0 ;;
   *) return 1 ;;
  esac
 fi
 return 0
}

stop_watcher() {
 if [ -r "$pidfile" ]; then
  wpid=$(head -n 1 "$pidfile" 2>/dev/null | tr -d '\r\n ')
  case "$wpid" in
   ''|*[!0-9]*) ;;
   *)
    if [ "$wpid" -gt 1 ] && kill -0 "$wpid" 2>/dev/null && is_watch_running; then
     kill "$wpid" 2>/dev/null || true
     i=0
     while [ "$i" -lt 20 ]; do
      kill -0 "$wpid" 2>/dev/null || break
      sleep 0.1
      i=$((i + 1))
     done
     kill -9 "$wpid" 2>/dev/null || true
    fi
    ;;
  esac
 fi
 rm -f "$pidfile" 2>/dev/null || true
}

set_auto_dp() {
 if [ -w "$auto_dp" ]; then
  printf '%s\n' "$1" > "$auto_dp"
 fi
}

lock_held=0
release_lock() {
 if [ "$lock_held" = 1 ]; then
  rmdir "$lock_dir" 2>/dev/null || rm -rf "$lock_dir" 2>/dev/null || true
  lock_held=0
 fi
}
acquire_lock() {
 mkdir -p "$run_dir" 2>/dev/null || true
 i=0
 while ! mkdir "$lock_dir" 2>/dev/null; do
  if [ -r "$lock_dir/pid" ]; then
   lpid=$(head -n 1 "$lock_dir/pid" 2>/dev/null | tr -d '\r\n ')
   case "$lpid" in
    ''|*[!0-9]*) ;;
    *)
     if ! kill -0 "$lpid" 2>/dev/null; then
      rm -rf "$lock_dir" 2>/dev/null || true
      continue
     fi
     ;;
   esac
  fi
  i=$((i + 1))
  [ "$i" -lt 150 ] || { echo 'Timed out waiting for lower USB lock' >&2; exit 1; }
  sleep 0.1
 done
 lock_held=1
 printf '%s\n' "$$" > "$lock_dir/pid" 2>/dev/null || true
}
trap release_lock EXIT INT TERM

print_status() {
 cur_role=$(cat "$role" 2>/dev/null || echo unknown)
 if is_watch_running; then
  active_mode=auto
 elif [ -r "$auto_dp" ] && [ "$(cat "$auto_dp" 2>/dev/null || echo 0)" = 1 ]; then
  active_mode=auto
 elif [ "$cur_role" = host ]; then
  active_mode=host
 else
  active_mode=adb
 fi
 printf 'mode=%s\n' "$active_mode"
 printf 'role=%s\n' "$cur_role"
 printf 'watch=%s\n' "$(is_watch_running && echo running || echo stopped)"
 if [ -r "$dp_state_node" ]; then
  printf 'dp_state=%s\n' "$(cat "$dp_state_node" 2>/dev/null || echo unknown)"
 fi
 printf 'boot_storage_locked=%s\n' "$(is_boot_storage_locked && echo 1 || echo 0)"
 printf 'config='; get sys.usb.config
 printf 'usb_state='; get sys.usb.state
 printf 'adb_secure='; get ro.adb.secure
 printf 'saved_mode=%s\n' "$(read_saved_mode)"
 for p in "$sysfs"/class/udc/*/state; do [ ! -f "$p" ] || cat "$p"; done
}

apply_adb() {
 if is_boot_storage_locked; then
  echo 'Lower port hosts boot storage' >&2
  exit 1
 fi
 test -e "$role"
 cur_role=$(cat "$role")
 cur_state=$(get sys.usb.state)
 cur_udc=$(cat "$g/UDC" 2>/dev/null || true)
 if [ "$cur_role" = device ] && [ "$cur_state" = adb ] && [ "$cur_udc" = a600000.usb ]; then
  return 0
 fi
 # Do not steal an active DP connection or mounted USB storage. Caller disconnects first.
 if [ "$cur_role" != device ]; then
  for p in "$sysfs"/firmware/devicetree/base/soc@0/usb@a6f8800/usb@a600000; do
   test -d "$p"
  done
  for p in "$sysfs"/devices/platform/soc@0/a6f8800.usb/a600000.usb/xhci-hcd.*/usb*/*/idVendor; do
   [ ! -f "$p" ] || { echo 'Disconnect lower-port USB peripherals before changing role' >&2; exit 1; }
  done
 fi
 # Native role setter rejects device role while lower DP is active.
 echo device > "$role"
 # DWC3 role work is asynchronous; wait for the real lower UDC to register.
 for i in $(seq 1 50); do
  [ -d "$sysfs/class/udc/a600000.usb" ] && break
  sleep 0.1
 done
 test -d "$sysfs/class/udc/a600000.usb"
 # Requested ADB mode also enables Android's authorization UI; never disables auth.
 android /system/bin/settings put global adb_enabled 1
 if [ "$(get init.svc.vendor.usb-hal)" = running ]; then
  setprop ctl.stop vendor.usb-hal
  for i in $(seq 1 30); do [ "$(get init.svc.vendor.usb-hal)" != running ] && break; sleep 0.1; done
 fi
 test "$(get init.svc.vendor.usb-hal)" != running
 test -d "$g/functions/ffs.adb"
 if [ -n "$(cat "$g/UDC")" ]; then echo '' > "$g/UDC"; fi
 # Remove configuration links, never function instances owned by Android init.
 for p in "$g/configs/b.1/"*; do [ ! -L "$p" ] || rm "$p"; done
 setprop sys.usb.configfs 1
 if [ "$(get sys.usb.config)" != none ] || [ "$(get sys.usb.state)" != none ]; then
  setprop sys.usb.config none
  for i in $(seq 1 30); do [ "$(get sys.usb.state)" = none ] && break; sleep 0.1; done
 fi
 for p in "$sysfs"/class/udc/*; do
  [ -e "$p" ] || continue
  controller=${p##*/}
  case "$(readlink -f "$p")" in */a6f8800.usb/a600000.usb/udc/*) setprop sys.usb.controller "$controller";; esac
 done
 test "$(get sys.usb.controller)" = a600000.usb
 setprop sys.usb.config adb
 # Standard init binds after adbd/bridge has supplied FunctionFS descriptors.
 for i in $(seq 1 60); do
  [ "$(get sys.usb.state)" = adb ] && [ -n "$(cat "$g/UDC")" ] && break
  sleep 0.2
 done
 test "$(get sys.usb.state)" = adb
 test "$(cat "$g/UDC")" = a600000.usb
}

apply_host() {
 test -e "$role"
 if [ -n "$(cat "$g/UDC" 2>/dev/null || true)" ]; then echo '' > "$g/UDC"; fi
 if [ "$(get sys.usb.config)" != none ] || [ "$(get sys.usb.state)" != none ]; then
  setprop sys.usb.config none
  for i in $(seq 1 30); do [ "$(get sys.usb.state)" = none ] && break; sleep 0.1; done
 fi
 for p in "$g/configs/b.1/"*; do [ ! -L "$p" ] || rm "$p"; done
 echo host > "$role"
 if qti_usb_hal_declared; then
  setprop sys.usb.configfs 2
  setprop ctl.start vendor.usb-hal
 else
  setprop sys.usb.configfs 1
 fi
 # Restore the original local authenticated ADB/bridge service; do not enable TCP externally.
 setprop ctl.start adbd
}

save_mode_file() {
 mkdir -p "$state"; chmod 700 "$state"
 printf '%s\n' "$1" > "$state/lower-mode.new"
 chmod 600 "$state/lower-mode.new"
 mv "$state/lower-mode.new" "$state/lower-mode"
}

export_watch_env() {
 for v in SPX_LOWER_USB_ROOT SPX_LOWER_USB_SYSFS SPX_LOWER_USB_RUN \
          SPX_LOWER_USB_ROLE SPX_LOWER_USB_AUTO_DP SPX_LOWER_USB_DP_STATE \
          SPX_LOWER_USB_STORAGE SPX_LOWER_USB_ANDROID_WRAPPER SPX_USB_VINTF; do
  eval "val=\${$v:-}"
  if [ -n "$val" ]; then
   export "$v"
  fi
 done
}

start_watcher() {
 [ -x "$watch_bin" ] || { echo "Missing watcher binary: $watch_bin" >&2; exit 1; }
 mkdir -p "$run_dir" 2>/dev/null || true
 mkdir -p "$logs_dir" 2>/dev/null || true
 log_target="$logs_dir/spx-lower-usb-watch.txt"
 if ! : >> "$log_target" 2>/dev/null; then
  log_target=/dev/null
 fi
 export_watch_env
 "$watch_bin" --helper "$0" --sysfs "$sysfs" --once
 if ! is_watch_running; then
  rm -f "$pidfile" 2>/dev/null || true
  "$watch_bin" --helper "$0" --pidfile "$pidfile" --sysfs "$sysfs" >> "$log_target" 2>&1 </dev/null &
  i=0
  while [ "$i" -lt 20 ]; do
   is_watch_running && break
   sleep 0.1
   i=$((i + 1))
  done
  is_watch_running || { echo 'Lower USB watcher failed to start' >&2; exit 1; }
 fi
}

cmd=${1:-status}
save_flag=
case "$cmd" in
 status)
  print_status
  exit 0
  ;;
 apply-role)
  target=${2:-}
  case "$target" in
   adb|host) ;;
   *) echo 'usage: spx-lower-usb apply-role adb|host' >&2; exit 2 ;;
  esac
  acquire_lock
  if [ "$target" = adb ]; then
   apply_adb
  else
   apply_host
  fi
  release_lock
  echo "LOWER_USB_ROLE=$target"
  exit 0
  ;;
 boot)
  mode=$(read_saved_mode)
  case "$mode" in
   auto|adb|host) ;;
   *) echo 'Invalid saved lower USB mode' >&2; exit 2 ;;
  esac
  ;;
 auto|adb|host)
  mode=$cmd
  save_flag=${2:-}
  if [ -n "$save_flag" ] && [ "$save_flag" != --save ]; then
   echo 'usage: spx-lower-usb auto|adb|host|status|boot [--save]' >&2
   exit 2
  fi
  ;;
 *)
  echo 'usage: spx-lower-usb auto|adb|host|status|boot [--save]' >&2
  exit 2
  ;;
esac

test -e "$role"
acquire_lock
if [ "$mode" = host ]; then
 stop_watcher
 set_auto_dp 0
 if [ "$cmd" != boot ] || [ "$(cat "$role")" != host ]; then
  apply_host
 fi
elif [ "$mode" = adb ]; then
 stop_watcher
 set_auto_dp 0
 apply_adb
else
 if is_boot_storage_locked; then
  stop_watcher
  set_auto_dp 0
  if [ "$(cat "$role")" != host ]; then
   apply_host
  fi
 else
  set_auto_dp 1
 fi
fi

if [ "$mode" != auto ] || is_boot_storage_locked; then
 if [ "$save_flag" = --save ]; then
  save_mode_file "$mode"
 fi
fi
release_lock

if [ "$mode" = auto ] && ! is_boot_storage_locked; then
 start_watcher
 if [ "$save_flag" = --save ]; then
  acquire_lock
  save_mode_file "$mode"
  release_lock
 fi
fi

echo "LOWER_USB_MODE=$mode"
print_status
