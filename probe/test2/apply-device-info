#!/bin/busybox sh
# Before Android init loads read-only properties. Keep mica/desktop dispatch IDs.
set -eu
root=${1:-/newroot}
mkdir -p "$root/debug_ramdisk/device-info"
for rel in system/build.prop system/etc/build.prop vendor/build.prop vendor/etc/build.prop product/etc/build.prop odm/etc/build.prop system_ext/etc/build.prop system_dlkm/etc/build.prop vendor_dlkm/etc/build.prop; do
    source="$root/$rel"
    [ -f "$source" ] || continue
    target="$root/debug_ramdisk/device-info/$(echo "$rel" | tr / _)"
    awk '
        /^ro\.product\.(.*\.)?model=/ {sub(/=.*/, "=Surface Pro X"); print; next}
        /^ro\.product\.(.*\.)?manufacturer=/ {sub(/=.*/, "=Microsoft"); print; next}
        /^ro\.product\.(.*\.)?brand=/ {sub(/=.*/, "=Microsoft"); print; next}
        /^ro\.soc\.model=/ {next}
        {print}
    ' "$source" > "$target"
    if [ "$rel" = vendor/build.prop ]; then
        printf '\n# Physical SQ2 SoC, used by Diagnostics HardwareInfoProvider.\nro.soc.model=Microsoft SQ2\n' >> "$target"
    fi
    chmod 644 "$target"
    mount --bind "$target" "$source"
done
grep -qx 'ro.soc.model=Microsoft SQ2' "$root/vendor/build.prop"
grep -qx 'ro.product.product.model=Surface Pro X' "$root/product/etc/build.prop"
echo 'SQ2_DEVICE_INFO: Microsoft Surface Pro X / Microsoft SQ2'
