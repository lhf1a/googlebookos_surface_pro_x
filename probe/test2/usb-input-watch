#!/bin/busybox sh
# Publish USB evdev nodes only after permissions and Android labels are ready.
# The devtmpfs IN_CREATE race is the same as the Surface cover/UHID race.
# Never grab input, synthesize events, or change cover/touch/Bluetooth devices.
set -u
export PATH=/bin:/sbin
case " $(cat /proc/cmdline) " in *' sq2.rescue=1 '*|*' sq2.usb=0 '*) exit 0;; esac
cache=/run/sq2-usb-input
mkdir -p "$cache"
if [ "${1:-}" != --once ]; then
    if [ -r "$cache/pid" ] && kill -0 "$(cat "$cache/pid")" 2>/dev/null; then exit 0; fi
    echo $$ > "$cache/pid"
fi
stage=$(mktemp -d /dev/sq2-usb-refresh.XXXXXX) || exit 1
trap 'rm -f "$stage"/event*; rmdir "$stage" 2>/dev/null || true' EXIT
while true; do
    # PID 1 is Android init after handoff; do not publish before EventHub starts.
    ready=$(nsenter -t 1 -m -r -- /system/bin/getprop sys.boot_completed 2>/dev/null)
    if [ "$ready" != 1 ]; then
        [ "${1:-}" = --once ] && exit 1
        sleep 2
        continue
    fi
    for d in /sys/class/input/event*; do
        [ "$(cat "$d/device/id/bustype" 2>/dev/null)" = 0003 ] || continue
        name=$(cat "$d/device/name" 2>/dev/null) || continue
        sysfs=$(readlink -f "$d/device") || continue
        case "$sysfs" in */usb[0-9]*/*/input/input*) ;; *) continue;; esac
        numbers=$(cat "$d/dev" 2>/dev/null) || continue
        major=${numbers%:*}; minor=${numbers#*:}
        [ "$major" = 13 ] || continue
        event=$(basename "$d")
        identity=$sysfs:$numbers
        [ "$(cat "$cache/$event" 2>/dev/null)" = "$identity" ] && continue
        mknod -m 660 "$stage/$event" c "$major" "$minor" || continue
        if ! chown 0:1004 "$stage/$event" ||
           ! nsenter -t 1 -m -r -- /system/bin/chcon u:object_r:input_device:s0 "$stage/$event"; then
            rm "$stage/$event"
            continue
        fi
        # eventN can be recycled during enumeration. Check identity again.
        if [ "$(readlink -f "$d/device")" != "$sysfs" ] ||
           [ "$(cat "$d/dev" 2>/dev/null)" != "$numbers" ]; then
            rm "$stage/$event"
            continue
        fi
        rm -f "/dev/input/$event"
        if ln "$stage/$event" "/dev/input/$event"; then
            rm "$stage/$event"
            printf '%s\n' "$identity" > "$cache/$event"
            echo "USB_INPUT_REPUBLISHED=$event $name"
        else
            mv "$stage/$event" "/dev/input/$event"
            echo "USB_INPUT_RESTORE_FALLBACK=$event"
        fi
    done
    [ "${1:-}" = --once ] && exit 0
    sleep 1
done
