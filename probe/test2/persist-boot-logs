#!/bin/busybox sh
# Explicit diagnostic build: bounded by the caller's 30-minute timeout.
# Never blocks PID 1; only the selected boot ESP is a persistence target.
set -eu
export PATH=/bin:/sbin
read -r token < /run/spx-boot-source-token
grep -qx "$token" /media/esp/SPX-BOOT-SOURCE.txt
read -r boot < /proc/sys/kernel/random/boot_id
case "$boot" in ''|*[!0-9a-f-]*) exit 1;; esac
[ "${#boot}" = 36 ]
mkdir /run/spx-log-persist-lock 2>/dev/null || exit 0
trap 'rmdir /run/spx-log-persist-lock 2>/dev/null || true' EXIT
trap 'exit 0' HUP INT TERM
scratch=/run/spx-log-persist
dest=/media/esp/SPX-BOOT-LOGS/$boot
mkdir -p "$scratch" "$dest"
printf 'boot_id=%s\nboot_disk=%s\nboot_token=%s\n' "$boot" "$(cat /run/sq2-ssd-device)" "$token" > "$scratch/boot.txt"

persist() {
    name=$1
    # Limit each snapshot, not the boot/product. Large block writes avoid
    # thousands of small synchronous FAT writes during first boot.
    tail -c 262144 "$scratch/$name" > "$scratch/limited"
    dd if="$scratch/limited" of="$dest/$name.new" bs=262144 count=1 conv=fsync 2>/dev/null || return 1
    mv "$dest/$name.new" "$dest/$name"
}
capture() {
    name=$1;shift
    rc=0
    "$@" > "$scratch/$name" 2>&1 || rc=$?
    printf '\nCOLLECT_EXIT=%s\n' "$rc" >> "$scratch/$name"
    persist "$name"
}
persist boot.txt
echo "BOOT_LOG_PERSISTENCE=$dest"
while :; do
    # Leave space for future EFI boot-source markers and image metadata.
    free=$(df -Pk /media/esp | awk 'NR==2 {print $4}')
    case "$free" in ''|*[!0-9]*) exit 1;; esac
    [ "$free" -ge 65536 ] || { echo BOOT_LOG_STOP_LOW_ESP_SPACE; exit 0; }
    for name in status.txt hardware-discovery.txt touch-service.txt iptsd.txt touch-report-descriptor.bin gscd-availability.txt first-boot.txt user0-home.txt surface-swap-boot.txt userdata-grow.txt spx-typec.txt gpu-native-startup.txt module-load.txt storage-ready-stage.txt touch-calibration-boot.txt; do
        [ -f "/logs/$name" ] || continue
        tag=$(stat -c '%Y:%s' "/logs/$name")
        if [ -f "$scratch/$name.tag" ] && [ "$(cat "$scratch/$name.tag")" = "$tag" ]; then continue; fi
        tail -c 262144 "/logs/$name" > "$scratch/$name"
        persist "$name"
        printf '%s\n' "$tag" > "$scratch/$name.tag"
    done
    capture dmesg.txt dmesg
    if [ ! -f "$dest/dmesg-first.txt" ]; then
        cp "$scratch/dmesg.txt" "$scratch/dmesg-first.txt";persist dmesg-first.txt
    fi
    if [ -x /proc/1/root/system/bin/logcat ]; then
        capture logcat.txt timeout 5 nsenter -t 1 -m -r -- /system/bin/logcat -b all -d -t 1500 -v threadtime
        if [ ! -f "$dest/logcat-first.txt" ]; then
            cp "$scratch/logcat.txt" "$scratch/logcat-first.txt";persist logcat-first.txt
        fi
        capture android-state.txt timeout 5 nsenter -t 1 -m -r -- /system/bin/sh -c '
            echo BOOT_COMPLETED; getprop sys.boot_completed
            echo BOOTANIM; getprop init.svc.bootanim
            echo CURRENT_USER; am get-current-user
            echo PROVISIONED; settings get global device_provisioned
            echo SETUP_COMPLETE; settings --user 0 get secure user_setup_complete
            echo HOME; cmd package resolve-activity --brief --user 0 -a android.intent.action.MAIN -c android.intent.category.HOME
        '
        capture activity.txt timeout 5 nsenter -t 1 -m -r -- /system/bin/dumpsys activity activities
        capture window.txt timeout 5 nsenter -t 1 -m -r -- /system/bin/dumpsys window windows
    fi
    read -r uptime unused < /proc/uptime
    printf 'snapshot_uptime=%s\n' "$uptime" > "$scratch/last-snapshot.txt"
    persist last-snapshot.txt
    # The very first snapshot is immediate; subsequent snapshots are periodic.
    sleep 15
done
