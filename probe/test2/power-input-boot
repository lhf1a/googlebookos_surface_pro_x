#!/bin/busybox sh
set -eu
export PATH=/bin:/sbin
if [ -x /bin/touch-resume-watch ]; then
    /bin/touch-resume-watch > /logs/touch-resume.txt 2>&1 &
fi
for module in surface_aggregator_tabletsw gpio_keys pm8941-pwrkey; do
    insmod "/etc/sq2-power/$module.ko"
done
# Keep the SSAM driver default (wakeup=disabled): Surface EC pulls the wakeup
# GPIO high for any queued telemetry event (battery/thermal), causing 0.43s
# s2idle bounce loops. Independent pm8941_pwrkey (PDC 1) and gpio-keys-lid
# remain wakeup-enabled for reliable power-button and cover-open resume.
for n in $(seq 1 120); do
    if [ "$(timeout 3 nsenter -t 1 -m -r -- /system/bin/getprop sys.boot_completed 2>/dev/null || true)" = 1 ]; then
        /bin/refresh-sq2-power-input-nodes
        /bin/cover-input-watch > /logs/cover-input-watch.txt 2>&1 &
        # Reapply raw-touch mode after Android has enumerated physical inputs.
        sleep 5
        /bin/touch-framework-ready
        echo SQ2_COVER_AND_POWER_INPUT_READY
        exit 0
    fi
    sleep 1
done
exit 1
