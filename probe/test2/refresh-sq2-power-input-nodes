#!/bin/busybox sh
# devtmpfs nodes may be visible before Android's input group can open them.
# Publish already-permissioned nodes with IN_CREATE, which EventHub watches.
# Only the SQ2 cover switch and physical power/volume button nodes are republished.
set -eu
export PATH=/bin:/sbin
stage=$(mktemp -d /dev/sq2-input-refresh.XXXXXX)
trap 'rmdir "$stage" 2>/dev/null || true' EXIT
for d in /sys/class/input/event*; do
    name=$(cat "$d/device/name")
    case "$name" in 'Microsoft Surface KIP Tablet Mode Switch'|'Volume Buttons'|'pm8941_pwrkey') ;; *) continue;; esac
    event=$(basename "$d")
    numbers=$(cat "$d/dev")
    major=${numbers%:*}
    minor=${numbers#*:}
    [ "$major" = 13 ]
    mknod -m 660 "$stage/$event" c "$major" "$minor"
    chown 0:1004 "$stage/$event"
    rm "/dev/input/$event"
    if ! ln "$stage/$event" "/dev/input/$event"; then
        mv "$stage/$event" "/dev/input/$event"
        echo "NODE_RESTORE_FALLBACK=$event"
        exit 1
    fi
    rm "$stage/$event"
    echo "REFRESHED=$event $name"
done
