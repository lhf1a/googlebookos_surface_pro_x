#!/bin/busybox sh
# Explicit SQ1 whole-FS1/FS2 compatibility trial, NOT calibration-only migration.
# Only stages RAM before RMTFS opens it; no modem mode or persistent NV writes.
set -eu
export PATH=/bin:/sbin
arm=/media/esp/EFI/SQ2LTE/fs12-seed.ARM
[ -f "$arm" ] || exit 0
case " $(cat /proc/cmdline) " in
 *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 0;;
 *' sq2.el2=1 '*) ;;
 *) echo 'LTE_FS12_REFUSED: not normal EL2'; exit 1;;
esac
case " $(cat /proc/cmdline) " in *' nohibernate '*) ;; *) exit 1;; esac
[ "$(tr -d '\000' < /proc/device-tree/model)" = 'Microsoft Surface Pro X (SQ2)' ] || exit 1
unit=$(cat /etc/sq2-lte/unit-serial)
actual=$(cat /sys/block/nvme0n1/device/serial | tr -d ' \r\n')
[ -n "$unit" ] && [ "$actual" = "$unit" ] || { echo 'LTE_FS12_REFUSED: unit mismatch'; exit 1; }
grep -qxF SQ2-INTERNAL-512-20261027 /media/esp/SQ2-SSD-ID.txt || exit 1
awk '$2=="/run" && $3=="tmpfs" {ok=1} END {exit !ok}' /proc/mounts || exit 1
[ -z "$(pidof rmtfs 2>/dev/null || true)" ] || { echo 'LTE_FS12_REFUSED: RMTFS already active'; exit 1; }
[ ! -e "$arm.used" ] || { echo 'LTE_FS12_REFUSED: prior request exists'; exit 1; }
[ "$(cat "$arm")" = SQ1_FS12_RAM_ONCE_V1 ] || exit 1
# Consume durably before any candidate use. A subsequent boot remains baseline.
mv "$arm" "$arm.used"
sync
for f in modem_fs1 modem_fs2; do
 [ "$(wc -c < "/etc/sq2-lte/$f.bin")" = 2097152 ] || exit 1
 [ -f "/run/rmtfs/$f" ] && [ "$(wc -c < "/run/rmtfs/$f")" = 2097152 ] || exit 1
done
( cd /etc/sq2-lte; sha256sum -c FS12.sha256 ) || exit 1
stage=/run/rmtfs-fs12-stage
backup=/run/rmtfs-fs12-original
[ ! -e "$stage" ] && [ ! -e "$backup" ] || exit 1
mkdir -m 700 "$stage"
cp -a /run/rmtfs/. "$stage/"
for f in modem_fs1 modem_fs2; do
 cp "/etc/sq2-lte/$f.bin" "$stage/$f"
 chmod 600 "$stage/$f"
 cmp "/etc/sq2-lte/$f.bin" "$stage/$f"
done
# Preserve every other RAM input, including the original zero FSG.
for f in /run/rmtfs/*; do
 case "$f" in */modem_fs1|*/modem_fs2) continue;; esac
 cmp "$f" "$stage/${f##*/}"
done
mv /run/rmtfs "$backup"
if ! mv "$stage" /run/rmtfs; then
 mv "$backup" /run/rmtfs
 echo 'LTE_FS12_REFUSED: RAM directory exchange failed; original restored'
 exit 1
fi
echo 'LTE_FS12_SEEDED: SQ1 whole FS1/FS2 in RAM once; FSG unchanged; existing rmtfs -r shadow writes only'
