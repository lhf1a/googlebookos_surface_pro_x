#!/bin/busybox sh
# Stage the native Radio service before Android init.
set -eu
case " $(cat /proc/cmdline) " in *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 0;; esac
grep -q '^overlay /newroot/vendor overlay ' /proc/mounts
src=/etc/sq2-radio
(cd "$src"; sha256sum -c SHA256SUMS >/dev/null)
target=/newroot/vendor
test ! -e "$target/etc/vintf/manifest/sq2-radio.xml"
for name in sq2-radio sq2-qmi-data sq2-qmi-mode; do
    test ! -e "$target/bin/$name"
    cp "$src/$name" "$target/bin/$name"
    chmod 755 "$target/bin/$name"
done
cp "$src/sq2-radio.rc" "$target/etc/init/sq2-radio.rc"
cp "$src/sq2-radio-features.xml" "$target/etc/permissions/sq2-radio-features.xml"
cp "$src/sq2-radio-overlay.apk" "$target/overlay/sq2-radio-overlay.apk"
chmod 644 "$target/etc/init/sq2-radio.rc" "$target/etc/permissions/sq2-radio-features.xml" "$target/overlay/sq2-radio-overlay.apk"
# The donor's optional noRil SKU must not veto the capabilities declared here.
excluded=$target/etc/permissions/noRil/apq_excluded_telephony_features.xml
if test -f "$excluded"; then
    sed -i '/name="android.hardware.telephony"/d; /name="android.hardware.telephony.gsm"/d; /name="android.hardware.telephony.data"/d; /name="android.hardware.telephony.subscription"/d; /name="android.hardware.telephony.radio.access"/d' "$excluded"
fi
mkdir -p /newroot/debug_ramdisk/sq2-radio-props
for rel in system/build.prop system/etc/build.prop vendor/build.prop vendor/etc/build.prop product/etc/build.prop odm/etc/build.prop system_ext/etc/build.prop; do
    source=/newroot/$rel
    test -f "$source" || continue
    copy=/newroot/debug_ramdisk/sq2-radio-props/$(echo "$rel" | tr / _)
    sed '/^ro.telephony.sim_slots.count=/d; /^telephony.active_modems.max_count=/d; /^ro.radio.noril=/d; /^ro.vendor.radio.noril=/d; /^ro.telephony.default_network=/d' "$source" > "$copy"
    if test "$rel" = vendor/build.prop; then
        printf '\nro.telephony.sim_slots.count=1\ntelephony.active_modems.max_count=1\nro.radio.noril=false\nro.vendor.radio.noril=false\nro.telephony.default_network=11\n' >> "$copy"
    fi
    chmod 644 "$copy"
    mount --bind "$copy" "$source"
done
# Publish the declaration last. The LTE boot helper sees the same marker and
# prepares IPA/RMNET, then exits without starting its old NetworkAgent owner.
cp "$src/sq2-radio-manifest.xml" "$target/etc/vintf/manifest/sq2-radio.xml"
chmod 644 "$target/etc/vintf/manifest/sq2-radio.xml"
