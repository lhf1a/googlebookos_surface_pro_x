#!/bin/busybox sh
# Starts after full Android; no DIAG, KVM witness, UI, or modem reset.
set -eu
export PATH=/bin:/sbin
case " $(cat /proc/cmdline) " in *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 0;; esac
test -f /run/lte-unit-seeded || exit 0
test "$(cat /sys/module/suspend/parameters/screen_only)" = Y
mkdir /run/sq2-lte.lock || exit 0
android(){ nsenter -t 1 -m -r -- /system/bin/"$@"; }
android_env(){
 zygote=
 for pid in $(android pidof zygote64); do
  if [ "$(awk '/^PPid:/ {print $2}' /proc/$pid/status)" = 1 ]; then zygote=$pid;break;fi
 done
 test -n "$zygote"
 for entry in $(tr '\000' '\n' < /proc/$zygote/environ | grep -E '^(BOOTCLASSPATH|DEX2OATBOOTCLASSPATH|ANDROID_ROOT|ANDROID_DATA|ANDROID_ART_ROOT|ANDROID_I18N_ROOT|ANDROID_TZDATA_ROOT)=');do export "$entry";done
}
for i in $(seq 1 240); do
 [ "$(android getprop sys.boot_completed 2>/dev/null)" = 1 ] && break
 sleep 1
done
test "$(android getprop sys.boot_completed)" = 1
src=/etc/sq2-lte
(cd "$src"; sha256sum -c runtime.sha256 >/dev/null)
test ! -d /sys/module/ipa_sq2_lab
grep -q '9b000000-9b05ffff : reserved' /proc/iomem
# The kernel resolves firmware in init's mount namespace. This helper retains
# its original initramfs root; expose that exact immutable bundle via proc.
path=/sys/module/firmware_class/parameters/path
old=$(cat "$path")
restore_path(){ if test -n "$old";then printf '%s' "$old" > "$path";else printf '\000' > "$path";fi; }
trap restore_path EXIT HUP INT TERM
printf '%s' "/proc/$$/root$src/firmware" > "$path"
timeout 45 insmod "$src/ipa_sq2_lab.ko" sq2_lab_mode=2
restore_path
trap - EXIT HUP INT TERM
for i in $(seq 1 30);do test -d /sys/class/net/rmnet_ipa0 && break;sleep 1;done
test "$(cat /sys/class/net/rmnet_ipa0/device/modem/tx_endpoint_id)" = 2
test "$(cat /sys/class/net/rmnet_ipa0/device/modem/rx_endpoint_id)" = 11
test "$(cat /sys/class/net/rmnet_ipa0/device/feature/tx_offload)" = MAPv4
insmod "$src/rmnet.ko"
"$src/sq2-rmnet-create" create
ip link set rmnet_ipa0 up
ip link set rmnet_data0 up
# Radio HAL is the sole bearer owner; Android telephony creates NetworkAgent.
mkdir -p -m 700 /dev/sq2-lte
touch /dev/sq2-lte/radio-data-ready
# Merge the resource checksum without replacing user edits/deletions.
android_env
android content delete --uri content://telephony/carriers/update_db >/dev/null
