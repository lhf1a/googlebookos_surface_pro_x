#!/bin/busybox sh
# Generic runtime: consume only this device's EFI-collected cache, in RAM.
set -eu
export PATH=/bin:/sbin
case " $(cat /proc/cmdline) " in
 *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 0;;
 *' sq2.el2=1 '*) ;;
 *) exit 0;;
esac
case " $(cat /proc/cmdline) " in *' nohibernate '*) ;; *) exit 1;; esac
awk '$2=="/run" && $3=="tmpfs" {ok=1} END {exit !ok}' /proc/mounts
test -z "$(pidof rmtfs 2>/dev/null || true)"
uuid=$(tr 'A-F' 'a-f' < /sys/class/dmi/id/product_uuid)
case "$uuid" in *[!0-9a-f-]*|'') echo 'LTE_FSG_UUID_UNAVAILABLE' >&2; exit 1;; esac
cache="/media/esp/EFI/SPX/LTE/$uuid.bin"
rm -f /run/rmtfs/modem_fsg.lte-new
sq2-fsg-cache "$cache" "$uuid" /run/rmtfs/modem_fsg.lte-new
chmod 600 /run/rmtfs/modem_fsg.lte-new
mv /run/rmtfs/modem_fsg.lte-new /run/rmtfs/modem_fsg
touch /run/lte-unit-seeded
