#!/bin/busybox sh
# Operator-supplied shared FSG in RAM only. Standard public images omit this data.
set -eu
export PATH=/bin:/sbin
case " $(cat /proc/cmdline) " in
 *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 0;;
 *' sq2.el2=1 '*) ;;
 *) exit 0;;
esac
test "$(cat /sys/module/suspend/parameters/screen_only)" = Y
case " $(cat /proc/cmdline) " in *' nohibernate '*) ;; *) exit 1;; esac
case "$(tr -d '\000' < /proc/device-tree/model)" in
 'Microsoft Surface Pro X (SQ1)'|'Microsoft Surface Pro X (SQ2)') ;;
 *) exit 1;;
esac
awk '$2=="/run" && $3=="tmpfs" {ok=1} END {exit !ok}' /proc/mounts
test -z "$(pidof rmtfs 2>/dev/null || true)"
(cd /etc/sq2-lte; sha256sum -c FSG.sha256)
test "$(wc -c < /etc/sq2-lte/modem_fsg.bin)" = 2097152
test "$(wc -c < /run/rmtfs/modem_fsg)" = 2097152
cp /etc/sq2-lte/modem_fsg.bin /run/rmtfs/modem_fsg.lte-new
cmp /etc/sq2-lte/modem_fsg.bin /run/rmtfs/modem_fsg.lte-new
chmod 600 /run/rmtfs/modem_fsg.lte-new
mv /run/rmtfs/modem_fsg.lte-new /run/rmtfs/modem_fsg
touch /run/lte-unit-seeded
echo LTE_UNIT_FSG_READY
