#!/bin/busybox sh
# Read-only activation guard for the shared SQ1/SQ2 runtime. User-authorized shared LTE configuration, RAM only.
set -eu
export PATH=/bin:/sbin
case " $(cat /proc/cmdline) " in
 *' sq2.rescue=1 '*|*' sq2.lte=0 '*) exit 1;;
 *' sq2.el2=1 '*) ;;
 *) exit 1;;
esac
case " $(cat /proc/cmdline) " in *' nohibernate '*) ;; *) exit 1;; esac
case "$(tr -d '\000' < /proc/device-tree/model)" in
 'Microsoft Surface Pro X (SQ1)'|'Microsoft Surface Pro X (SQ2)') ;;
 *) exit 1;;
esac
