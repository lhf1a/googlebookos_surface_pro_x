+// Validate both planes before ColorConverter sees codec-controlled geometry.
+static bool validP010Buffer(const sp<AMessage>& format, size_t size) {
+    int32_t width, height, stride, left, top, right, bottom;
+    if (!format->findInt32("width", &width)
+            || !format->findInt32("slice-height", &height)
+            || !format->findInt32("stride", &stride)
+            || width <= 0 || height <= 0 || stride <= 0 || (stride & 3)
+            || width > stride / 2) {
+        return false;
+    }
+    if (!format->findRect("crop", &left, &top, &right, &bottom)) {
+        left = top = 0;
+        right = width - 1;
+        bottom = height - 1;
+    }
+    return left >= 0 && !(left & 1) && top >= 0
+            && right >= left && right < width && bottom >= top && bottom < height
+            && size / static_cast<size_t>(stride)
+                    >= static_cast<size_t>(height) + (static_cast<size_t>(height) + 1) / 2;
+}
