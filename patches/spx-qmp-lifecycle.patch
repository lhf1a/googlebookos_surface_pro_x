+/* Type-C callbacks are not PHY consumers: take a temporary runtime
+ * reference before touching clocks, without altering consumer init counts. */
+static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
+                                    enum typec_orientation orientation)
+{
+ struct qmp_combo *qmp = typec_switch_get_drvdata(sw);
+ int ret = pm_runtime_resume_and_get(qmp->dev);
+ if (ret < 0) return ret;
+ ret = qmp_combo_typec_switch_set_active(sw, orientation);
+ pm_runtime_put(qmp->dev);
+ return ret;
+}
+
+static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux,
+                                 struct typec_mux_state *state)
+{
+ struct qmp_combo *qmp = typec_mux_get_drvdata(mux);
+ int ret = pm_runtime_resume_and_get(qmp->dev);
+ if (ret < 0) return ret;
+ ret = qmp_combo_typec_mux_set_active(mux, state);
+ pm_runtime_put(qmp->dev);
+ return ret;
+}
