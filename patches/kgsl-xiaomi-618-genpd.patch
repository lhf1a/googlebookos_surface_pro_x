+static int a6xx_gmu_power_probe(struct adreno_device *adreno_dev)
+{
+	struct a6xx_gmu_device *gmu = to_a6xx_gmu(adreno_dev);
+	struct device *dev = &gmu->pdev->dev;
+	struct device *cx, *gx;
+
+	if (!adreno_is_a680(adreno_dev))
+		return a6xx_gmu_regulators_probe(gmu, gmu->pdev);
+	if (!of_device_is_compatible(dev->of_node, "qcom,adreno-gmu"))
+		return -EOPNOTSUPP;
+	cx = dev_pm_domain_attach_by_name(dev, "cx");
+	if (IS_ERR_OR_NULL(cx))
+		return cx ? PTR_ERR(cx) : -ENODEV;
+	gx = dev_pm_domain_attach_by_name(dev, "gx");
+	if (IS_ERR_OR_NULL(gx)) {
+		dev_pm_domain_detach(cx, false);
+		return gx ? PTR_ERR(gx) : -ENODEV;
+	}
+	gmu->cxpd = cx;
+	gmu->gxpd = gx;
+	gmu->native_domains = true;
+	return 0;
+}
