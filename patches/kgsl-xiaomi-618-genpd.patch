+/* Callers serialize power transitions with the KGSL device mutex. */
+static int a6xx_gmu_domain_put(struct device *pd, bool *held)
+{
+	bool on;
+	int ret;
+
+	if (IS_ERR_OR_NULL(pd))
+		return pd ? PTR_ERR(pd) : -ENODEV;
+	if (!*held)
+		return 0;
+	/* Votable CX otherwise skips the GPUCC hardware-off poll. */
+	dev_pm_genpd_synced_poweroff(pd);
+	/* put_sync_suspend drops usage even when suspend fails. */
+	ret = pm_runtime_put_sync_suspend(pd);
+	*held = false;
+	if (ret < 0)
+		return ret;
+	/* genpd_runtime_suspend alone does not report provider power-off errors. */
+	return read_poll_timeout(dev_pm_genpd_is_on, on, !on, 100, 5000000,
+		false, pd);
+}
+
+int a6xx_gmu_disable_clks(struct adreno_device *adreno_dev)
+{
+	struct a6xx_gmu_device *gmu = to_a6xx_gmu(adreno_dev);
+	int ret;
+
+	if (gmu->native_domains) {
+		ret = a6xx_gmu_domain_put(gmu->gxpd, &gmu->gx_held);
+		if (ret)
+			goto fail;
+		if (gmu->clks_on && a6xx_gmu_gx_is_on(KGSL_DEVICE(adreno_dev))) {
+			ret = -ETIMEDOUT;
+			goto fail;
+		}
+	}
+	if (gmu->clks_on) {
+		clk_bulk_disable_unprepare(gmu->num_clks, gmu->clks);
+		gmu->clks_on = false;
+	}
+	return 0;
+fail:
+	if (!gmu->power_error)
+		gmu->power_error = ret;
+	return ret;
+}
+
+int a6xx_gmu_disable_cx(struct adreno_device *adreno_dev)
+{
+	struct a6xx_gmu_device *gmu = to_a6xx_gmu(adreno_dev);
+	int ret;
+
+	if (gmu->clks_on)
+		ret = -EBUSY;
+	else if (gmu->native_domains) {
+		/* A failed clock enable still owns the GX bookkeeping reference. */
+		ret = a6xx_gmu_domain_put(gmu->gxpd, &gmu->gx_held);
+		if (!ret)
+			ret = a6xx_gmu_domain_put(gmu->cxpd, &gmu->cx_held);
+	} else
+		ret = a6xx_cx_regulator_disable_wait(gmu->cx_gdsc,
+			KGSL_DEVICE(adreno_dev), 5000);
+	if (ret && !gmu->power_error)
+		gmu->power_error = ret;
+	return ret;
+}
