+int a6xx_gmu_map_sg(struct a6xx_gmu_device *gmu, u32 addr,
+	struct sg_table *sgt, u32 size, int attrs)
+{
+	struct scatterlist *sg;
+	u64 total = 0;
+	unsigned int i;
+	ssize_t mapped;
+
+	if (!gmu->domain || IS_ERR_OR_NULL(sgt) || !sgt->sgl ||
+		!sgt->orig_nents || !size || !IS_ALIGNED(addr, PAGE_SIZE) ||
+		!IS_ALIGNED(size, PAGE_SIZE) || (u64)addr + size > U32_MAX)
+		return -EINVAL;
+
+	for_each_sg(sgt->sgl, sg, sgt->orig_nents, i) {
+		if (!sg->length || !IS_ALIGNED(sg_phys(sg), PAGE_SIZE) ||
+			!IS_ALIGNED(sg->length, PAGE_SIZE) || sg_dma_is_bus_address(sg))
+			return -EINVAL;
+		total += sg->length;
+		if (total > size)
+			return -EINVAL;
+	}
+	if (total != size)
+		return -EINVAL;
+
+	mapped = iommu_map_sg(gmu->domain, addr, sgt->sgl, sgt->orig_nents,
+		attrs, GFP_KERNEL);
+	/* The 6.18 core already unwinds a negative return. */
+	if (mapped < 0)
+		return mapped;
+	if (mapped != size) {
+		if (mapped)
+			iommu_unmap(gmu->domain, addr, mapped);
+		return -EIO;
+	}
+	return 0;
+}
