+#ifndef _ARM_SMMU_PRIV_H
+#define _ARM_SMMU_PRIV_H
+
+struct iommu_domain;
+
+/*
+ * Invalidate and drain an attached AArch64 stage-1 domain, with real PM and
+ * synchronization errors. Does not stop devices, detach or change roots.
+ * Caller serializes map/unmap/teardown and retains backing on any error.
+ * Unsupported providers return -EOPNOTSUPP, never a successful no-op.
