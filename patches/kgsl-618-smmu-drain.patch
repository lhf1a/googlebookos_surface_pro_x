+/* The caller keeps the domain attached and excludes mapping/teardown races. */
+int arm_smmu_flush_tlb_checked(struct iommu_domain *domain)
+{
+	struct arm_smmu_domain *smmu_domain;
+	struct arm_smmu_device *smmu;
+	struct arm_smmu_cfg *cfg;
+	unsigned long flags;
+	int ret = -ENODEV;
+
+	if (!domain || domain->owner != &arm_smmu_ops)
+		return -EOPNOTSUPP;
+
+	smmu_domain = to_smmu_domain(domain);
+	mutex_lock(&smmu_domain->init_mutex);
+	smmu = smmu_domain->smmu;
+	cfg = &smmu_domain->cfg;
+	if (!smmu || !smmu_domain->pgtbl_ops)
+		goto unlock;
+
+	ret = -EOPNOTSUPP;
+	if (smmu_domain->stage != ARM_SMMU_DOMAIN_S1 ||
+	    cfg->fmt != ARM_SMMU_CTX_FMT_AARCH64 ||
+	    cfg->cbndx >= smmu->num_context_banks ||
+	    smmu->cbs[cfg->cbndx].cfg != cfg ||
+	    !smmu->impl || !smmu->impl->tlb_sync_checked)
+		goto unlock;
+
+	ret = arm_smmu_rpm_get(smmu);
+	if (ret < 0)
+		goto unlock;
+
+	spin_lock_irqsave(&smmu_domain->cb_lock, flags);
+	wmb();
+	arm_smmu_cb_write(smmu, cfg->cbndx, ARM_SMMU_CB_S1_TLBIASID,
+			  cfg->asid);
+	ret = smmu->impl->tlb_sync_checked(smmu,
+			ARM_SMMU_CB(smmu, cfg->cbndx),
+			ARM_SMMU_CB_TLBSYNC, ARM_SMMU_CB_TLBSTATUS);
+	spin_unlock_irqrestore(&smmu_domain->cb_lock, flags);
+	arm_smmu_rpm_put(smmu);
+unlock:
+	mutex_unlock(&smmu_domain->init_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(arm_smmu_flush_tlb_checked);
+
