 int HWCBufferAllocator::FreeBuffer(BufferInfo *buffer_info) {
   if (!buffer_info || !buffer_info->private_data || !mapper_) return -EINVAL;
   auto handle = static_cast<buffer_handle_t>(buffer_info->private_data);
+  DLOGI("DPU_ALLOCATOR phase=mapper_free enter handle=%p", handle);
   int err = MapperError(mapper_->v5.freeBuffer(handle));
+  DLOGI("DPU_ALLOCATOR phase=mapper_free exit result=%d", err);
   if (err) return err;
   buffer_info->alloc_buffer_info = {};
   buffer_info->private_data = nullptr;
