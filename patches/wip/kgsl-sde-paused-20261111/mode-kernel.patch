+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SDE_MODE_STATE_H_
+#define _SDE_MODE_STATE_H_
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <linux/string.h>
+#include <drm/sde_mode_request.h>
+#include <drm/sde_mode_identity.h>
+struct drm_property_blob;
+/* One-shot requests/derived transitions are separate from stable selection.
+ * Payload references live in the matching bridge state, never in DRM modes.
+ */
+struct sde_mode_state {
+ u32 requested, mode_blob_id, adjusted;
+ u32 selected_blob_id, selected_panel;
+ struct sde_mode_identity identity, selected_identity;
+ struct drm_property_blob *request_blob;
+ bool requested_valid, adjusted_valid;
+};
+static inline void sde_mode_state_reset(struct sde_mode_state *state)
+{
+ memset(state, 0, sizeof(*state));
+}
+static inline void sde_mode_state_duplicate(struct sde_mode_state *dst,
+ const struct sde_mode_state *src)
+{
+ /* The raw driver state copier has not acquired a reference to request_blob.
+  * Clear that borrowed copy, do not put it; the old state retains ownership. */
+ sde_mode_state_reset(dst);
+ dst->selected_blob_id = src->selected_blob_id;
+ dst->selected_panel = src->selected_panel;
+ dst->selected_identity = src->selected_identity;
+}
+static inline int sde_mode_state_set_identity(struct sde_mode_state *state,
+ const struct sde_mode_request_v2 *request)
+{
+ u32 panels = request->request & (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND);
+ if (request->version != SDE_MODE_WIRE_VERSION || request->bytes != sizeof(*request) ||
+     request->reserved || (request->request & ~SDE_MODE_REQ_ALL) ||
+     panels == (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND))
+  return -EINVAL;
+ if (!request->mode_blob_id) {
+  if (request->request || request->identity.connector_id || request->identity.generation ||
+      request->identity.row_id) return -EINVAL;
+ } else if (!request->identity.connector_id ||
+            (!!request->identity.generation != !!request->identity.row_id) ||
+            (!request->identity.row_id && request->request)) {
+  return -EINVAL;
+ }
+ state->requested = request->request;
+ state->mode_blob_id = request->mode_blob_id;
+ state->identity = request->identity;
+ state->requested_valid = true;
+ state->adjusted = 0;
+ state->adjusted_valid = false;
+ return 0;
+}
+static inline int sde_mode_state_check(struct sde_mode_state *state, u32 mode_blob_id)
+{
+ if (!state->requested_valid) return -ENODATA;
+ if (state->mode_blob_id != mode_blob_id) return -EINVAL;
+ state->selected_blob_id = mode_blob_id;
+ state->selected_identity = state->identity;
+ if (!state->identity.row_id) state->selected_panel = SDE_MODE_PANEL_NONE;
+ return 0;
+}
