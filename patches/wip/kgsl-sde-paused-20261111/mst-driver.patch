+{
+ struct dp_mst_private *mst = container_of(mgr, struct dp_mst_private, mst_mgr);
+ struct sde_connector *conn = to_sde_connector(connector);
+ int i;
+ drm_modeset_lock_all(mst->dp_display->drm_dev);
+ /* Delayed destruction of an old port must not detach a newer binding. */
+ if (conn->mst_port == port) {
