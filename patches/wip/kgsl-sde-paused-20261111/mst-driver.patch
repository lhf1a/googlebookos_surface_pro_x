+static int dp_mst_add_payload(struct dp_mst_private *mst,
+ struct drm_dp_mst_topology_state *topology,
+ struct drm_dp_mst_atomic_payload *payload)
+{
+ if (!mst->simulator.mst_state)
+  return drm_dp_add_payload_part1(&mst->mst_mgr, topology, payload);
+ /* Protocol simulator: same local slot state, deliberately no AUX traffic. */
+ if (!mst->mst_mgr.payload_count)
+  mst->mst_mgr.next_start_slot = topology->start_slot;
+ payload->vc_start_slot = mst->mst_mgr.next_start_slot;
+ mst->mst_mgr.next_start_slot += payload->time_slots;
+ mst->mst_mgr.payload_count++;
+ payload->payload_allocation_status = DRM_DP_MST_PAYLOAD_ALLOCATION_DFP;
+ return 0;
+}
+static void dp_mst_remove_payload(struct dp_mst_private *mst,
+ struct drm_dp_mst_topology_state *topology,
+ struct drm_dp_mst_atomic_payload *payload)
+{
+ if (!mst->simulator.mst_state)
+  drm_dp_remove_payload_part1(&mst->mst_mgr, topology, payload);
+ else
+  payload->payload_allocation_status = DRM_DP_MST_PAYLOAD_ALLOCATION_LOCAL;
+}
+static int _dp_mst_bridge_pre_enable_part1(struct dp_mst_bridge *bridge,
+ struct drm_atomic_state *state)
+{
+ struct dp_mst_private *mst = bridge->display->dp_mst_prv_info;
+ struct drm_dp_mst_topology_state *topology =
+  drm_atomic_get_new_mst_topology_state(state, &mst->mst_mgr);
+ struct drm_dp_mst_atomic_payload *payload;
+ int ret;
+ if (!topology)
+  return -EINVAL;
+ payload = drm_atomic_get_mst_payload_state(topology, bridge->port);
+ if (!payload || payload->delete)
+  return -EINVAL;
+ {
+  struct dp_link_info link;
+  fixed20_12 divisor;
+  ret = mst->dp_display->get_mst_link_info(mst->dp_display, &link);
+  if (ret)
+   return ret;
+  divisor = drm_dp_get_vc_payload_bw(link.rate, link.num_lanes);
+  if (divisor.full != topology->pbn_div.full)
+   return -EAGAIN;
