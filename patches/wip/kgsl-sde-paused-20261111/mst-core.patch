+int drm_dp_atomic_release_port_payload(struct drm_atomic_state *state,
+ struct drm_dp_mst_topology_mgr *mgr, struct drm_dp_mst_port *port)
+{
+ struct drm_dp_mst_topology_state *topology;
+ struct drm_dp_mst_atomic_payload *payload;
+ struct drm_connector_state *old_conn;
+ topology = drm_atomic_get_mst_topology_state(state, mgr);
+ if (IS_ERR(topology))
+  return PTR_ERR(topology);
+ old_conn = drm_atomic_get_old_connector_state(state, port->connector);
+ if (!old_conn)
+  return -EINVAL;
+ if (old_conn->crtc)
+  topology->pending_crtc_mask |= drm_crtc_mask(old_conn->crtc);
+ payload = drm_atomic_get_mst_payload_state(topology, port);
+ if (!payload)
+  return 0;
+ if (!payload->delete) {
+  payload->pbn = 0;
+  payload->delete = true;
+  if (payload->vcpi)
+   topology->payload_mask &= ~BIT(payload->vcpi - 1);
+ }
+ return 0;
+}
+EXPORT_SYMBOL(drm_dp_atomic_release_port_payload);
+
 
