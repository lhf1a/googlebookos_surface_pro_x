++/* SPDX-License-Identifier: MIT */
++#ifndef _UAPI_SDE_MODE_REQUEST_H_
++#define _UAPI_SDE_MODE_REQUEST_H_
++/* SDE_MODE_REQUEST: upper32 MODE_ID blob id, lower32 request bits.
++ * The final atomic state validates the binding, independent of set order.
++ * This staging ABI requires matching userspace and a completed DSI consumer port.
++ */
++#define SDE_MODE_REQUEST_PROPERTY "SDE_MODE_REQUEST"
++#define SDE_MODE_REQ_SEAMLESS (1U << 0)
++#define SDE_MODE_REQ_VIDEO (1U << 1)
++#define SDE_MODE_REQ_COMMAND (1U << 2)
++#define SDE_MODE_REQ_ALL (SDE_MODE_REQ_SEAMLESS | SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND)
++#endif
+--- /dev/null
++++ b/sde-drm/sde_mode_request_adapter.h
+@@ -0,0 +1,27 @@
++/* SPDX-License-Identifier: MIT */
++#ifndef _SDE_MODE_REQUEST_ADAPTER_H_
++#define _SDE_MODE_REQUEST_ADAPTER_H_
++#include <errno.h>
++#include <stdint.h>
++#include "sde_mode_request.h"
++static inline int SDEPrepareModeRequest(const drmModeModeInfo *mode,
++ drmModeModeInfo *timing, uint32_t *request)
++{
++ if (!mode || !timing || !request)
++  return -EINVAL;
++ uint32_t flags = mode->flags;
++ /* Exact6.18 public timing bits plus aspect-ratio bits; legacy request bits
++  * are translated below, never re-used as public flags. */
++ if (flags & ~(0x007ff3ffU | (7U << 29)))
++  return -EINVAL;
++ uint32_t panel = flags & ((1U << 29) | (1U << 30));
++ if (panel == ((1U << 29) | (1U << 30)))
++  return -EINVAL;
++ *timing = *mode;
++ *request = ((flags & (1U << 31)) ? SDE_MODE_REQ_SEAMLESS : 0) |
++  ((flags & (1U << 29)) ? SDE_MODE_REQ_VIDEO : 0) |
++  ((flags & (1U << 30)) ? SDE_MODE_REQ_COMMAND : 0);
++ timing->flags &= ~((1U << 29) | (1U << 30) | (1U << 31));
++ return 0;
++}
++#endif
