-        if timeout 120 network-up > /logs/network-up.txt 2>&1; then
-            start-ssh
+        # Only the existing debug branch proactively takes bootstrap Wi-Fi.
+        # Nondebug success keeps Android's existing ownership policy unchanged.
+        diagnostic_attempt debug-common-drivers
+        if [ "$diagnostic_network_rc" = 0 ]; then
             keep-debug-route > /logs/debug-route.txt 2>&1 &
         fi
         touch-services > /logs/touch-startup.txt 2>&1
@@ -146,9 +180,7 @@
