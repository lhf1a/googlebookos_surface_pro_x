-    if timeout 120 network-up >> /logs/network-up-gpu-failure.txt 2>&1; then
-        start-ssh >> /logs/ssh-gpu-failure.txt 2>&1 || true
-    fi
+    diagnostic_attempt graphics-failure "$gpu_rc"
     sync
     while true; do sleep 3600; done
 fi
