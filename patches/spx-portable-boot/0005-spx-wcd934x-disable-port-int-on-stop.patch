+static void wcd934x_codec_disable_int_port(struct wcd_slim_codec_dai_data *dai,
+					   struct snd_soc_component *component)
+{
+	int port_num = 0;
+	unsigned short reg = 0;
+	unsigned short clr_reg = 0;
+	unsigned int val = 0;
+	struct wcd934x_codec *wcd = dev_get_drvdata(component->dev);
+	struct wcd934x_slim_ch *ch;
+
+	list_for_each_entry(ch, &dai->slim_ch_list, list) {
+		if (ch->port >= WCD934X_RX_START) {
+			port_num = ch->port - WCD934X_RX_START;
+			reg = WCD934X_SLIM_PGD_PORT_INT_EN0 + (port_num / 8);
+			clr_reg = WCD934X_SLIM_PGD_PORT_INT_CLR_RX_0 + (port_num / 8);
+		} else {
+			port_num = ch->port;
+			reg = WCD934X_SLIM_PGD_PORT_INT_TX_EN0 + (port_num / 8);
+			clr_reg = WCD934X_SLIM_PGD_PORT_INT_CLR_TX_0 + (port_num / 8);
+		}
+
+		regmap_read(wcd->if_regmap, reg, &val);
+		if (val & BIT(port_num % 8))
+			regmap_write(wcd->if_regmap, reg,
+				     val & ~BIT(port_num % 8));
+		regmap_write(wcd->if_regmap, clr_reg, BIT(port_num % 8));
+	}
+}
