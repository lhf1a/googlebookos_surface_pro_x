+/* Some firmware leaves the internal panel scanning out. Do not introduce
+ * an un-timed low pulse while acquiring its enable GPIO. This is a board
+ * handoff property, not a panel-ID or CPU-model quirk. Normal runtime power
+ * control in suspend/prepare remains unchanged.
+ */
+static int panel_edp_acquire_enable(struct device *dev, struct panel_edp *panel)
+{
+	bool preserve = of_property_read_bool(dev->of_node,
+					     "microsoft,preserve-boot-panel-power");
+	int value;
+
+	panel->enable_gpio = devm_gpiod_get_optional(dev, "enable",
+					 preserve ? GPIOD_ASIS : GPIOD_OUT_LOW);
+	if (IS_ERR(panel->enable_gpio))
+		return PTR_ERR(panel->enable_gpio);
+	if (!preserve || !panel->enable_gpio)
+		return 0;
+	value = gpiod_get_value_cansleep(panel->enable_gpio);
+	if (value < 0)
+		return value;
+	return gpiod_direction_output(panel->enable_gpio, value);
+}
