 /**
+ * drm_dp_atomic_release_port_payload() - retire the payload of an obsolete port
+ * @state: global atomic state
+ * @mgr: MST topology manager of @port
+ * @port: the port whose payload must be removed
+ *
+ * Unlike drm_dp_atomic_release_time_slots() this helper does not require the
+ * connector to have no CRTC in the new state: it is meant for a persistent
+ * connector that keeps its CRTC but moves to another MST port. The caller must
+ * make sure @port is the previous binding and that the new binding gets its own
+ * payload in the same atomic state.
+ *
+ * Returns: 0 on success, negative error code otherwise.
+ */
+int drm_dp_atomic_release_port_payload(struct drm_atomic_state *state,
+				       struct drm_dp_mst_topology_mgr *mgr,
+				       struct drm_dp_mst_port *port)
+{
+	struct drm_dp_mst_topology_state *topology_state;
+	struct drm_dp_mst_atomic_payload *payload;
+	struct drm_connector_state *old_conn_state;
+
+	if (!port || !port->connector)
+		return -EINVAL;
+
+	old_conn_state = drm_atomic_get_old_connector_state(state, port->connector);
+	if (!old_conn_state)
+		return -EINVAL;
+
+	topology_state = drm_atomic_get_mst_topology_state(state, mgr);
+	if (IS_ERR(topology_state))
+		return PTR_ERR(topology_state);
+
+	if (old_conn_state->crtc)
+		topology_state->pending_crtc_mask |= drm_crtc_mask(old_conn_state->crtc);
+
+	payload = drm_atomic_get_mst_payload_state(topology_state, port);
+	if (!payload)
+		return 0;
+
+	if (!payload->delete) {
+		drm_dbg_atomic(mgr->dev, "[MST PORT:%p] retire payload, TU %d -> 0\n",
+			       port, payload->time_slots);
+		payload->pbn = 0;
+		payload->delete = true;
+		if (payload->vcpi > 0)
+			topology_state->payload_mask &= ~BIT(payload->vcpi - 1);
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(drm_dp_atomic_release_port_payload);
