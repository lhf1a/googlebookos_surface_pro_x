+/**
+ * enum drm_dp_mst_connector_lifetime - registration lifetime owner of an MST connector
+ * @DRM_DP_MST_CONNECTOR_CORE_MANAGED: the MST helpers register and unregister the
+ *	connector dynamically, together with the port it belongs to. This is the
+ *	historical behavior and what drivers get when they do not opt in.
+ * @DRM_DP_MST_CONNECTOR_DRIVER_MANAGED: the driver owns the connector lifetime.
+ *	The MST helpers still register it once via drm_connector_register() so that
+ *	userspace can see it, but they never unregister it again; when a port is
+ *	destroyed only &drm_dp_mst_topology_cbs.disconnect_connector is called and
+ *	the reference transferred by add_connector() is dropped. The driver must
+ *	keep its own reference until the topology manager is destroyed.
+ *
+ * The value returned for a connector must stay stable for as long as that
+ * connector object exists; the helpers call it both when a port is created and
+ * when the port is destroyed.
+ */
+enum drm_dp_mst_connector_lifetime {
+	DRM_DP_MST_CONNECTOR_CORE_MANAGED,
+	DRM_DP_MST_CONNECTOR_DRIVER_MANAGED,
+};
