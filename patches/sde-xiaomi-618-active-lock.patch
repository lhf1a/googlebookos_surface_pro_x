+/*
+ * Never acquire an object lock while holding list_lock.  The active list
+ * does not itself own GEM references: final release may already be waiting
+ * for list_lock with a zero reference count and its object lock held.
+ * Pin the complete snapshot before callbacks or mapping changes.  Refuse a
+ * zero-ref entry, rather than resurrect it or skip a required update.
+ * cb_lock serializes transitions and callback registration/unregistration;
+ * callbacks may take object/list locks but must not unregister themselves.
+ */
+int msm_gem_aspace_domain_attach_detach_update(
+        struct msm_gem_address_space *aspace, bool is_detach)
+{
+    struct msm_gem_object *msm_obj;
+    struct drm_gem_object **objects = NULL;
+    struct aspace_client *aclient;
+    size_t count = 0, pinned = 0, i;
+    int ret = 0;
+    uint64_t iova;
+
+    if (!aspace)
+        return -EINVAL;
+
+    mutex_lock(&aspace->cb_lock);
+    mutex_lock(&aspace->list_lock);
+    list_for_each_entry(msm_obj, &aspace->active_list, iova_list)
+        count++;
+    if (count) {
+        objects = kcalloc(count, sizeof(*objects), GFP_KERNEL);
+        if (!objects) {
+            ret = -ENOMEM;
+            goto unlock_list;
+        }
+    }
+    list_for_each_entry(msm_obj, &aspace->active_list, iova_list) {
+        if (!kref_get_unless_zero(&msm_obj->base.refcount)) {
+            ret = -EBUSY;
+            goto unlock_list;
+        }
+        objects[pinned++] = &msm_obj->base;
+    }
+unlock_list:
+    mutex_unlock(&aspace->list_lock);
+    if (ret)
+        goto unlock_callbacks;
+
+    if (is_detach) {
+        list_for_each_entry(aclient, &aspace->clients, list)
+            if (aclient->cb)
+                aclient->cb(aclient->cb_data, true);
+    }
+    for (i = 0; i < pinned; i++) {
+        struct drm_gem_object *obj = objects[i];
+
+        msm_obj = to_msm_bo(obj);
+        mutex_lock(&msm_obj->lock);
+        /* A concurrent purge may already have removed this pinned object. */
+        if (msm_obj->aspace == aspace && msm_obj->in_active_list) {
+            if (is_detach) {
+                if (obj->import_attach) {
+                    put_iova(obj);
+                    msm_obj->obj_dirty = true;
+                }
+            } else {
+                ret = msm_gem_get_iova_locked(obj, aspace, &iova);
+            }
+        }
+        mutex_unlock(&msm_obj->lock);
+        if (ret)
+            break;
+    }
+    if (!ret && !is_detach) {
+        list_for_each_entry(aclient, &aspace->clients, list)
+            if (aclient->cb)
+                aclient->cb(aclient->cb_data, false);
+    }
+unlock_callbacks:
+    mutex_unlock(&aspace->cb_lock);
+    /* The last put may run free_object and acquire list_lock. */
+    for (i = 0; i < pinned; i++)
+        drm_gem_object_put(objects[i]);
+    kfree(objects);
+    return ret;
 }
 
