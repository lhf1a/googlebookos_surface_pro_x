+/* Derived transition flags stored in struct sde_mode_state::adjusted. */
+#define SDE_MODE_ADJ_DYNAMIC_FPS	(1U << 0)
+#define SDE_MODE_ADJ_VBLANK_PRE_MODESET	(1U << 1)
+#define SDE_MODE_ADJ_DMS		(1U << 2)
+#define SDE_MODE_ADJ_VRR		(1U << 3)
+#define SDE_MODE_ADJ_POMS		(1U << 4)
+#define SDE_MODE_ADJ_DYN_CLK		(1U << 5)
+/* Replaces the removed public DRM_MODE_FLAG_SEAMLESS. */
+#define SDE_MODE_ADJ_SEAMLESS		(1U << 6)
+
+/* Resolved catalog row caps consumed by the transition derivation. */
+#define SDE_MODE_CAP_SEAMLESS		(1U << 0)
+#define SDE_MODE_CAP_DFPS		(1U << 1)
+#define SDE_MODE_CAP_VBLANK_PRE_MODESET	(1U << 2)
+#define SDE_MODE_CAP_DMS		(1U << 3)
+#define SDE_MODE_CAP_VRR		(1U << 4)
+#define SDE_MODE_CAP_POMS		(1U << 5)
+#define SDE_MODE_CAP_DYN_CLK		(1U << 6)
+
+/**
+ * struct sde_mode_state - driver-owned mode transition/selection state
+ * @requested:        SDE_MODE_REQ_* bits of the pending atomic request
+ * @request_blob_id:  core MODE_ID blob the request is bound to
+ * @request_conn:     DRM connector object id the identity belongs to
+ * @identity:         catalog identity requested by userspace
+ * @request_blob:     reference held on the request blob property value
+ * @adjusted:         SDE_MODE_ADJ_* transition flags derived for this commit
+ * @selected:         committed catalog identity
+ * @selected_panel:   SDE_MODE_PANEL_* of the committed mode
+ * @state_valid:      the state was populated by sde_mode_state_ingest()
+ * @requested_valid:  a request property value was supplied
+ * @adjusted_valid:   @adjusted is meaningful
+ * @selected_valid:   @selected was resolved and validated
+ */
+struct sde_mode_state {
+	u32 requested;
+	u32 request_blob_id;
+	u32 request_conn;
+	struct sde_mode_identity identity;
+	struct drm_property_blob *request_blob;
+	u32 adjusted;
+	struct sde_mode_identity selected;
+	u32 selected_panel;
+	u32 state_valid;
+	u32 requested_valid;
+	u32 adjusted_valid;
+	u32 selected_valid;
+};
+
+static inline void sde_mode_state_reset(struct sde_mode_state *state)
+{
+	memset(state, 0, sizeof(*state));
+}
+
+/**
+ * sde_mode_state_duplicate() - copy committed selection into a new state
+ *
+ * A new atomic state is allocated by msm_property_alloc_state() and starts
+ * zeroed; the committed selection must survive across commits, while a pending
+ * one-shot request, its derived flags and its blob reference must not.  The
+ * old state keeps ownership of its request blob.
+ */
+static inline void sde_mode_state_duplicate(struct sde_mode_state *dst,
+		const struct sde_mode_state *src)
+{
+	sde_mode_state_reset(dst);
+	dst->adjusted = src->adjusted;
+	dst->adjusted_valid = src->adjusted_valid;
+	dst->selected = src->selected;
+	dst->selected_panel = src->selected_panel;
+	dst->selected_valid = src->selected_valid;
+}
+
+/**
+ * sde_mode_state_ingest() - validate one request blob payload
+ * @state: target state, must be zeroed by reset/duplicate before the first use
+ * @data:  struct sde_mode_request payload
+ * @len:   blob length
+ *
+ * Wire-shape validation only.  Whether the named identity exists and whether
+ * the request is supported is decided later, against the resolved catalog row
+ * and the final atomic state.
+ */
+static inline int sde_mode_state_ingest(struct sde_mode_state *state,
+		const void *data, size_t len)
+{
+	const struct sde_mode_request *req = data;
+	u32 panels;
+
+	if (!state || !data)
+		return -EINVAL;
+	if (len != sizeof(*req))
+		return -EINVAL;
+	if (req->version != SDE_MODE_WIRE_VERSION)
+		return -EINVAL;
+	if (req->bytes != sizeof(*req) || req->reserved)
+		return -EINVAL;
+	if (req->request & ~SDE_MODE_REQ_ALL)
+		return -EINVAL;
+
+	panels = req->request & (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND);
+	if (panels == (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND))
+		return -EINVAL;
+
+	if (!req->mode_blob_id) {
+		/* An all-zero request clears the pending request. */
+		if (req->request || req->connector_id ||
+		    req->identity.generation || req->identity.row_id)
+			return -EINVAL;
+	} else if (!req->connector_id) {
+		return -EINVAL;
+	}
+
+	state->requested = req->request;
+	state->request_blob_id = req->mode_blob_id;
+	state->request_conn = req->connector_id;
+	state->identity = req->identity;
+	state->state_valid = 1;
+	state->requested_valid = req->mode_blob_id != 0;
+	state->adjusted = 0;
+	state->adjusted_valid = 0;
+	state->selected_valid = 0;
+	state->selected_panel = SDE_MODE_PANEL_NONE;
+	return 0;
+}
+
+/**
+ * struct sde_mode_derive_ctx - inputs of the adjusted-mode derivation
+ * @requested:          SDE_MODE_REQ_* bits, zero for a plain modeset
+ * @caps:               SDE_MODE_CAP_* of the resolved catalog row
+ * @have_current:       a committed CRTC mode exists to compare against
+ * @panel_mode_changed: resolved panel interface differs from the current one
+ * @timing_changed:     resolved timing differs from the current mode
+ * @active_changed:     CRTC active state changes in this commit
+ * @cont_splash:        continuous splash is enabled
+ * @enable_unchanged:   CRTC enable state is unchanged by this commit
+ */
+struct sde_mode_derive_ctx {
+	u32 requested;
+	u32 caps;
+	bool have_current;
+	bool panel_mode_changed;
+	bool timing_changed;
+	bool active_changed;
+	bool cont_splash;
+	bool enable_unchanged;
+};
+
+/**
+ * sde_mode_state_derive() - derive adjusted transition flags for one commit
+ * @state: CRTC driver state being checked
+ * @ctx:   resolved transition inputs
+ *
+ * Mirrors the downstream DSI bridge validation semantics: seamless and dynamic
+ * fps come from the resolved panel mode caps, DMS is derived for a plain timing
+ * switch, POMS for a panel interface switch, and a seamless transition is
+ * rejected while the CRTC active state changes.
+ *
+ * Returns: 0 on success, -EINVAL when the request is not supported.
+ */
+static inline int sde_mode_state_derive(struct sde_mode_state *state,
+		const struct sde_mode_derive_ctx *ctx)
+{
+	u32 adj = 0;
+	bool vrr, poms, dyn_clk;
+
+	if (!state || !ctx)
+		return -EINVAL;
+
+	/* A seamless request must be backed by the resolved mode caps. */
+	if ((ctx->requested & SDE_MODE_REQ_SEAMLESS) &&
+	    !(ctx->caps & SDE_MODE_CAP_SEAMLESS))
+		return -EINVAL;
+
+	vrr = ctx->caps & SDE_MODE_CAP_VRR;
+	poms = ctx->caps & SDE_MODE_CAP_POMS;
+	dyn_clk = ctx->caps & SDE_MODE_CAP_DYN_CLK;
+
+	if (ctx->caps & SDE_MODE_CAP_SEAMLESS)
+		adj |= SDE_MODE_ADJ_SEAMLESS;
+	if (ctx->caps & SDE_MODE_CAP_DFPS)
+		adj |= SDE_MODE_ADJ_DYNAMIC_FPS;
+	if (ctx->caps & SDE_MODE_CAP_VBLANK_PRE_MODESET)
+		adj |= SDE_MODE_ADJ_VBLANK_PRE_MODESET;
+	if (vrr)
+		adj |= SDE_MODE_ADJ_VRR;
+	if (poms)
+		adj |= SDE_MODE_ADJ_POMS;
+	if (dyn_clk)
+		adj |= SDE_MODE_ADJ_DYN_CLK;
+
+	/* No panel mode switch while the drm pipeline is changing. */
+	if (ctx->have_current && ctx->enable_unchanged &&
+	    ctx->panel_mode_changed && !vrr)
+		adj |= SDE_MODE_ADJ_POMS;
+
+	/* No DMS/VRR when the drm pipeline is changing. */
+	if (ctx->have_current && ctx->timing_changed && !vrr && !poms &&
+	    !dyn_clk && (!ctx->active_changed || ctx->cont_splash))
+		adj |= SDE_MODE_ADJ_DMS;
+
+	/* Reject seamless transition when the active state changed. */
+	if (ctx->active_changed &&
+	    (adj & (SDE_MODE_ADJ_VRR | SDE_MODE_ADJ_POMS |
+		    SDE_MODE_ADJ_DYN_CLK)))
+		return -EINVAL;
+
+	state->adjusted = adj;
+	state->adjusted_valid = 1;
+	return 0;
+}
+
+/**
+ * sde_mode_state_commit() - validate the request against the final state
+ * @state:         CRTC driver state being checked
+ * @mode_blob_id:  MODE_ID blob selected by the final atomic state
+ *
+ * Runs from CRTC atomic check, so the binding does not depend on the order in
+ * which userspace set MODE_ID and the request property.  A state without a
+ * pending request is a plain modeset and always succeeds.
+ */
+static inline int sde_mode_state_commit(struct sde_mode_state *state,
+		u32 mode_blob_id)
+{
+	if (!state)
+		return -EINVAL;
+
+	if (!state->requested_valid)
+		return 0;
+
+	/* The bridge must have resolved and validated the requested row. */
+	if (!state->selected_valid)
+		return -EINVAL;
+	if (!state->request_blob_id || state->request_blob_id != mode_blob_id)
+		return -EINVAL;
+	if (state->selected.generation != state->identity.generation ||
+	    state->selected.row_id != state->identity.row_id)
+		return -EINVAL;
+
+	state->request_blob_id = mode_blob_id;
+	return 0;
+}
+
+/* Catalog row payload used to fill one uapi catalog entry. */
+struct sde_mode_catalog_source {
+	u32 row_id;
+	u32 panel_kind;
+	u32 h_active;
+	u32 v_active;
+	u32 refresh_rate;
+	u32 pixel_clk_khz;
+	u64 bit_clk_hz;
+	u32 num_lm;
+	u32 comp_type;
+	u32 comp_ratio_numer;
+	u32 comp_ratio_denom;
+	u32 transfer_time_us;
+	u32 allowed_mode_switch;
+	bool roi_enabled;
+	u32 roi_xstart;
+	u32 roi_ystart;
+	u32 roi_walign;
+	u32 roi_halign;
+	u32 roi_wmin;
+	u32 roi_hmin;
+	u32 roi_merge;
+	u32 flags;
+};
+
+static inline void sde_mode_catalog_fill(
+		struct sde_mode_catalog_entry *entry,
+		const struct sde_mode_catalog_source *src)
+{
+	memset(entry, 0, sizeof(*entry));
+	entry->row_id = src->row_id;
+	entry->panel_kind = src->panel_kind;
+	entry->h_active = src->h_active;
+	entry->v_active = src->v_active;
+	entry->refresh_rate = src->refresh_rate;
+	entry->pixel_clk_khz = src->pixel_clk_khz;
+	entry->bit_clk_lo = (u32)src->bit_clk_hz;
+	entry->bit_clk_hi = (u32)(src->bit_clk_hz >> 32);
+	entry->num_lm = src->num_lm;
+	entry->comp_type = src->comp_type;
+	entry->comp_ratio_numer = src->comp_ratio_numer;
+	entry->comp_ratio_denom = src->comp_ratio_denom;
+	entry->transfer_time_us = src->transfer_time_us;
+	entry->allowed_mode_switch = src->allowed_mode_switch;
+	if (src->roi_enabled) {
+		entry->roi_xstart = src->roi_xstart;
+		entry->roi_ystart = src->roi_ystart;
+		entry->roi_walign = src->roi_walign;
+		entry->roi_halign = src->roi_halign;
+		entry->roi_wmin = src->roi_wmin;
+		entry->roi_hmin = src->roi_hmin;
+		entry->roi_merge = src->roi_merge;
+	}
+	entry->flags = src->flags;
+}
+
+#endif /* _SDE_MODE_STATE_H_ */
