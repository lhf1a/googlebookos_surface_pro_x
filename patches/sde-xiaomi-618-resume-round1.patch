+static void msm_drm_private_release(struct drm_device *ddev, void *data)
+{
+	struct msm_drm_private *priv = data;
+ /* Every GEM and file context has dropped its device reference now. */
+	WARN_ON(!list_empty(&priv->inactive_list));
+	if (priv->wq) {
+		destroy_workqueue(priv->wq);
+		priv->wq = NULL;
+	}
+	if (priv->vram_initialized)
+		drm_mm_takedown(&priv->vram.mm);
+	if (priv->vram_allocated)
+		dma_free_attrs(ddev->dev, priv->vram.size, NULL, priv->vram.paddr,
+																DMA_ATTR_NO_KERNEL_MAPPING | DMA_ATTR_WRITE_COMBINE);
+	ddev->dev_private = NULL;
+}
+
+static struct msm_drm_private *msm_drm_private_alloc(struct drm_device *ddev)
+{
+	struct msm_drm_private *priv;
+	int ret;
+	priv = drmm_kzalloc(ddev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return ERR_PTR(-ENOMEM);
+	mutex_init(&priv->lifetime_lock);
+	init_waitqueue_head(&priv->lifetime_wait);
+	atomic_set(&priv->active_users, 0);
+	mutex_init(&priv->gem_lock);
+	INIT_LIST_HEAD(&priv->inactive_list);
+	priv->dev = ddev;
+	ddev->dev_private = priv;
+	ret = drmm_add_action_or_reset(ddev, msm_drm_private_release, priv);
+	if (ret)
+		return ERR_PTR(ret);
+	return priv;
+}
