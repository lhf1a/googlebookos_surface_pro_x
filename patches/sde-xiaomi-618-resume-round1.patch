+/* Acquired during check: the state belongs to this transaction, never obj.state. */
+static struct drm_dp_mst_topology_state *dp_mst_topology_state(
+ struct drm_atomic_state *state, struct dp_mst_private *mst)
+{
+ struct drm_dp_mst_topology_state *topology;
+ struct dp_link_info link;
+ int ret;
+ topology = drm_atomic_get_mst_topology_state(state, &mst->mst_mgr);
+ if (IS_ERR(topology))
+  return topology;
+ ret = mst->dp_display->get_mst_link_info(mst->dp_display, &link);
+ if (ret)
+  return ERR_PTR(ret);
+ topology->pbn_div = drm_dp_get_vc_payload_bw(link.rate, link.num_lanes);
+ if (!topology->pbn_div.full)
+  return ERR_PTR(-EINVAL);
+ drm_dp_mst_update_slots(topology, DP_CAP_ANSI_8B10B);
+ return topology;
+}
+static int dp_mst_find_slots(struct dp_mst_private *mst, int pbn)
+{
+ struct dp_link_info link;
+ fixed20_12 pbn_div;
+ int ret = mst->dp_display->get_mst_link_info(mst->dp_display, &link);
+ if (ret)
+  return ret;
+ pbn_div = drm_dp_get_vc_payload_bw(link.rate, link.num_lanes);
+ if (!pbn_div.full)
+  return -EINVAL;
+ return DIV_ROUND_UP(dfixed_const(pbn), pbn_div.full);
+}
 
