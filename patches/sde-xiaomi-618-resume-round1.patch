+/* No operation/list/object lock is held while retirement waits. Nested
+ * admissions are counted, not read-lock recursion, so a concurrent retire
+ * cannot deadlock a PRIME callback that enters GEM construction again.
+ */
+bool msm_drm_owner_get_live(struct msm_drm_private *priv)
+{
+	bool live = false;
+	if (!priv)
+		return false;
+	mutex_lock(&priv->lifetime_lock);
+	if (!priv->retired) {
+		atomic_inc(&priv->active_users);
+		live = true;
+	}
+	mutex_unlock(&priv->lifetime_lock);
+	return live;
+}
+
+void msm_drm_owner_put_live(struct msm_drm_private *priv)
+{
+	if (atomic_dec_and_test(&priv->active_users))
+		wake_up_all(&priv->lifetime_wait);
+}
+
+static bool msm_drm_owner_retire(struct msm_drm_private *priv)
+{
+	mutex_lock(&priv->lifetime_lock);
+	if (priv->retired) {
+		mutex_unlock(&priv->lifetime_lock);
+		return false;
+	}
+	priv->retired = true;
+	mutex_unlock(&priv->lifetime_lock);
+	wait_event(priv->lifetime_wait, !atomic_read(&priv->active_users));
+	return true;
+}
