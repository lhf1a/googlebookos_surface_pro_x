+/*
+ * Probe-only unwind: no HFI IRQ has been successfully registered and enabled.
+ * Do not use this for live teardown: stop all producers and synchronize the
+ * HFI IRQ before joining the consumer or releasing its cache/outer owner.
+ */
+static void a6xx_hwsched_f2h_probe_cleanup(struct a6xx_hwsched_hfi *hfi)
+{
+	if (hfi->f2h_task) {
+		kthread_stop(hfi->f2h_task);
+		hfi->f2h_task = NULL;
+	}
+	if (hfi->f2h_cache) {
+		kmem_cache_destroy(hfi->f2h_cache);
+		hfi->f2h_cache = NULL;
+	}
