+	if (of_device_is_compatible(serdev->dev.of_node, "surface,aggregator"))
+		return ssam_serdev_setup_via_of(serdev);
 
 	/* TODO: these values may differ per board/implementation */
 	serdev_device_set_baudrate(serdev, 4 * HZ_PER_MHZ);
