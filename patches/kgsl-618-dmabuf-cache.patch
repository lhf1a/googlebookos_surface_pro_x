+/* shortcut: these pinned heaps have known mmap/cache contracts; add real
+ * exporter metadata and range callbacks before accepting other exporters. */
+static int kgsl_dmabuf_cachemode(struct dma_buf *dmabuf)
+{
+	if (!dmabuf->exp_name || !dmabuf->ops->begin_cpu_access ||
+	    !dmabuf->ops->end_cpu_access)
+		return -EOPNOTSUPP;
+	if (!strcmp(dmabuf->exp_name, "system"))
+		return KGSL_CACHEMODE_WRITEBACK;
+	if (!strcmp(dmabuf->exp_name, "system-uncached"))
+		return KGSL_CACHEMODE_WRITECOMBINE;
+	return -EOPNOTSUPP;
+}
