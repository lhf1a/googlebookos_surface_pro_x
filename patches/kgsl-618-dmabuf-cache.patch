+#ifdef CONFIG_DMA_SHARED_BUFFER
+static int kgsl_dmabuf_sync_cache(struct kgsl_mem_entry *entry,
+		u64 offset, u64 length, unsigned int op)
+{
+	struct kgsl_dma_buf_meta *meta = entry->priv_data;
+	int ret;
+
+	if (!meta || !meta->dmabuf)
+		return -EINVAL;
+	if (!length)
+		return -EINVAL;
+	if (offset > entry->memdesc.size || length > entry->memdesc.size - offset)
+		return -ERANGE;
+	/* Whole-buffer callbacks cannot safely invalidate outside this range. */
+	if (offset || length != entry->memdesc.size)
+		return -EOPNOTSUPP;
+
+	/* These exporters have stateless cache callbacks. CLEAN ends CPU writes;
+	 * INV begins CPU reads. FLUSH must clean before invalidating dirty data.
+	 * No reservation lock is held: begin_cpu_access also waits its fences. */
+	switch (op) {
+	case KGSL_CACHE_OP_CLEAN:
+		return dma_buf_end_cpu_access(meta->dmabuf, DMA_TO_DEVICE);
+	case KGSL_CACHE_OP_INV:
+		return dma_buf_begin_cpu_access(meta->dmabuf, DMA_FROM_DEVICE);
+	case KGSL_CACHE_OP_FLUSH:
+		ret = dma_buf_end_cpu_access(meta->dmabuf, DMA_TO_DEVICE);
+		if (ret)
+			return ret;
+		return dma_buf_begin_cpu_access(meta->dmabuf, DMA_FROM_DEVICE);
+	default:
+		return -EINVAL;
+	}
+}
+#endif
