--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -30,6 +30,8 @@
 #include <trace/events/power.h>
 #include <linux/compiler.h>
 #include <linux/moduleparam.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
 
 #include "power.h"
 
@@ -61,6 +63,77 @@
 static bool sq2_screen_only = true;
 module_param_named(screen_only, sq2_screen_only, bool, 0444);
 MODULE_PARM_DESC(screen_only, "Reject system suspend; display blanking only");
+
+/* Explicit diagnostic boot only. Real s2idle stays blocked with screen_only=1. */
+static bool sq2_screen_only_test;
+module_param_named(screen_only_test, sq2_screen_only_test, bool, 0444);
+MODULE_PARM_DESC(screen_only_test, "Allow bounded PM test stages, not real sleep");
+
+/* Called with system_transition_mutex held: pm_test_store uses the same lock. */
+static bool sq2_screen_only_test_allowed(suspend_state_t state)
+{
+#ifdef CONFIG_PM_DEBUG
+	return sq2_screen_only_test && state == PM_SUSPEND_TO_IDLE &&
+		(pm_test_level == TEST_FREEZER || pm_test_level == TEST_DEVICES ||
+		 pm_test_level == TEST_PLATFORM);
+#else
+	return false;
+#endif
+}
+
+
+/* Explicit one-shot lab trial. Normal screen-only boots remain protected.
+ * Only the writing task can consume its token, within five seconds. Both
+ * arming and consumption are serialized by system_transition_mutex.
+ */
+static bool sq1_screen_only_trial;
+module_param_named(screen_only_trial, sq1_screen_only_trial, bool, 0444);
+static int sq1_trial_pid;
+static unsigned long sq1_trial_deadline;
+
+static int sq1_trial_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int flags;
+	int pid, ret;
+
+	ret = kstrtoint(val, 0, &pid);
+	if (ret)
+		return ret;
+	if (pid < 0 || (pid && pid != task_pid_nr(current)))
+		return -EINVAL;
+	if (!sq2_screen_only || !sq2_screen_only_test || !sq1_screen_only_trial)
+		return -EPERM;
+	flags = lock_system_sleep();
+	sq1_trial_pid = pid;
+	sq1_trial_deadline = jiffies + 5 * HZ;
+	unlock_system_sleep(flags);
+	return 0;
+}
+
+static const struct kernel_param_ops sq1_trial_ops = {
+	.set = sq1_trial_set,
+	.get = param_get_int,
+};
+module_param_cb(trial_pid, &sq1_trial_ops, &sq1_trial_pid, 0600);
+
+static bool sq1_trial_take(suspend_state_t state)
+{
+#ifdef CONFIG_PM_DEBUG
+	if (!sq1_screen_only_trial || !sq2_screen_only_test ||
+	    state != PM_SUSPEND_TO_IDLE || pm_test_level != TEST_NONE ||
+	    !sq1_trial_pid || sq1_trial_pid != task_pid_nr(current))
+		return false;
+	/* Consume even an expired token: it can never authorize a later sleep. */
+	sq1_trial_pid = 0;
+	if (time_after(jiffies, sq1_trial_deadline))
+		return false;
+	pr_info("SQ1_TRIAL_CONSUMED pid=%d guard_retained=1\n", task_pid_nr(current));
+	return true;
+#else
+	return false;
+#endif
+}
+
 
 static const struct platform_suspend_ops *suspend_ops;
 static const struct platform_s2idle_ops *s2idle_ops;
@@ -576,6 +649,13 @@
 	if (!mutex_trylock(&system_transition_mutex))
 		return -EBUSY;
 
+	if (sq2_screen_only && !sq2_screen_only_test_allowed(state) &&
+	    !sq1_trial_take(state)) {
+		error = -EOPNOTSUPP;
+		goto Unlock;
+	}
+
+
 	if (state == PM_SUSPEND_TO_IDLE)
 		s2idle_begin();
 
@@ -620,7 +700,7 @@
 {
 	int error;
 
-	if (sq2_screen_only) {
+	if (sq2_screen_only && !sq2_screen_only_test) {
 		pr_warn_ratelimited("SQ2 screen-only policy: system suspend blocked\n");
 		return -EOPNOTSUPP;
 	}
