+/* Use the GPU OPP peak bandwidths; no phone table or inferred frequency ratio. */
+static u32 *kgsl_bus_get_opp_table(struct kgsl_device *device,
+		struct device *dev, u32 *indices, int *count)
+{
+	struct kgsl_pwrctrl *pwr = &device->pwrctrl;
+	u32 levels[MAX_GX_LEVELS] = {};
+	unsigned long previous_freq = 0;
+	u32 *table;
+	int i, num = 1;
+
+	*count = 0;
+	if (!pwr->num_pwrlevels || pwr->num_pwrlevels > KGSL_MAX_PWRLEVELS ||
+		pwr->active_pwrlevel >= pwr->num_pwrlevels ||
+		pwr->default_pwrlevel >= pwr->num_pwrlevels)
+		return ERR_PTR(-EINVAL);
+	if (of_property_count_strings(dev->of_node, "interconnect-names") != 1 ||
+		of_property_match_string(dev->of_node, "interconnect-names", "gfx-mem") != 0)
+		return ERR_PTR(-EINVAL);
+
+	for (i = pwr->num_pwrlevels - 1; i >= 0; i--) {
+		unsigned long freq = pwr->pwrlevels[i].gpu_freq;
+		struct dev_pm_opp *opp;
+		unsigned long peak, avg;
+
+		if (!freq || freq <= previous_freq)
+			return ERR_PTR(-EINVAL);
+		opp = dev_pm_opp_find_freq_exact(dev, freq, true);
+		if (IS_ERR(opp))
+			return ERR_PTR(PTR_ERR(opp));
+		peak = dev_pm_opp_get_bw(opp, true, 0);
+		avg = dev_pm_opp_get_bw(opp, false, 0);
+		dev_pm_opp_put(opp);
+		if (!peak)
+			return ERR_PTR(-ENODATA);
+		if (peak > U32_MAX)
+			return ERR_PTR(-ERANGE);
+		/* Explicit average floors need integration with the bus governor. */
+		if (avg)
+			return ERR_PTR(-EOPNOTSUPP);
+		if (peak < levels[num - 1])
+			return ERR_PTR(-EINVAL);
+		if (peak != levels[num - 1]) {
+			/* Reserve HFI level zero for OFF. */
+			if (num >= MAX_GX_LEVELS)
+				return ERR_PTR(-E2BIG);
+			levels[num++] = peak;
+		}
+		indices[i] = num - 1;
+		previous_freq = freq;
+	}
+
+	table = kcalloc(num, sizeof(*table), GFP_KERNEL);
+	if (!table)
+		return ERR_PTR(-ENOMEM);
+	memcpy(table, levels, num * sizeof(*table));
+	*count = num;
+	return table;
+}
