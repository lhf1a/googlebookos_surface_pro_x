+static int qcom_adreno_smmu_reset_ttbr0(const void *cookie)
+{
+	struct arm_smmu_domain *smmu_domain = (void *)cookie;
+	struct arm_smmu_device *smmu;
+	struct arm_smmu_cb *cb;
+	unsigned long flags;
+	u32 cbndx, asid;
+	int ret;
+
+	ret = qcom_adreno_smmu_get_context_bank(cookie, &cbndx, &asid);
+	if (ret)
+		return ret;
+
+	smmu = smmu_domain->smmu;
+	cb = &smmu->cbs[cbndx];
+	ret = pm_runtime_resume_and_get(smmu->dev);
+	if (ret < 0)
+		return ret;
+
+	spin_lock_irqsave(&smmu_domain->cb_lock, flags);
+	/* CP switches do not change this retained default root. */
+	arm_smmu_cb_writeq(smmu, cbndx, ARM_SMMU_CB_TTBR0, cb->ttbr[0]);
+	arm_smmu_cb_write(smmu, cbndx, ARM_SMMU_CB_CONTEXTIDR, 0);
+	wmb();
+	arm_smmu_cb_write(smmu, cbndx, ARM_SMMU_CB_S1_TLBIASID, asid);
+	ret = qcom_smmu_tlb_sync_checked(smmu, ARM_SMMU_CB(smmu, cbndx),
+			ARM_SMMU_CB_TLBSYNC, ARM_SMMU_CB_TLBSTATUS);
+	spin_unlock_irqrestore(&smmu_domain->cb_lock, flags);
+	pm_runtime_put_autosuspend(smmu->dev);
+	return ret;
+}
