+/* KGSL opts in; other clients retain the core's retry/terminate semantics. */
+static int qcom_adreno_smmu_set_fault_policy(const void *cookie, bool stall)
+{
+	struct arm_smmu_domain *domain = (void *)cookie;
+	struct arm_smmu_device *smmu;
+	struct qcom_smmu *qsmmu;
+	unsigned long flags;
+	u32 bank, asid, mask, reg;
+	int ret;
+
+	ret = qcom_adreno_smmu_get_context_bank(cookie, &bank, &asid);
+	if (ret)
+		return ret;
+	if (bank >= 32)
+		return -EOPNOTSUPP;
+	smmu = domain->smmu;
+	qsmmu = to_qcom_smmu(smmu);
+	mask = BIT(bank);
+	ret = pm_runtime_resume_and_get(smmu->dev);
+	if (ret < 0)
+		return ret;
+	spin_lock_irqsave(&domain->cb_lock, flags);
+	if (qsmmu->fault_masked & mask) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	reg = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_SCTLR);
+	if (stall) {
+		qsmmu->fault_hold_enabled |= mask;
+		qsmmu->stall_enabled |= mask;
+		reg |= ARM_SMMU_SCTLR_CFCFG;
+		reg &= ~ARM_SMMU_SCTLR_HUPCF;
+	} else {
+		qsmmu->fault_hold_enabled &= ~mask;
+		qsmmu->stall_enabled &= ~mask;
+		reg &= ~ARM_SMMU_SCTLR_CFCFG;
+		reg |= ARM_SMMU_SCTLR_HUPCF;
+	}
+	arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_SCTLR, reg);
+	wmb();
+	ret = 0;
+unlock:
+	spin_unlock_irqrestore(&domain->cb_lock, flags);
+	pm_runtime_put_autosuspend(smmu->dev);
+	return ret;
+}
+
+static int qcom_adreno_smmu_terminate_fault(const void *cookie)
+{
+	struct arm_smmu_domain *domain = (void *)cookie;
+	struct arm_smmu_device *smmu;
+	struct qcom_smmu *qsmmu;
+	unsigned long flags;
+	u32 bank, asid, mask, reg, fsr;
+	int ret;
+
+	ret = qcom_adreno_smmu_get_context_bank(cookie, &bank, &asid);
+	if (ret)
+		return ret;
+	if (bank >= 32)
+		return -EOPNOTSUPP;
+	smmu = domain->smmu;
+	qsmmu = to_qcom_smmu(smmu);
+	mask = BIT(bank);
+	ret = pm_runtime_resume_and_get(smmu->dev);
+	if (ret < 0)
+		return ret;
+	spin_lock_irqsave(&domain->cb_lock, flags);
+	if (!(qsmmu->fault_pending & mask))
+		goto unlock;
+
+	/* Stop new stalls so GBIF halt can retire the faulting transaction. */
+	qsmmu->stall_enabled &= ~mask;
+	reg = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_SCTLR);
+	reg &= ~(ARM_SMMU_SCTLR_CFCFG | ARM_SMMU_SCTLR_HUPCF |
+		ARM_SMMU_SCTLR_CFIE);
+	arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_SCTLR, reg);
+	wmb();
+	fsr = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_FSR);
+	arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_FSR, fsr);
+	wmb();
+	arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_RESUME, ARM_SMMU_RESUME_TERMINATE);
+	ret = read_poll_timeout_atomic(arm_smmu_cb_read, fsr,
+		!(fsr & ARM_SMMU_CB_FSR_SS), 1, 10000, false,
+		smmu, bank, ARM_SMMU_CB_FSR);
+	if (!ret)
+		qsmmu->fault_pending &= ~mask;
+unlock:
+	spin_unlock_irqrestore(&domain->cb_lock, flags);
+	pm_runtime_put_autosuspend(smmu->dev);
+	return ret;
+}
+
+static int qcom_adreno_smmu_rearm_fault(const void *cookie)
+{
+	struct arm_smmu_domain *domain = (void *)cookie;
+	struct arm_smmu_device *smmu;
+	struct qcom_smmu *qsmmu;
+	unsigned long flags;
+	u32 bank, asid, mask, reg, fsr;
+	bool put_hold = false;
+	int ret;
+
+	ret = qcom_adreno_smmu_get_context_bank(cookie, &bank, &asid);
+	if (ret)
+		return ret;
+	if (bank >= 32)
+		return -EOPNOTSUPP;
+	smmu = domain->smmu;
+	qsmmu = to_qcom_smmu(smmu);
+	mask = BIT(bank);
+	ret = pm_runtime_resume_and_get(smmu->dev);
+	if (ret < 0)
+		return ret;
+	spin_lock_irqsave(&domain->cb_lock, flags);
+	fsr = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_FSR);
+	if ((qsmmu->fault_pending & mask) || (fsr & ARM_SMMU_CB_FSR_SS)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_FSR, fsr);
+	wmb();
+	reg = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_SCTLR);
+	put_hold = !!(qsmmu->fault_masked & mask);
+	qsmmu->fault_masked &= ~mask;
+	if (qsmmu->fault_hold_enabled & mask)
+		qsmmu->stall_enabled |= mask;
+	qcom_adreno_smmu_write_sctlr(smmu, bank, reg | ARM_SMMU_SCTLR_CFIE);
+	wmb();
+	ret = 0;
+unlock:
+	spin_unlock_irqrestore(&domain->cb_lock, flags);
+	if (put_hold)
+		pm_runtime_put_autosuspend(smmu->dev);
+	pm_runtime_put_autosuspend(smmu->dev);
+	return ret;
+}
+
+static irqreturn_t qcom_adreno_smmu_context_fault(int irq, void *dev)
+{
+	struct arm_smmu_domain *domain = dev;
+	struct arm_smmu_device *smmu = domain->smmu;
+	struct qcom_smmu *qsmmu = to_qcom_smmu(smmu);
+	struct arm_smmu_context_fault_info cfi;
+	unsigned long flags;
+	u32 bank = domain->cfg.cbndx, mask = bank < 32 ? BIT(bank) : 0;
+	bool hold = false, put_hold = false;
+	static DEFINE_RATELIMIT_STATE(rs, DEFAULT_RATELIMIT_INTERVAL,
+				      DEFAULT_RATELIMIT_BURST);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(smmu->dev);
+	if (ret < 0)
+		return IRQ_NONE;
+	spin_lock_irqsave(&domain->cb_lock, flags);
+	arm_smmu_read_context_fault_info(smmu, bank, &cfi);
+	if (!(cfi.fsr & ARM_SMMU_CB_FSR_FAULT)) {
+		spin_unlock_irqrestore(&domain->cb_lock, flags);
+		pm_runtime_put_autosuspend(smmu->dev);
+		return IRQ_NONE;
+	}
+	if (qsmmu->fault_masked & mask) {
+		spin_unlock_irqrestore(&domain->cb_lock, flags);
+		pm_runtime_put_autosuspend(smmu->dev);
+		return IRQ_HANDLED;
+	}
+	hold = (cfi.fsr & ARM_SMMU_CB_FSR_SS) &&
+		(qsmmu->fault_hold_enabled & mask);
+	if (hold) {
+		u32 reg = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_SCTLR);
+
+		/* Publish ownership before callback can schedule recovery. */
+		pm_runtime_get_noresume(smmu->dev);
+		qsmmu->fault_masked |= mask;
+		qsmmu->fault_pending |= mask;
+		arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_SCTLR,
+			reg & ~ARM_SMMU_SCTLR_CFIE);
+		wmb();
+	}
+	spin_unlock_irqrestore(&domain->cb_lock, flags);
+
+	ret = report_iommu_fault(&domain->domain, NULL, cfi.iova,
+		cfi.fsynr & ARM_SMMU_CB_FSYNR0_WNR ? IOMMU_FAULT_WRITE : IOMMU_FAULT_READ);
+	if (ret == -ENOSYS && __ratelimit(&rs))
+		arm_smmu_print_context_fault_info(smmu, bank, &cfi);
+	spin_lock_irqsave(&domain->cb_lock, flags);
+	if (!(hold && ret == -EBUSY) &&
+	    (!hold || (qsmmu->fault_pending & mask))) {
+		arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_FSR, cfi.fsr);
+		wmb();
+		if (cfi.fsr & ARM_SMMU_CB_FSR_SS)
+			arm_smmu_cb_write(smmu, bank, ARM_SMMU_CB_RESUME,
+				ret == -EAGAIN ? 0 : ARM_SMMU_RESUME_TERMINATE);
+		if (hold) {
+			u32 reg = arm_smmu_cb_read(smmu, bank, ARM_SMMU_CB_SCTLR);
+
+			qsmmu->fault_pending &= ~mask;
+			qsmmu->fault_masked &= ~mask;
+			qcom_adreno_smmu_write_sctlr(smmu, bank,
+				reg | ARM_SMMU_SCTLR_CFIE);
+			put_hold = true;
+		}
+	}
+	spin_unlock_irqrestore(&domain->cb_lock, flags);
+	if (put_hold)
+		pm_runtime_put_autosuspend(smmu->dev);
+	pm_runtime_put_autosuspend(smmu->dev);
+	return IRQ_HANDLED;
 }
 
