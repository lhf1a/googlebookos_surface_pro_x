+static int a6xx_gmu_clocks_probe(struct adreno_device *adreno_dev)
+{
+	struct a6xx_gmu_device *gmu = to_a6xx_gmu(adreno_dev);
+	struct device *dev = &gmu->pdev->dev;
+	static const char * const sc8180x_clocks[] = { "ahb", "gmu", "cxo", "axi", "memnoc" };
+	struct clk *core, *hub = NULL;
+	int ret, i, count;
+
+	count = devm_clk_bulk_get_all(dev, &gmu->clks);
+	if (count <= 0)
+		return count ? count : -ENODEV;
+	if (adreno_is_a680(adreno_dev)) {
+		if (!of_device_is_compatible(dev->of_node, "qcom,adreno-gmu"))
+			return -EOPNOTSUPP;
+		for (i = 0; i < ARRAY_SIZE(sc8180x_clocks); i++) {
+			core = kgsl_of_clk_by_name(gmu->clks, count, sc8180x_clocks[i]);
+			if (IS_ERR_OR_NULL(core))
+				return core ? PTR_ERR(core) : -ENODEV;
+		}
+		core = kgsl_of_clk_by_name(gmu->clks, count, "gmu");
+		ret = devm_pm_opp_of_add_table(dev);
+		if (ret)
+			return ret;
+	} else {
+		core = kgsl_of_clk_by_name(gmu->clks, count, "gmu_clk");
+		hub = kgsl_of_clk_by_name(gmu->clks, count, "hub_clk");
+		if (IS_ERR_OR_NULL(core))
+			return core ? PTR_ERR(core) : -ENODEV;
+		if (IS_ERR(hub))
+			return PTR_ERR(hub);
+		if (!IS_ENABLED(CONFIG_QCOM_KGSL_QDSS_STM)) {
+			for (i = 0; i < count; i++)
+				if (!strcmp(gmu->clks[i].id, "apb_pclk"))
+					gmu->clks[i].clk = NULL;
+		}
+	}
+	gmu->core_clk = core;
+	gmu->hub_clk = hub;
+	gmu->num_clks = count;
+	return 0;
+}
