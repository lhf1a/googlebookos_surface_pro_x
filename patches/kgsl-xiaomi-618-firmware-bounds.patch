 static int find_vma_block(struct a6xx_gmu_device *gmu, u32 addr, u32 size)
 {
 	int i;
+
+	if (!size)
+		return -EINVAL;
 
 	for (i = 0; i < GMU_MEM_TYPE_MAX; i++) {
 		struct gmu_vma_entry *vma = &gmu->vma[i];
 
-		if ((addr >= vma->start) &&
-			((addr + size) <= (vma->start + vma->size)))
+		if (addr >= vma->start &&
+			(u64)addr + size <= (u64)vma->start + vma->size)
 			return i;
 	}
 
 	return -ENOENT;
+}
+
+/* Decode locally: the previous payload need not align the next header. */
+static int a6xx_gmu_next_fw_block(const struct firmware *fw, size_t *offset,
+	struct gmu_block_header *blk)
+{
+	if (*offset > fw->size || fw->size - *offset < sizeof(*blk))
+		return -EINVAL;
+
+	memcpy(blk, fw->data + *offset, sizeof(*blk));
+	blk->addr = le32_to_cpu(blk->addr);
+	blk->size = le32_to_cpu(blk->size);
+	blk->type = le32_to_cpu(blk->type);
+	blk->value = le32_to_cpu(blk->value);
+	*offset += sizeof(*blk);
+	if (blk->size > fw->size - *offset)
+		return -EINVAL;
+	*offset += blk->size;
+	return 0;
+}
+
+/* Validate the entire image before allocating metadata or writing any payload. */
+static int a6xx_gmu_validate_fw(struct a6xx_gmu_device *gmu, bool backing)
+{
+	const struct firmware *fw = gmu->fw_image;
+	struct gmu_block_header blk;
+	size_t offset = 0;
+	bool payload = false;
+	int id, ret;
+
+	if (!fw || !fw->data || !fw->size)
+		return -EINVAL;
+
+	while (offset < fw->size) {
+		ret = a6xx_gmu_next_fw_block(fw, &offset, &blk);
+		if (ret)
+			return ret;
+		if (!blk.size) {
+			if (payload)
+				return -EINVAL;
+			if (blk.type != GMU_BLK_TYPE_PREALLOC_REQ &&
+				blk.type != GMU_BLK_TYPE_PREALLOC_PERSIST_REQ)
+				continue;
+			id = find_vma_block(gmu, blk.addr, blk.value);
+			if (id < 0)
+				return -EINVAL;
+			if (id != GMU_ITCM && id != GMU_DTCM &&
+				id != GMU_NONCACHED_USER) {
+				if (!IS_ALIGNED(blk.addr, PAGE_SIZE) ||
+					blk.value > U32_MAX - (PAGE_SIZE - 1) ||
+					find_vma_block(gmu, blk.addr,
+						PAGE_ALIGN(blk.value)) != id)
+					return -EINVAL;
+			}
+			continue;
+		}
+
+		payload = true;
+		id = find_vma_block(gmu, blk.addr, blk.size);
+		if (id < 0)
+			return -EINVAL;
+		if (id == GMU_ITCM || id == GMU_DTCM) {
+			if (!IS_ALIGNED(blk.addr, sizeof(u32)))
+				return -EINVAL;
+		} else if (backing) {
+			struct gmu_memdesc *md =
+				find_gmu_memdesc(gmu, blk.addr, blk.size);
+
+			if (!md || IS_ERR_OR_NULL(md->hostptr))
+				return -EINVAL;
+		}
+	}
+
+	return payload ? 0 : -EINVAL;
 }
 
