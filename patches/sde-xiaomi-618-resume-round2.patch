+int sde_get_ddrtype(void)
+{
+	struct device_node *node;
+	u32 value;
+	int type = -ENOENT;
+
+	for_each_node_by_type(node, "memory") {
+		if (of_property_read_u32(node, "ddr_device_type", &value))
+			continue;
+		if (value > INT_MAX || (type >= 0 && value != type)) {
+			of_node_put(node);
+			return -EINVAL;
+		}
+		type = value;
+	}
+	return type;
+}
 
