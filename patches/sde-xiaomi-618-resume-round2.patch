+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Minimal compatibility header for the downstream (Xiaomi) display notifier.
+ *
+ * PROVENANCE / LIMITS -- READ BEFORE TRUSTING
+ * -------------------------------------------
+ * The 4.19 vendor tree shipped <drm/mi_disp_notifier.h> inside its kernel tree.
+ * Neither the prepared 6.18 kernel tree (/mnt/.../kgsl-sde-fence-20261111-build/
+ * kernel) nor the 315-source donor set nor any tree on this host contains that
+ * header, so this is a MODELLED header, not the real vendor header.
+ *
+ * It declares only what the in-tree call sites actually use:
+ *   - struct mi_disp_notifier { void *data; int disp_id; }
+ *       dsi_drm.c and dsi_display.c fill .data (pointer to an int power mode
+ *       or fps) and .disp_id (mi_get_disp_id()), then pass &notify_data to
+ *       mi_disp_notifier_call_chain().
+ *   - mi_disp_notifier_call_chain() / mi_disp_register_client() /
+ *       mi_disp_unregister_client() prototypes: the implementation lives in
+ *       techpack/display/msm/mi_disp/mi_disp_notifier.c (exports these names).
+ *   - the three event values the DSI code raises.
+ *
+ * The event VALUES are NOT derived from a donor header -- no in-tree consumer
+ * registers for them, so the numeric ABI cannot be validated on this host.
+ * They are ordered as early-DPMS -> DPMS -> fps-change to match the call order
+ * in dsi_drm.c (EARLY_EVENT is raised before EVENT). Treat them as
+ * unvalidated vendor ABI: if a userspace/other-module consumer of the Xiaomi
+ * notifier is ever added, re-audit these numbers against the real vendor
+ * header first.
+ */
+#ifndef _DRM_MI_DISP_NOTIFIER_H_
+#define _DRM_MI_DISP_NOTIFIER_H_
+
+#include <linux/notifier.h>
+#include <linux/types.h>
+
+struct mi_disp_notifier {
+	void *data;
+	int disp_id;
+};
+
+/* MODELLED values -- see provenance note above. */
+enum mi_disp_notifier_event {
+	MI_DISP_DPMS_EARLY_EVENT = 0,
+	MI_DISP_DPMS_EVENT = 1,
+	MI_DISP_FPS_CHANGE_EVENT = 2,
+};
+
+int mi_disp_register_client(struct notifier_block *nb);
+int mi_disp_unregister_client(struct notifier_block *nb);
+int mi_disp_notifier_call_chain(unsigned long val, void *v);
+
+#endif /* _DRM_MI_DISP_NOTIFIER_H_ */
