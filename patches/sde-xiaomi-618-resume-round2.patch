+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Minimal compatibility header for the downstream 10nm DSI PLL clock IDs.
+ *
+ * PROVENANCE / LIMITS -- READ BEFORE TRUSTING
+ * -------------------------------------------
+ * MODELLED header: the real vendor mdss-10nm-pll-clk.h is not present in the
+ * prepared 6.18 kernel tree, the 315-source donor set, or anywhere on this
+ * host (searched whole repo + workspace). It is reconstructed from the only
+ * in-tree consumer, dsi_pll_10nm.c:
+ *   - dsi_pllcc_10nm[] is a designated-initializer array indexed by every name
+ *     below;
+ *   - the two registration loops use the order VCO_CLK_0 ..
+ *     SHADOW_PCLK_SRC_0_CLK and VCO_CLK_1 .. SHADOW_PCLK_SRC_1_CLK;
+ *   - num_clks = ARRAY_SIZE(dsi_pllcc_10nm), so the enum must be contiguous
+ *     with exactly 18 entries per PLL block (36 total) for the array size and
+ *     the of_clk onecell provider indices to stay consistent.
+ * The names are therefore ordered exactly as the designated initializers
+ * appear; numeric values are the resulting contiguous indices.
+ *
+ * These numeric IDs are exposed to DT via of_clk_add_provider()/
+ * of_clk_src_onecell_get(), i.e. they are an unvalidated vendor DT ABI: the
+ * internal array/loop consistency is provable, but that the IDs match the
+ * vendor DTS clock-index encoding is NOT validated on this host.
+ */
+#ifndef _DT_BINDINGS_CLK_MDSS_10NM_PLL_CLK_H
+#define _DT_BINDINGS_CLK_MDSS_10NM_PLL_CLK_H
+
+enum mdss_dsi_pll_10nm_clk_type {
+	/* PLL 0 block */
+	VCO_CLK_0 = 0,
+	PLL_OUT_DIV_0_CLK,
+	BITCLK_SRC_0_CLK,
+	BYTECLK_SRC_0_CLK,
+	POST_BIT_DIV_0_CLK,
+	POST_VCO_DIV_0_CLK,
+	BYTECLK_MUX_0_CLK,
+	PCLK_SRC_MUX_0_CLK,
+	PCLK_SRC_0_CLK,
+	PCLK_MUX_0_CLK,
+	SHADOW_VCO_CLK_0,
+	SHADOW_PLL_OUT_DIV_0_CLK,
+	SHADOW_BITCLK_SRC_0_CLK,
+	SHADOW_BYTECLK_SRC_0_CLK,
+	SHADOW_POST_BIT_DIV_0_CLK,
+	SHADOW_POST_VCO_DIV_0_CLK,
+	SHADOW_PCLK_SRC_MUX_0_CLK,
+	SHADOW_PCLK_SRC_0_CLK,
+
+	/* PLL 1 block */
+	VCO_CLK_1,
+	PLL_OUT_DIV_1_CLK,
+	BITCLK_SRC_1_CLK,
+	BYTECLK_SRC_1_CLK,
+	POST_BIT_DIV_1_CLK,
+	POST_VCO_DIV_1_CLK,
+	BYTECLK_MUX_1_CLK,
+	PCLK_SRC_MUX_1_CLK,
+	PCLK_SRC_1_CLK,
+	PCLK_MUX_1_CLK,
+	SHADOW_VCO_CLK_1,
+	SHADOW_PLL_OUT_DIV_1_CLK,
+	SHADOW_BITCLK_SRC_1_CLK,
+	SHADOW_BYTECLK_SRC_1_CLK,
+	SHADOW_POST_BIT_DIV_1_CLK,
+	SHADOW_POST_VCO_DIV_1_CLK,
+	SHADOW_PCLK_SRC_MUX_1_CLK,
+	SHADOW_PCLK_SRC_1_CLK,
+};
+
+#endif /* _DT_BINDINGS_CLK_MDSS_10NM_PLL_CLK_H */
