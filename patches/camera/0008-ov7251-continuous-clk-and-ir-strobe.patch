@@ -1337,13 +1359,16 @@
 static int ov7251_s_stream(struct v4l2_subdev *subdev, int enable)
 {
 	struct ov7251 *ov7251 = to_ov7251(subdev);
+	u8 reg_val = 0, mipi_ctrl = 0;
 	int ret;
 
+	dev_dbg(ov7251->dev, "s_stream(%d) called\n", enable);
 	mutex_lock(&ov7251->lock);
 
 	if (enable) {
 		ret = pm_runtime_resume_and_get(ov7251->dev);
 		if (ret) {
+			dev_err(ov7251->dev, "pm_runtime_resume failed: %d\n", ret);
 			mutex_unlock(&ov7251->lock);
 			return ret;
 		}
@@ -1368,21 +1393,72 @@
 			dev_err(ov7251->dev, "could not sync v4l2 controls\n");
 			goto err_power_down;
 		}
+		ret = ov7251_write_reg(ov7251, 0x4800, 0x24);
+		if (ret)
+			dev_err(ov7251->dev, "write 0x4800 failed: %d\n", ret);
+
+		if (ir_strobe > 0) {
+			if (strobe_pattern >= 0)
+				ov7251_write_reg(ov7251, 0x3b81,
+						 (u8)(strobe_pattern & 0xff));
+			if (strobe_span >= 0) {
+				ov7251_write_reg(ov7251, 0x3b8e,
+						 (u8)((strobe_span >> 8) & 0xff));
+				ov7251_write_reg(ov7251, 0x3b8f,
+						 (u8)(strobe_span & 0xff));
+			}
+			if (strobe_pol >= 0)
+				ov7251_write_reg(ov7251, 0x3b96,
+						 (u8)(strobe_pol & 0xff));
+
+			if (ir_strobe == 1) {
+				ov7251_write_reg(ov7251, 0x3027, 0x00);
+				ov7251_write_reg(ov7251, 0x3005, 0x08);
+			} else if (ir_strobe == 2) {
+				ov7251_write_reg(ov7251, 0x3009, 0x08);
+				ov7251_write_reg(ov7251, 0x3027, 0x08);
+				ov7251_write_reg(ov7251, 0x3005, 0x08);
+			} else if (ir_strobe == 3) {
+				ov7251_write_reg(ov7251, 0x3027, 0x00);
+				ov7251_write_reg(ov7251, 0x3005, 0x0c);
+			} else if (ir_strobe == 4) {
+				ov7251_write_reg(ov7251, 0x3009, 0x0c);
+				ov7251_write_reg(ov7251, 0x3027, 0x0c);
+				ov7251_write_reg(ov7251, 0x3005, 0x0c);
+			}
+		}
+
 		ret = ov7251_write_reg(ov7251, OV7251_SC_MODE_SELECT,
 				       OV7251_SC_MODE_SELECT_STREAMING);
-		if (ret)
+		if (ret) {
+			dev_err(ov7251->dev, "write MODE_SELECT failed: %d\n", ret);
 			goto err_power_down;
+		}
+		ov7251_read_reg(ov7251, OV7251_SC_MODE_SELECT, &reg_val);
+		ov7251_read_reg(ov7251, 0x4800, &mipi_ctrl);
+		dev_dbg(ov7251->dev,
+			"streaming started: MODE_SELECT=0x%02x, MIPI_0x4800=0x%02x, ir_strobe=%d\n",
+			reg_val, mipi_ctrl, ir_strobe);
 	} else {
+		ov7251_write_reg(ov7251, 0x3005, 0x00);
+		ov7251_write_reg(ov7251, 0x3027, 0x00);
+		ov7251_write_reg(ov7251, 0x3009, 0x00);
 		ret = ov7251_write_reg(ov7251, OV7251_SC_MODE_SELECT,
 				       OV7251_SC_MODE_SELECT_SW_STANDBY);
-		pm_runtime_put(ov7251->dev);
+		dev_dbg(ov7251->dev, "streaming stopped, returned to standby\n");
+		pm_runtime_mark_last_busy(ov7251->dev);
+		pm_runtime_put_autosuspend(ov7251->dev);
 	}
 
 	mutex_unlock(&ov7251->lock);
 	return ret;
 
 err_power_down:
-	pm_runtime_put(ov7251->dev);
+	ov7251_write_reg(ov7251, 0x3005, 0x00);
+	ov7251_write_reg(ov7251, 0x3027, 0x00);
+	ov7251_write_reg(ov7251, 0x3009, 0x00);
+	pm_runtime_mark_last_busy(ov7251->dev);
+	pm_runtime_put_autosuspend(ov7251->dev);
 	mutex_unlock(&ov7251->lock);
 	return ret;
 }
