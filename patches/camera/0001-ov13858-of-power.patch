@@ -1655,6 +1662,74 @@
 	mutex_destroy(&ov13858->mutex);
 }
 
+/* ACPI systems retain their firmware-managed power domain. */
+static int ov13858_power_on(struct device *dev)
+{
+ struct ov13858 *sensor = to_ov13858(dev_get_drvdata(dev));
+ int i, ret;
+ if (!sensor->managed_power)
+  return 0;
+ gpiod_set_value_cansleep(sensor->reset, 1);
+ for (i = 0; i < ARRAY_SIZE(sensor->supplies); i++) {
+  ret = regulator_enable(sensor->supplies[i].consumer);
+  if (ret)
+   goto disable_supplies;
+ }
+ usleep_range(1000, 1500);
+ ret = clk_prepare_enable(sensor->clk);
+ if (ret)
+  goto disable_supplies;
+ usleep_range(1000, 1500);
+ gpiod_set_value_cansleep(sensor->reset, 0);
+ usleep_range(5000, 7500);
+ return 0;
+
+disable_supplies:
+ while (i--)
+  regulator_disable(sensor->supplies[i].consumer);
+ return ret;
+}
+
+static int ov13858_power_off(struct device *dev)
+{
+ struct ov13858 *sensor = to_ov13858(dev_get_drvdata(dev));
+ int i, ret, first = 0;
+ if (!sensor->managed_power)
+  return 0;
+ gpiod_set_value_cansleep(sensor->reset, 1);
+ usleep_range(1000, 1500);
+ clk_disable_unprepare(sensor->clk);
+ for (i = ARRAY_SIZE(sensor->supplies) - 1; i >= 0; i--) {
+  ret = regulator_disable(sensor->supplies[i].consumer);
+  if (ret && !first)
+   first = ret;
+ }
+ return first;
+}
+
+static int ov13858_get_power(struct ov13858 *sensor)
+{
+ int ret;
+ if (!sensor->dev->of_node)
+  return 0;
+ sensor->reset = devm_gpiod_get(sensor->dev, "reset", GPIOD_OUT_HIGH);
+ if (IS_ERR(sensor->reset))
+  return dev_err_probe(sensor->dev, PTR_ERR(sensor->reset), "reset GPIO unavailable\n");
+ sensor->supplies[0].supply = "iovdd";
+ sensor->supplies[1].supply = "avdd";
+ sensor->supplies[2].supply = "dvdd";
+ ret = devm_regulator_bulk_get(sensor->dev, ARRAY_SIZE(sensor->supplies),
+                               sensor->supplies);
+ if (ret)
+  return dev_err_probe(sensor->dev, ret, "sensor supplies unavailable\n");
+ sensor->managed_power = true;
+ return 0;
+}
+
+static const struct dev_pm_ops ov13858_pm_ops = {
+ SET_RUNTIME_PM_OPS(ov13858_power_off, ov13858_power_on, NULL)
+};
