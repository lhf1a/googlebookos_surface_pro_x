  * the GSI layer and signals it has finished by sending an SMP2P interrupt
  * to the AP; this triggers the start if IPA setup.
  */
+/* Explicit SQ2 lab gates. Not autoloaded/installed by the build script.
+ * 0: refuse before hardware; 1: read-only preflight then -EAGAIN;
+ * 2: normal complete driver initialization, including PAS15 firmware/DMA.
+ */
+static unsigned int sq2_lab_mode;
+module_param(sq2_lab_mode, uint, 0400);
+MODULE_PARM_DESC(sq2_lab_mode, "SQ2 lab only: 0 refuse, 1 read-only preflight, 2 full init");
+
+static int sq2_group_count(struct device *dev, void *data)
+{
+ unsigned int *count = data;
+ (*count)++;
+ return 0;
+}
+static int sq2_lab_preflight(struct platform_device *pdev)
+{
+ struct device *dev = &pdev->dev;
+ struct iommu_fwspec *spec = dev_iommu_fwspec_get(dev);
+ struct iommu_group *group;
+ struct iommu_domain *domain;
+ struct device_node *np;
+ struct resource stage;
+ struct resource *ipa, *gsi, *shared;
+ struct clk *core;
+ void __iomem *regs, *status;
+ const char *loader, *firmware;
+ unsigned long before, during = 0, after;
+ bool changed = false, enabled_before;
+ unsigned int count = 0, i, tx_count, rx_count, rx_base;
+ u32 version, mem, flavor, gsi_status;
+ int ret, restore = 0;
+
+ if (!is_kernel_in_hyp_mode() || !of_machine_is_compatible("microsoft,surface-pro-x") ||
+     !of_machine_is_compatible("qcom,sc8180x")) return -EPERM;
+ if (!spec || spec->num_ids != 2 || spec->ids[0] != 0x520 || spec->ids[1] != 0x522)
+  return dev_err_probe(dev, -EINVAL, "SQ2 lab requires exact AP/uC SID520/522\n");
+ group = iommu_group_get(dev);
+ if (!group) return -ENODEV;
+ ret = iommu_group_for_each_dev(group, &count, sq2_group_count);
+ iommu_group_put(group);
+ domain = iommu_get_domain_for_dev(dev);
+ if (ret || count != 1 || !domain ||
+     (domain->type != IOMMU_DOMAIN_DMA && domain->type != IOMMU_DOMAIN_DMA_FQ)) return -EBUSY;
+ ipa = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ipa-reg");
+ gsi = platform_get_resource_byname(pdev, IORESOURCE_MEM, "gsi");
+ shared = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ipa-shared");
+ if (!ipa || ipa->start != 0x1e40000 || resource_size(ipa) < 0x7000 ||
+     !gsi || gsi->start != 0x1e04000 || resource_size(gsi) < 0x28000 ||
+     !shared || shared->start != 0x1e47000 || resource_size(shared) < 0x4000) return -EINVAL;
+ if (of_property_read_string(dev->of_node, "qcom,gsi-loader", &loader) || strcmp(loader, "self") ||
+     of_property_read_bool(dev->of_node, "modem-init")) return -EINVAL;
+ if (of_property_read_string(dev->of_node, "firmware-name", &firmware) ||
+     strcmp(firmware, "qcom/sc8180x/sq2/ipa_fws.elf")) return -EINVAL;
+ np = of_parse_phandle(dev->of_node, "memory-region", 0);
+ if (!np) return -ENODEV;
+ ret = of_address_to_resource(np, 0, &stage);
+ if (!ret && (!of_property_read_bool(np, "no-map") || stage.start < 0x80000000ULL ||
+              resource_size(&stage) < 0x60000 || resource_size(&stage) > 0x100000)) ret = -EINVAL;
+ of_node_put(np);
+ if (ret) return ret;
+ core = clk_get(dev, "core");
+ if (IS_ERR(core)) return PTR_ERR(core);
