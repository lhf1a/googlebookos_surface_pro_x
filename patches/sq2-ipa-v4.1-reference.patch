+// SPDX-License-Identifier: GPL-2.0-only
+/* INCOMPLETE, offline-only IPA4.1 register subset. No hardware writes here.
+ * Source: c8bbb1e3a59cb5cde2da79a8db638691b70535d7 ipahal_reg.c/_i.h:
+ * 4.1 inherits 4.0. Do NOT substitute the SC7180 IPA4.2 table.
+ * Kept unreachable by the early compatible guard and supported-version check.
+ */
+#include <linux/types.h>
+#include "../ipa.h"
+#include "../ipa_reg.h"
+
+static const u32 reg_endp_init_ctrl_fmask[] = {
+	[ENDP_DELAY] = BIT(1), /* RX suspend removed in 4.0; don't write bit0 */
+};
+REG_STRIDE_FIELDS(ENDP_INIT_CTRL, endp_init_ctrl, 0x800, 0x70);
+
+static const u32 reg_endp_init_hol_block_timer_fmask[] = {
+	[TIMER_BASE_VALUE] = GENMASK(31, 0), /* NOT the 4.2 base/scale split */
+};
+REG_STRIDE_FIELDS(ENDP_INIT_HOL_BLOCK_TIMER, endp_init_hol_block_timer, 0x830, 0x70);
+
+static const u32 reg_endp_init_rsrc_grp_fmask[] = {
+	[ENDP_RSRC_GRP] = GENMASK(1, 0),
+};
+REG_STRIDE_FIELDS(ENDP_INIT_RSRC_GRP, endp_init_rsrc_grp, 0x838, 0x70);
+
+static const u32 reg_endp_init_seq_fmask[] = {
+	[SEQ_TYPE] = GENMASK(7, 0),
+	[SEQ_REP_TYPE] = GENMASK(15, 8),
+};
+REG_STRIDE_FIELDS(ENDP_INIT_SEQ, endp_init_seq, 0x83c, 0x70);
+
+static const u32 reg_idle_indication_cfg_fmask[] = {
+	[ENTER_IDLE_DEBOUNCE_THRESH] = GENMASK(15, 0),
+	[CONST_NON_IDLE_ENABLE] = BIT(16),
+};
+REG_FIELDS(IDLE_INDICATION_CFG, idle_indication_cfg, 0x220);
+REG(IPA_BCR, ipa_bcr, 0x1d0);
+
+static const struct reg *reg_array[] = {
+	[ENDP_INIT_CTRL] = &reg_endp_init_ctrl,
+	[ENDP_INIT_HOL_BLOCK_TIMER] = &reg_endp_init_hol_block_timer,
+	[ENDP_INIT_RSRC_GRP] = &reg_endp_init_rsrc_grp,
+	[ENDP_INIT_SEQ] = &reg_endp_init_seq,
+	[IDLE_INDICATION_CFG] = &reg_idle_indication_cfg,
+	[IPA_BCR] = &reg_ipa_bcr,
+};
+const struct regs ipa_regs_v4_1 = {
+	.reg_count = ARRAY_SIZE(reg_array),
+	.reg = reg_array,
+};
