+	spinlock_t lock;
+	struct list_head pending;
+	u64 context;
+	u64 next_fence;
+	u64 commit_seq;
+	bool commit_pending;
+	bool kicked;
+	bool disabled_verified;
+	int wait_status;
+};
+
+int dpu_release_init(struct drm_crtc *crtc);
+int dpu_release_set_property(struct drm_crtc *crtc, struct drm_crtc_state *state,
+			    struct drm_property *property, u64 val);
+int dpu_release_get_property(struct drm_crtc *crtc,
+			    const struct drm_crtc_state *state,
+			    struct drm_property *property, u64 *val);
+int dpu_release_check(struct drm_crtc_state *state);
+int dpu_release_atomic_commit(struct msm_kms *kms, struct drm_atomic_state *state,
+			      bool nonblock);
+void dpu_release_begin(struct drm_crtc *crtc, struct drm_atomic_state *state);
+void dpu_release_kickoff(struct drm_crtc *crtc);
+void dpu_release_wait_result(struct drm_crtc *crtc, int status);
+void dpu_release_disable(struct drm_crtc *crtc, u32 old_encoder_mask);
+void dpu_release_complete(struct drm_crtc *crtc);
+
