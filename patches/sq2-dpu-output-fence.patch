--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_release_fence.c
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * A video-mode buffer is reusable after a later update replaces it, not when
+ * its own OUT_FENCE_PTR signals. Keep that future dependency in a real
+ * dma_fence owned by the CRTC, independent of the requesting file's lifetime.
+ */
+#include <linux/file.h>
+#include <linux/slab.h>
+#include <linux/sync_file.h>
+#include <linux/uaccess.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_property.h>
+
+#include "dpu_crtc.h"
+#include "dpu_encoder.h"
+#include "dpu_release_fence.h"
+
+struct dpu_release_fence {
+	struct dma_fence base;
+	spinlock_t lock;
+	struct list_head link;
+	u64 commit_seq;
+};
+
+static const char *dpu_release_driver_name(struct dma_fence *fence)
+{
+	return "msm-dpu";
+}
+
+static const char *dpu_release_timeline_name(struct dma_fence *fence)
+{
+	return "dpu-video-buffer-release";
+}
+
+static void dpu_release_free(struct dma_fence *fence)
+{
+	struct dpu_release_fence *release =
+		container_of(fence, struct dpu_release_fence, base);
+
+	kfree_rcu(release, base.rcu);
+}
+
+static const struct dma_fence_ops dpu_release_ops = {
+	.get_driver_name = dpu_release_driver_name,
+	.get_timeline_name = dpu_release_timeline_name,
+	.release = dpu_release_free,
+};
+
+static void dpu_release_signal(struct dpu_release_timeline *timeline,
+			       u64 completed, bool all, int error)
+{
+	struct dpu_release_fence *fence, *next;
+	unsigned long flags;
+	LIST_HEAD(done);
+
+	spin_lock_irqsave(&timeline->lock, flags);
+	list_for_each_entry_safe(fence, next, &timeline->pending, link) {
+		if (all || fence->commit_seq < completed)
+			list_move_tail(&fence->link, &done);
+	}
+	spin_unlock_irqrestore(&timeline->lock, flags);
+
+	list_for_each_entry_safe(fence, next, &done, link) {
+		list_del_init(&fence->link);
+		if (error)
+			dma_fence_set_error(&fence->base, error);
+		dma_fence_signal(&fence->base);
+		dma_fence_put(&fence->base);
+	}
+}
+
+static void dpu_release_fini(struct drm_device *dev, void *data)
+{
+	struct dpu_release_timeline *timeline = data;
+
+	/* Managed teardown runs after the display has been shut down. */
+	dpu_release_signal(timeline, 0, true, -ENODEV);
+}
+
+int dpu_release_init(struct drm_crtc *crtc)
+{
+	struct dpu_crtc *dpu = to_dpu_crtc(crtc);
+	struct dpu_release_timeline *timeline = &dpu->release_timeline;
+	int ret;
+
+	spin_lock_init(&timeline->lock);
+	INIT_LIST_HEAD(&timeline->pending);
+	timeline->context = dma_fence_context_alloc(1);
+	timeline->wait_status = -EINPROGRESS;
+	ret = drmm_add_action_or_reset(crtc->dev, dpu_release_fini, timeline);
+	if (ret)
+		return ret;
+
+	dpu->release_fence_property = drm_property_create_range(crtc->dev,
+		DRM_MODE_PROP_ATOMIC, "QCOM_DPU_RELEASE_FENCE_PTR", 0, U64_MAX);
+	if (!dpu->release_fence_property)
+		return -ENOMEM;
+	drm_object_attach_property(&crtc->base, dpu->release_fence_property, 0);
+	return 0;
+}
+
+int dpu_release_set_property(struct drm_crtc *crtc, struct drm_crtc_state *state,
+			    struct drm_property *property, u64 val)
+{
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+
+	if (property != to_dpu_crtc(crtc)->release_fence_property)
+		return -EINVAL;
+	if (val && put_user(-1, (s32 __user *)u64_to_user_ptr(val)))
+		return -EFAULT;
+	cstate->release_fence_ptr = val;
+	return 0;
+}
+
+int dpu_release_get_property(struct drm_crtc *crtc,
+			    const struct drm_crtc_state *state,
+			    struct drm_property *property, u64 *val)
+{
+	if (property != to_dpu_crtc(crtc)->release_fence_property)
+		return -EINVAL;
+	*val = 0;
+	return 0;
+}
+
+int dpu_release_check(struct drm_crtc_state *state)
+{
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+	struct drm_encoder *encoder;
+	bool video = false;
+
+	if (!cstate->release_fence_ptr)
+		return 0;
+	if (state->state->async_update || state->state->legacy_cursor_update ||
+	    state->self_refresh_active || drm_crtc_in_clone_mode(state))
+		return -EOPNOTSUPP;
+	if (!state->active)
+		return 0;
+	drm_for_each_encoder_mask(encoder, state->crtc->dev, state->encoder_mask) {
+		if (dpu_encoder_get_intf_mode(encoder) != INTF_MODE_VIDEO)
+			return -EOPNOTSUPP;
+		video = true;
+	}
+	return video ? 0 : -EOPNOTSUPP;
+}
+
+struct dpu_release_export {
+	struct dpu_crtc_state *cstate;
+	struct sync_file *sync;
+	s32 __user *ptr;
+	int fd;
+};
+
+int dpu_release_atomic_commit(struct msm_kms *kms, struct drm_atomic_state *state,
+			      bool nonblock)
+{
+	struct drm_device *dev = state->dev;
+	struct dpu_release_export *exports;
+	struct drm_crtc_state *crtc_state;
+	struct drm_crtc *crtc;
+	int i, count = 0, requested = 0, ret;
+
+	/* Existing consumers keep the original allocation/error path. */
+	for_each_new_crtc_in_state(state, crtc, crtc_state, i)
+		if (to_dpu_crtc_state(crtc_state)->release_fence_ptr)
+			++requested;
+	if (!requested)
+		return drm_atomic_helper_commit(dev, state, nonblock);
+
+	/* TEST_ONLY never calls atomic_commit: setter left the output at -1. */
+	exports = kcalloc(requested, sizeof(*exports), GFP_KERNEL);
+	if (!exports)
+		return -ENOMEM;
+
+	for_each_new_crtc_in_state(state, crtc, crtc_state, i) {
+		struct dpu_crtc_state *cstate = to_dpu_crtc_state(crtc_state);
+		struct dpu_release_timeline *timeline = &to_dpu_crtc(crtc)->release_timeline;
+		struct dpu_release_export *export;
+		struct dpu_release_fence *fence;
+		unsigned long flags;
+		u64 seq;
+
+		if (!cstate->release_fence_ptr)
+			continue;
+		export = &exports[count++];
+		export->fd = -1;
+		export->cstate = cstate;
+		export->ptr = u64_to_user_ptr(cstate->release_fence_ptr);
+
+		fence = kzalloc(sizeof(*fence), GFP_KERNEL);
+		if (!fence) {
+			ret = -ENOMEM;
+			goto finish;
+		}
+		spin_lock_init(&fence->lock);
+		INIT_LIST_HEAD(&fence->link);
+		spin_lock_irqsave(&timeline->lock, flags);
+		seq = ++timeline->next_fence;
+		spin_unlock_irqrestore(&timeline->lock, flags);
+		dma_fence_init(&fence->base, &dpu_release_ops, &fence->lock,
+			       timeline->context, seq);
+		cstate->release_fence = &fence->base;
+		export->sync = sync_file_create(&fence->base);
+		if (!export->sync) {
+			ret = -ENOMEM;
+			goto finish;
+		}
+		export->fd = get_unused_fd_flags(O_CLOEXEC);
+		if (export->fd < 0) {
+			ret = export->fd;
+			goto finish;
+		}
+		if (put_user(export->fd, export->ptr)) {
+			ret = -EFAULT;
+			goto finish;
+		}
+	}
+
+	/*
+	 * This is still the ioctl caller's fd table. The helper may run the
+	 * hardware tail on another thread, which must never install user fds.
+	 */
+	ret = drm_atomic_helper_commit(dev, state, nonblock);
+
+finish:
+	for (i = 0; i < count; ++i) {
+		struct dpu_release_export *export = &exports[i];
+
+		if (!ret) {
+			fd_install(export->fd, export->sync->file);
+		} else {
+			if (export->fd >= 0)
+				put_unused_fd(export->fd);
+			if (export->sync)
+				fput(export->sync->file);
+			dma_fence_put(export->cstate->release_fence);
+			export->cstate->release_fence = NULL;
+			if (put_user(-1, export->ptr))
+				drm_dbg_kms(dev, "release fence rollback pointer became invalid\n");
+		}
+	}
+	kfree(exports);
+	return ret;
+}
+
+void dpu_release_begin(struct drm_crtc *crtc, struct drm_atomic_state *state)
+{
+	struct dpu_crtc *dpu = to_dpu_crtc(crtc);
+	struct dpu_release_timeline *timeline = &dpu->release_timeline;
+	struct drm_crtc_state *new_state = drm_atomic_get_new_crtc_state(state, crtc);
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(new_state);
+	struct dpu_release_fence *fence;
+	unsigned long flags;
+
+	/* Cursor-only/async updates do not prove replacement of scanout buffers. */
+	if (state->legacy_cursor_update || state->async_update)
+		return;
+	spin_lock_irqsave(&timeline->lock, flags);
+	++timeline->commit_seq;
+	if (new_state->active)
+		timeline->disabled_verified = false;
+	timeline->commit_pending = true;
+	timeline->kicked = false;
+	timeline->wait_status = -EINPROGRESS;
+	if (cstate->release_fence) {
+		fence = container_of(cstate->release_fence, struct dpu_release_fence, base);
+		if (list_empty(&fence->link)) {
+			fence->commit_seq = timeline->commit_seq;
+			dma_fence_get(&fence->base);
+			list_add_tail(&fence->link, &timeline->pending);
+		}
+	}
+	spin_unlock_irqrestore(&timeline->lock, flags);
+}
+
+void dpu_release_kickoff(struct drm_crtc *crtc)
+{
+	WRITE_ONCE(to_dpu_crtc(crtc)->release_timeline.kicked, true);
+}
+
+void dpu_release_wait_result(struct drm_crtc *crtc, int status)
+{
+	WRITE_ONCE(to_dpu_crtc(crtc)->release_timeline.wait_status, status);
+}
+
+void dpu_release_disable(struct drm_crtc *crtc, u32 old_encoder_mask)
+{
+	struct dpu_release_timeline *timeline = &to_dpu_crtc(crtc)->release_timeline;
+	struct drm_encoder *encoder;
+	bool seen = false, stopped = true;
+
+	drm_for_each_encoder_mask(encoder, crtc->dev, old_encoder_mask) {
+		seen = true;
+		stopped &= dpu_encoder_video_stopped(encoder);
+	}
+	timeline->disabled_verified = seen && stopped;
+	if (timeline->disabled_verified)
+		dpu_release_signal(timeline, 0, true, 0);
+}
+
+void dpu_release_complete(struct drm_crtc *crtc)
+{
+	struct dpu_crtc *dpu = to_dpu_crtc(crtc);
+	struct dpu_release_timeline *timeline = &dpu->release_timeline;
+	bool disabled = !crtc->state->active && !crtc->state->self_refresh_active &&
+			!dpu->enabled && timeline->disabled_verified;
+
+	if (!timeline->commit_pending)
+		return;
+	/*
+	 * wait_flush timeouts are otherwise only logged by DPU. They cannot
+	 * retire old buffers. A later proven replacement or disable may do so.
+	 */
+	if (disabled || (timeline->kicked && !timeline->wait_status))
+		dpu_release_signal(timeline, timeline->commit_seq, disabled, 0);
+	timeline->commit_pending = false;
+}
