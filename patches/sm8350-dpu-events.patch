+int HWEventsDRM::OpenDrmEventFd() {
+  DRMMaster *master = nullptr;
+  int source = -1;
+  if (DRMMaster::GetInstance(&master) < 0 || !master) return -1;
+  master->GetHandle(&source);
+  if (source < 0) return -1;
+  char *path = drmGetDeviceNameFromFd2(source);
+  if (!path) return -1;
+  int fd = open(path, O_RDWR | O_CLOEXEC | O_NONBLOCK);
+  free(path);
+  if (fd < 0) return -1;
+  struct stat original = {}, reopened = {};
+  if (fstat(source, &original) || fstat(fd, &reopened) ||
+      !S_ISCHR(original.st_mode) || !S_ISCHR(reopened.st_mode) ||
+      original.st_rdev != reopened.st_rdev) {
+    close(fd);
+    return -1;
+  }
+  // A separate open owns a separate DRM event queue; dup would share the master's.
+  return fd;
+}
