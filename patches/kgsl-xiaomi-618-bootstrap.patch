--- a/drivers/gpu/msm/kgsl_bus.c
+++ b/drivers/gpu/msm/kgsl_bus.c
@@ -11,6 +11,59 @@
 #include "kgsl_bus.h"
 #include "kgsl_device.h"
 #include "kgsl_trace.h"
+
+/* Track the effective CPU vote separately from the GMU bandwidth index. */
+int kgsl_bus_set_icc(struct kgsl_device *device, u32 ab, u32 ib)
+{
+	struct kgsl_pwrctrl *pwr = &device->pwrctrl;
+	int ret;
+
+	if (IS_ERR_OR_NULL(pwr->icc_path))
+		return pwr->icc_path ? PTR_ERR(pwr->icc_path) : -ENODEV;
+	if (ab > U32_MAX / 1000)
+		return -ERANGE;
+	ib = max(ib, pwr->bootstrap_ib);
+	if (!pwr->icc_dirty && ab == pwr->cur_ab && ib == pwr->cur_ib)
+		return 0;
+
+	ret = icc_set_bw(pwr->icc_path, MBps_to_icc(ab), kBps_to_icc(ib));
+	if (ret) {
+		/* Provider rollback can fail too; retry even the cached old vote. */
+		pwr->icc_dirty = true;
+		return ret;
+	}
+	pwr->icc_dirty = false;
+	pwr->cur_ab = ab;
+	pwr->cur_ib = ib;
+	return 0;
+}
+
+/* GMU boot owns a temporary peak floor, including while HFI sets normal AB. */
+int kgsl_bus_vote_bootstrap(struct kgsl_device *device, bool on)
+{
+	struct kgsl_pwrctrl *pwr = &device->pwrctrl;
+	u32 old = pwr->bootstrap_ib, ib = 0;
+	int ret;
+
+	if (on) {
+		u32 level;
+
+		if (!pwr->num_pwrlevels || pwr->num_pwrlevels > KGSL_MAX_PWRLEVELS ||
+			pwr->default_pwrlevel >= pwr->num_pwrlevels ||
+			!pwr->ddr_table || pwr->ddr_table_count < 2)
+			return -EINVAL;
+		level = pwr->pwrlevels[pwr->default_pwrlevel].bus_min;
+		if (!level || level >= (u32)pwr->ddr_table_count || !pwr->ddr_table[level])
+			return -EINVAL;
+		ib = pwr->ddr_table[level];
+	}
+
+	pwr->bootstrap_ib = ib;
+	ret = kgsl_bus_set_icc(device, pwr->cur_ab, 0);
+	if (ret)
+		pwr->bootstrap_ib = old;
+	return ret;
+}
 
