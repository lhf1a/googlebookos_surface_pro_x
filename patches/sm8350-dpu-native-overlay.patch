+// The first Linux mixed strategy handles one opaque edge NV12 layer at 1:1 only.
+int Strategy::GetDpuOverlayIndex() const {
+  if (extension_intf_ || !hw_resource_info_.kernel_managed_dpu ||
+      !hw_resource_info_.num_vig_pipe || display_type_ != kBuiltIn || !hw_layers_info_ ||
+      !hw_layers_info_->stack || !hw_layers_info_->app_layer_count ||
+      hw_layers_info_->gpu_target_index != hw_layers_info_->app_layer_count ||
+      hw_layers_info_->stack->layers.size() != hw_layers_info_->app_layer_count + 1 ||
+      mixer_attributes_.width != fb_config_.x_pixels ||
+      mixer_attributes_.height != fb_config_.y_pixels ||
+      hw_panel_info_.panel_orientation.flip_horizontal ||
+      hw_panel_info_.panel_orientation.flip_vertical) return -1;
+  const auto &stack = *hw_layers_info_->stack;
+  if (stack.flags.secure_present || stack.flags.hdr_present || stack.flags.mask_present ||
+      stack.flags.s3d_mode_present) return -1;
+  for (const auto *layer : stack.layers) {
+    if (!layer || layer->flags.color_transform) return -1;
+  }
+  const Layer &target = *stack.layers[hw_layers_info_->gpu_target_index];
+  if (target.composition != kCompositionGPUTarget || target.plane_alpha != 255 ||
+      (target.input_buffer.format != kFormatRGBA8888 &&
+       target.input_buffer.format != kFormatRGBA8888Ubwc) ||
+      target.blending != kBlendingPremultiplied ||
+      !sde_drm::DpuColorSupported(false, target.input_buffer.color_metadata)) return -1;
+  auto formats = hw_resource_info_.supported_formats_map.find(kHWVIGPipe);
+  if (formats == hw_resource_info_.supported_formats_map.end()) return -1;
+  for (uint32_t index : {0u, hw_layers_info_->app_layer_count - 1}) {
+    const Layer &layer = *stack.layers[index];
+    const auto &buffer = layer.input_buffer;
+    if (layer.flags.skip || layer.flags.solid_fill || layer.flags.cursor ||
+        layer.plane_alpha != 255 || layer.blending != kBlendingOpaque ||
+        layer.transform.rotation || layer.transform.flip_horizontal || layer.transform.flip_vertical ||
+        buffer.format != kFormatYCbCr420SemiPlanarVenus ||
+        buffer.flags.secure || buffer.flags.secure_camera || buffer.flags.secure_display ||
+        buffer.flags.interlace || buffer.flags.hdr || buffer.flags.mask_layer ||
+        buffer.planes[0].fd < 0 || !buffer.buffer_id || !buffer.handle_id ||
+        !sde_drm::DpuColorSupported(true, buffer.color_metadata)) continue;
+    if (std::find(formats->second.begin(), formats->second.end(), buffer.format) == formats->second.end()) continue;
+    const auto &src = layer.src_rect;
+    const auto &dst = layer.dst_rect;
+    bool integral = true;
+    for (float value : {src.left, src.top, src.right, src.bottom, dst.left, dst.top, dst.right, dst.bottom})
+      integral &= std::isfinite(value) && value >= 0 && value == std::floor(value);
+    bool chroma_aligned = true;
+    for (float value : {src.left, src.top, src.right, src.bottom})
+      chroma_aligned &= std::isfinite(value) && std::fmod(value, 2.0f) == 0;
+    if (!integral || !chroma_aligned || !IsValid(src) || !IsValid(dst) ||
+        src.right > buffer.width || src.bottom > buffer.height ||
+        dst.right > fb_config_.x_pixels || dst.bottom > fb_config_.y_pixels ||
+        src.right - src.left != dst.right - dst.left ||
+        src.bottom - src.top != dst.bottom - dst.top) continue;
+    return int(index);
+  }
+  return -1;
 }
 
