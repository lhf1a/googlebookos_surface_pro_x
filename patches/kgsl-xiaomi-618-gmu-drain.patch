+int a6xx_gmu_unmap_buffer(struct a6xx_gmu_device *gmu, u32 addr, u32 size)
+{
+	int ret;
+
+	if (gmu->power_error)
+		return gmu->power_error;
+	if (!gmu->domain || !size || !IS_ALIGNED(addr, PAGE_SIZE) ||
+	    !IS_ALIGNED(size, PAGE_SIZE) || (u64)addr + size > U32_MAX) {
+		ret = -EINVAL;
+		goto retain;
+	}
+	if (iommu_unmap(gmu->domain, addr, size) != size) {
+		ret = -EUCLEAN;
+		goto retain;
+	}
+	ret = arm_smmu_flush_tlb_checked(gmu->domain);
+	if (!ret)
+		return 0;
+retain:
+	gmu->power_error = ret;
+	return ret;
+}
