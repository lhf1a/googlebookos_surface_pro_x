+/* Called only after stopping HFI/GPU access and before destroying its domain. */
+int a6xx_hwsched_free_gmu_imports(struct adreno_device *adreno_dev)
+{
+	struct a6xx_hwsched_hfi *hfi = to_a6xx_hwsched_hfi(adreno_dev);
+	struct a6xx_gmu_device *gmu = to_a6xx_gmu(adreno_dev);
+	unsigned int i;
+	int ret;
+
+	if (gmu->power_error)
+		return gmu->power_error;
+	if (hfi->mem_alloc_entries > ARRAY_SIZE(hfi->mem_alloc_table)) {
+		gmu->power_error = -EUCLEAN;
+		return gmu->power_error;
+	}
+	for (i = 0; i < hfi->mem_alloc_entries; i++) {
+		struct mem_alloc_entry *entry = &hfi->mem_alloc_table[i];
+		struct kgsl_memdesc *md = entry->gpu_md;
+
+		if (IS_ERR_OR_NULL(md) || (md->priv & KGSL_MEMDESC_MAP_UNCERTAIN)) {
+			gmu->power_error = -EUCLEAN;
+			return gmu->power_error;
+		}
+		if (!(md->priv & KGSL_MEMDESC_GMU_MAPPED))
+			continue;
+		ret = a6xx_gmu_unmap_buffer(gmu, entry->desc.gmu_addr, entry->desc.size);
+		if (ret) {
+			md->priv |= KGSL_MEMDESC_MAP_UNCERTAIN;
+			return ret;
+		}
+		md->priv &= ~KGSL_MEMDESC_GMU_MAPPED;
+	}
+	memset(hfi->mem_alloc_table, 0, sizeof(hfi->mem_alloc_table));
+	hfi->mem_alloc_entries = 0;
+	return 0;
 }
 
