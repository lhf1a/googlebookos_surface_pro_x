+        buffer.flags.interlace || buffer.flags.hdr || config.use_solidfill_stage ||
+        config.hw_rotator_session.mode != kRotatorNone ||
+        !sde_drm::DpuColorSupported(buffer.format >= kFormatYCbCr420Planar, buffer.color_metadata)) {
+      DLOGW("Layer %zu requires a feature outside the Linux DPU contract", i);
+      return kErrorNotSupported;
+    }
+  }
+  return kErrorNone;
