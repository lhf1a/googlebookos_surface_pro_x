diff -ruN userspace-a/libdrmutils/sde_mode_identity.h userspace-b/libdrmutils/sde_mode_identity.h
--- userspace-a/libdrmutils/sde_mode_identity.h	1970-01-01 08:00:00.000000000 +0800
+++ userspace-b/libdrmutils/sde_mode_identity.h	2026-11-11 15:29:23.000000000 +0800
