+int DRMCrtc::SetModeWithMetadata(drmModeAtomicReq *req, const drmModeModeInfo *mode,
+                                const sde_mode_identity *identity, uint32_t connector_id) {
+  if (!mode_request_property_) return SetMode(req, mode);
+  uint32_t prop_id = prop_mgr_.GetPropertyId(DRMProperty::MODE_ID);
+  if (!req || !prop_id) return -EINVAL;
+  if (mode && (!identity || !connector_id)) return -EINVAL;
+
+  /* Derive and validate the whole requested/derived/selected triple before any
+   * blob is published: the timing blob must be accompanied by the catalog row
+   * it was taken from, and a requested transition bit without a resolved row
+   * fails here instead of in atomic check (no partial apply). */
+  drmModeModeInfo timing {};
+  sde_mode_identity selected {};
+  struct sde_mode_request request {};
+  uint32_t mode_blob = 0, request_blob = 0;
+  if (mode) {
+    uint32_t requested = 0, request_connector = 0;
+    int ret = SDEPrepareModeRequest(mode, &timing, &requested);
+    if (ret) return ret;
+    ret = SDEModeResolveIdentity(identity, connector_id, requested, &request_connector,
+                                 &selected);
+    if (ret) return ret;
+    if (drmModeCreatePropertyBlob(fd_, &timing, sizeof(timing), &mode_blob))
+      return errno ? -errno : -EIO;
+    int build = SDEModeBuildRequest(mode, identity, connector_id, mode_blob, &request,
+                                    &timing);
+    if (build) {
+      drmModeDestroyPropertyBlob(fd_, mode_blob);
+      return build;
+    }
+  } else {
+    if (identity && (identity->generation || identity->row_id)) return -EINVAL;
+    if (connector_id) return -EINVAL;
+    int build = SDEModeBuildDisableRequest(&request);
+    if (build) return build;
+  }
+  if (drmModeCreatePropertyBlob(fd_, &request, sizeof(request), &request_blob)) {
+    int ret = errno ? -errno : -EIO;
+    if (mode_blob) drmModeDestroyPropertyBlob(fd_, mode_blob);
+    return ret;
+  }
+  int cursor = drmModeAtomicGetCursor(req);
+  int ret = drmModeAtomicAddProperty(req, drm_crtc_->crtc_id, mode_request_property_,
+                                    request_blob);
+  if (ret >= 0) ret = drmModeAtomicAddProperty(req, drm_crtc_->crtc_id, prop_id, mode_blob);
+  if (ret < 0) {
+    drmModeAtomicSetCursor(req, cursor);
+    drmModeDestroyPropertyBlob(fd_, request_blob);
+    if (mode_blob) drmModeDestroyPropertyBlob(fd_, mode_blob);
+    return ret;
+  }
+  /* Publish ownership only after both properties are in the request; the atomic
+   * request is reset at the end of Validate/Commit so no stale entry can still
+   * point at the blob destroyed by the next mode set. */
+  tmp_prop_val_map_[mode_request_property_] = request_blob;
+  tmp_prop_val_map_[prop_id] = mode_blob;
+  if (mode_request_blob_id_) drmModeDestroyPropertyBlob(fd_, mode_request_blob_id_);
+  mode_request_blob_id_ = request_blob;
+  SetModeBlobID(mode_blob);
+  return 0;
+}
