+/* SPDX-License-Identifier: MIT */
+/*
+ * Copyright (c) 2026 The Linux Foundation. All rights reserved.
+ *
+ * Driver-owned SDE mode identity and mode catalog UAPI.
+ *
+ * Linux 6.18 removed the downstream DRM_MODE_FLAG_SEAMLESS / VID_MODE_PANEL /
+ * CMD_MODE_PANEL high bits and rejects them in drm_mode_validate_basic(), and
+ * it no longer carries a driver private pointer inside struct
+ * drm_display_mode.  The QTI display mode cache therefore publishes its own
+ * per-connector catalog (this header) and accepts an explicit atomic request
+ * (sde_mode_request.h) that names one catalog row by an opaque identity.
+ *
+ * The catalog is immutable for one (connector_id, generation) pair.  A
+ * generation change invalidates every identity from the previous generation,
+ * so a stale userspace request is rejected instead of being resolved against a
+ * rebuilt cache.
+ */
+#ifndef _UAPI_SDE_MODE_IDENTITY_H_
+#define _UAPI_SDE_MODE_IDENTITY_H_
+
+#include <linux/types.h>
+
+/* Connector blob property carrying struct sde_mode_catalog_header + entries. */
+#define SDE_MODE_CATALOG_PROPERTY	"SDE_MODE_CATALOG_V1"
+
+#define SDE_MODE_CATALOG_VERSION	1U
+
+/* Panel interface kinds, replacing the removed VID/CMD core mode flags. */
+#define SDE_MODE_PANEL_NONE		0U
+#define SDE_MODE_PANEL_VIDEO		1U
+#define SDE_MODE_PANEL_COMMAND		2U
+
+/* Compression kinds as resolved by the DSI panel parser. */
+#define SDE_MODE_COMP_NONE		0U
+#define SDE_MODE_COMP_DSC		1U
+#define SDE_MODE_COMP_VDC		2U
+
+/**
+ * struct sde_mode_identity - opaque, generation-scoped mode cache row handle
+ * @generation: catalog generation the row belongs to
+ * @row_id:      one-based row in the catalog; zero means "no identity"
+ */
+struct sde_mode_identity {
+	__u32 generation;
+	__u32 row_id;
+};
+
+/**
+ * struct sde_mode_catalog_header - first element of the catalog blob
+ * @version:      SDE_MODE_CATALOG_VERSION
+ * @header_bytes: sizeof(struct sde_mode_catalog_header)
+ * @entry_bytes:  sizeof(struct sde_mode_catalog_entry)
+ * @count:        number of entries following the header
+ * @generation:   generation of the whole catalog
+ * @connector_id: DRM connector object id that owns the catalog
+ */
+struct sde_mode_catalog_header {
+	__u32 version;
+	__u32 header_bytes;
+	__u32 entry_bytes;
+	__u32 count;
+	__u32 generation;
+	__u32 connector_id;
+};
+
+/**
+ * struct sde_mode_catalog_entry - one mode including its driver-private caps
+ *
+ * The DRM connector mode list only carries public timing.  Everything the SDE
+ * driver used to reach through drm_display_mode::private - topology mixer
+ * count, compression, ROI caps, bit clock and allowed seamless transitions -
+ * is published here keyed by the mode identity.
+ */
+struct sde_mode_catalog_entry {
+	__u32 row_id;
+	__u32 panel_kind;
+	__u32 h_active;
+	__u32 v_active;
+	__u32 refresh_rate;		/* Hz */
+	__u32 pixel_clk_khz;
+	__u32 bit_clk_lo;		/* Hz, low 32 bits */
+	__u32 bit_clk_hi;		/* Hz, high 32 bits */
+	__u32 num_lm;
+	__u32 comp_type;
+	__u32 comp_ratio_numer;
+	__u32 comp_ratio_denom;
+	__u32 transfer_time_us;
+	__u32 allowed_mode_switch;	/* DSI_MODE_SWITCH_* bit mask */
+	__u32 roi_xstart;
+	__u32 roi_ystart;
+	__u32 roi_walign;
+	__u32 roi_halign;
+	__u32 roi_wmin;
+	__u32 roi_hmin;
+	__u32 roi_merge;
+	__u32 flags;
+};
+
+#endif /* _UAPI_SDE_MODE_IDENTITY_H_ */
