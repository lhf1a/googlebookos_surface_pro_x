diff -ruN userspace-a/sde-drm/sde_mode_request.h userspace-b/sde-drm/sde_mode_request.h
--- userspace-a/sde-drm/sde_mode_request.h	1970-01-01 08:00:00.000000000 +0800
+++ userspace-b/sde-drm/sde_mode_request.h	2026-11-11 15:29:23.000000000 +0800
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Copyright (c) 2026 The Linux Foundation. All rights reserved.
+ *
+ * Driver-owned SDE atomic mode request UAPI.
+ *
+ * The requested transition used to travel inside the public
+ * drm_display_mode::flags high bits of the MODE_ID blob.  Linux 6.18 rejects
+ * those bits before any driver callback, so the request is carried in a
+ * separate CRTC blob property instead.  The request is validated against the
+ * final atomic state, not against property ordering: the CRTC check verifies
+ * that the request's MODE_ID blob is the one the commit actually selects and
+ * the DSI bridge verifies that the identity exists in the current catalog.
+ */
+#ifndef _UAPI_SDE_MODE_REQUEST_H_
+#define _UAPI_SDE_MODE_REQUEST_H_
+
+#include <linux/types.h>
+#include "sde_mode_identity.h"
+
+/* CRTC blob property carrying struct sde_mode_request. */
+#define SDE_MODE_REQUEST_PROPERTY	"SDE_MODE_REQUEST_V1"
+
+#define SDE_MODE_WIRE_VERSION		1U
+
+/*
+ * One-shot transition requests.  A plain modeset sets neither bit.  The
+ * SEAMLESS bit must be backed by the catalog row caps, otherwise the request
+ * is rejected: an unsupported seamless transition is never silently ignored.
+ */
+#define SDE_MODE_REQ_SEAMLESS		(1U << 0)
+#define SDE_MODE_REQ_VIDEO		(1U << 1)
+#define SDE_MODE_REQ_COMMAND		(1U << 2)
+#define SDE_MODE_REQ_ALL		(SDE_MODE_REQ_SEAMLESS | \
+					 SDE_MODE_REQ_VIDEO | \
+					 SDE_MODE_REQ_COMMAND)
+
+/**
+ * struct sde_mode_request - one atomic transaction's requested mode
+ * @version:      SDE_MODE_WIRE_VERSION
+ * @bytes:        sizeof(struct sde_mode_request)
+ * @request:      SDE_MODE_REQ_* bits
+ * @mode_blob_id: core MODE_ID blob of the mode this request belongs to
+ * @connector_id: DRM connector object id the identity belongs to
+ * @identity:     catalog generation and row the request selects
+ * @reserved:     must be zero
+ */
+struct sde_mode_request {
+	__u32 version;
+	__u32 bytes;
+	__u32 request;
+	__u32 mode_blob_id;
+	__u32 connector_id;
+	struct sde_mode_identity identity;
+	__u32 reserved;
+};
+
+#endif /* _UAPI_SDE_MODE_REQUEST_H_ */
diff -ruN userspace-a/sde-drm/sde_mode_request_adapter.h userspace-b/sde-drm/sde_mode_request_adapter.h
--- userspace-a/sde-drm/sde_mode_request_adapter.h	1970-01-01 08:00:00.000000000 +0800
+++ userspace-b/sde-drm/sde_mode_request_adapter.h	2026-11-11 15:30:36.000000000 +0800
@@ -0,0 +1,266 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef _SDE_MODE_REQUEST_ADAPTER_H_
+#define _SDE_MODE_REQUEST_ADAPTER_H_
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "sde_mode_identity.h"
+#include "sde_mode_request.h"
+
+/* Adapter revision: aligned with the driver-owned SDE mode state port
+ * (sde_mode_identity.h / sde_mode_request.h wire v1, catalog v1). */
+#define SDE_MODE_REQUEST_ADAPTER_V3 1
+
+/* Userspace half of the SDE_MODE_REQUEST_V1 binding.
+ *
+ * The driver owns the requested/derived/selected mode state
+ * (techpack/display/msm/sde/sde_mode_state.h). Userspace may only submit:
+ *   selected  - the catalog identity (generation + one-based row) the derived
+ *               timing was taken from, plus the connector object it belongs to;
+ *   requested - the one-shot legacy QTI request bits (SEAMLESS/VIDEO/COMMAND),
+ *               never re-used as public DRM timing flags;
+ *   derived   - the public timing blob written to MODE_ID: the mode flags with
+ *               the three legacy QTI bits removed. 6.18 strips the PIC_AR bits
+ *               itself and validates the rest against DRM_MODE_FLAG_ALL.
+ *
+ * The payload is validated here with the same wire rules the kernel applies in
+ * sde_mode_state_ingest(), so userspace cannot stage a request the driver would
+ * only partially accept (blob/connector/identity mismatch, both panel kinds,
+ * reserved set, unknown request bits).
+ */
+
+/* 6.18 upstream DRM_MODE_FLAG_ALL: PHSYNC..HSKEW, DBLCLK/CLKDIV2, the 3D
+ * selection and the RGB/YUV driver support bits. */
+static const uint32_t kSDEModePublicTimingFlags =
+    (0x3ffU) | (1U << 12) | (1U << 13) | (0x1fU << 14) | (1U << 27) | (1U << 28);
+/* 6.18 drm_mode_convert_umode() strips DRM_MODE_FLAG_PIC_AR_MASK itself. */
+static const uint32_t kSDEModeAspectFlags = (0x0fU << 19);
+/* Downstream-only legacy QTI bits; transport them as requested state only. */
+static const uint32_t kSDEModeLegacyPanelFlags = (1U << 29) | (1U << 30);
+static const uint32_t kSDEModeLegacySeamlessFlag = (1U << 31);
+static const uint32_t kSDEModeLegacyFlags =
+    kSDEModeLegacyPanelFlags | kSDEModeLegacySeamlessFlag;
+
+/* Timing flags as accepted from a mode list or a caller: public 6.18 flags,
+ * aspect-ratio bits and the legacy QTI request bits. Nothing else. */
+static inline int SDEModeValidateTimingFlags(uint32_t flags)
+{
+  if (flags & ~(kSDEModePublicTimingFlags | kSDEModeAspectFlags | kSDEModeLegacyFlags))
+    return -EINVAL;
+  uint32_t panel = flags & kSDEModeLegacyPanelFlags;
+  if (panel == kSDEModeLegacyPanelFlags)
+    return -EINVAL;
+  return 0;
+}
+
+/* Timing flags the driver catalog may advertise: the selected panel kind has
+ * its own wire field, so a catalog row never carries the legacy bits. */
+static inline int SDEModeValidateCatalogTimingFlags(uint32_t flags)
+{
+  if (flags & (kSDEModeLegacyFlags | ~(kSDEModePublicTimingFlags | kSDEModeAspectFlags)))
+    return -EINVAL;
+  return 0;
+}
+
+static inline uint32_t SDEModeDerivedTimingFlags(uint32_t flags)
+{
+  return flags & ~kSDEModeLegacyFlags;
+}
+
+/* requested state derived from the legacy QTI mode flags. */
+static inline uint32_t SDEModeRequestedBits(uint32_t flags)
+{
+  return ((flags & kSDEModeLegacySeamlessFlag) ? SDE_MODE_REQ_SEAMLESS : 0) |
+         ((flags & (1U << 29)) ? SDE_MODE_REQ_VIDEO : 0) |
+         ((flags & (1U << 30)) ? SDE_MODE_REQ_COMMAND : 0);
+}
+
+static inline uint32_t SDEModeRequestPanelKind(uint32_t request)
+{
+  uint32_t panels = request & (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND);
+  if (panels == SDE_MODE_REQ_VIDEO)
+    return SDE_MODE_PANEL_VIDEO;
+  if (panels == SDE_MODE_REQ_COMMAND)
+    return SDE_MODE_PANEL_COMMAND;
+  return SDE_MODE_PANEL_NONE;
+}
+
+/* Builds the derived timing plus the requested bits. The legacy bits are moved
+ * out of the public timing; the rest of the flags are preserved. */
+static inline int SDEPrepareModeRequest(const drmModeModeInfo *mode,
+                                        drmModeModeInfo *timing, uint32_t *request)
+{
+  if (!mode || !timing || !request)
+    return -EINVAL;
+  uint32_t flags = mode->flags;
+  int ret = SDEModeValidateTimingFlags(flags);
+  if (ret)
+    return ret;
+  *timing = *mode;
+  *request = SDEModeRequestedBits(flags);
+  timing->flags = SDEModeDerivedTimingFlags(flags);
+  return 0;
+}
+
+/* Resolves the catalog identity that backs this request. A row identity is
+ * generation-scoped (row 0 means "no identity"), and a requested transition
+ * without a resolved row cannot be validated against the row caps, so it is
+ * refused here instead of failing later in atomic check. */
+static inline int SDEModeResolveIdentity(const sde_mode_identity *catalog_identity,
+                                         uint32_t connector_id, uint32_t request,
+                                         uint32_t *request_connector,
+                                         sde_mode_identity *selected)
+{
+  if (!request_connector || !selected || !connector_id)
+    return -EINVAL;
+  sde_mode_identity identity = {};
+  if (catalog_identity)
+    identity = *catalog_identity;
+  if (!!identity.generation != !!identity.row_id)
+    return -EINVAL;
+  if (request && (!identity.generation || !identity.row_id))
+    return -EOPNOTSUPP;
+  *request_connector = connector_id;
+  *selected = identity;
+  return 0;
+}
+
+/* Same wire acceptance rules as the kernel's sde_mode_state_ingest(). */
+static inline int SDEModeValidateRequest(const struct sde_mode_request *request,
+                                         size_t len)
+{
+  if (!request)
+    return -EINVAL;
+  if (len != sizeof(*request))
+    return -EINVAL;
+  if (request->version != SDE_MODE_WIRE_VERSION)
+    return -EINVAL;
+  if (request->bytes != sizeof(*request) || request->reserved)
+    return -EINVAL;
+  if (request->request & ~SDE_MODE_REQ_ALL)
+    return -EINVAL;
+  uint32_t panels = request->request & (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND);
+  if (panels == (SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND))
+    return -EINVAL;
+  if (!request->mode_blob_id) {
+    if (request->request || request->connector_id || request->identity.generation ||
+        request->identity.row_id)
+      return -EINVAL;
+  } else if (!request->connector_id) {
+    return -EINVAL;
+  }
+  return 0;
+}
+
+/* Mirrors the final-state binding the driver checks in sde_mode_state_commit():
+ * the request must name the MODE_ID blob the commit selects, and the bridge must
+ * have a validated catalog row for it. */
+static inline int SDEModeCheckSelection(const struct sde_mode_request *request,
+                                        uint32_t mode_blob_id)
+{
+  int ret = SDEModeValidateRequest(request, sizeof(*request));
+  if (ret)
+    return ret;
+  if (!mode_blob_id || request->mode_blob_id != mode_blob_id)
+    return -EINVAL;
+  if (!request->identity.generation || !request->identity.row_id)
+    return -EINVAL;
+  return 0;
+}
+
+/* Derives the timing and the selected identity before a blob id exists. */
+static inline int SDEModePrepareRequested(const drmModeModeInfo *mode,
+                                          const sde_mode_identity *catalog_identity,
+                                          uint32_t connector_id,
+                                          drmModeModeInfo *timing,
+                                          uint32_t *request_connector,
+                                          sde_mode_identity *selected,
+                                          uint32_t *requested_bits)
+{
+  if (!mode || !timing || !request_connector || !selected || !requested_bits)
+    return -EINVAL;
+  int ret = SDEPrepareModeRequest(mode, timing, requested_bits);
+  if (ret)
+    return ret;
+  return SDEModeResolveIdentity(catalog_identity, connector_id, *requested_bits,
+                                request_connector, selected);
+}
+
+static inline int SDEModeBuildRequest(const drmModeModeInfo *mode,
+                                      const sde_mode_identity *catalog_identity,
+                                      uint32_t connector_id, uint32_t mode_blob_id,
+                                      struct sde_mode_request *request,
+                                      drmModeModeInfo *timing)
+{
+  if (!mode || !request || !timing || !mode_blob_id || !connector_id)
+    return -EINVAL;
+  uint32_t requested = 0;
+  uint32_t request_connector = 0;
+  sde_mode_identity selected = {};
+  int ret = SDEPrepareModeRequest(mode, timing, &requested);
+  if (ret)
+    return ret;
+  ret = SDEModeResolveIdentity(catalog_identity, connector_id, requested,
+                               &request_connector, &selected);
+  if (ret)
+    return ret;
+  memset(request, 0, sizeof(*request));
+  request->version = SDE_MODE_WIRE_VERSION;
+  request->bytes = sizeof(*request);
+  request->request = requested;
+  request->mode_blob_id = mode_blob_id;
+  request->connector_id = request_connector;
+  request->identity = selected;
+  return SDEModeValidateRequest(request, sizeof(*request));
+}
+
+/* A disable is a request with no timing blob, no requested bits, no identity
+ * and no connector; it stays distinct from a mode with an empty request. */
+static inline int SDEModeBuildDisableRequest(struct sde_mode_request *request)
+{
+  if (!request)
+    return -EINVAL;
+  memset(request, 0, sizeof(*request));
+  request->version = SDE_MODE_WIRE_VERSION;
+  request->bytes = sizeof(*request);
+  return SDEModeValidateRequest(request, sizeof(*request));
+}
+
+/* Per-atomic-request staging guard.
+ *
+ * One requested/selected transition per transaction: a second serialization is
+ * refused as a double apply, and any serialization failure latches so Validate
+ * or Commit cannot submit a partially built request. The guard is consumed when
+ * the transaction finishes, so the next Validate/Commit pass starts clean. */
+class SDEModeRequestStage {
+ public:
+  int Begin()
+  {
+    if (staged_)
+      return -EALREADY;
+    return error_;
+  }
+  void Accept() { staged_ = true; }
+  void Fail(int error)
+  {
+    staged_ = false;
+    if (!error_)
+      error_ = error ? error : -EINVAL;
+  }
+  int Finish()
+  {
+    int error = error_;
+    error_ = 0;
+    staged_ = false;
+    return error;
+  }
+  bool staged() const { return staged_; }
+  int error() const { return error_; }
+
+ private:
+  bool staged_ = false;
+  int error_ = 0;
+};
+
+#endif
