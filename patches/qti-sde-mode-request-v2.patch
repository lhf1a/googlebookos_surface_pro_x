+
+int DRMCrtc::SetMode(drmModeAtomicReq *req, const drmModeModeInfo *mode) {
+  /* A CRTC with the typed request property accepts modes only through
+   * CRTC_SET_MODE_WITH_METADATA; the legacy MODE_ID-only path is reserved for
