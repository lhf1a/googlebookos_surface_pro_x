+int DRMCrtcManager::SetModeWithMetadata(uint32_t obj_id, drmModeAtomicReq *req,
+                                       const drmModeModeInfo *mode,
+                                       const sde_mode_identity *identity,
+                                       uint32_t connector_id) {
+  lock_guard<mutex> lock(lock_);
