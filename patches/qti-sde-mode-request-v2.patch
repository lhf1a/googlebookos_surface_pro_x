+int DRMConnector::ParseModeCatalog(uint64_t blob_id, DRMConnectorInfo *info) {
+  drmModePropertyBlobRes *blob = drmModeGetPropertyBlob(fd_, blob_id);
+  if (!blob || !blob->data) {
+    if (blob) drmModeFreePropertyBlob(blob);
+    return -EINVAL;
+  }
+  sde_mode_catalog_header header {};
+  int ret = -EINVAL;
+  if (blob->length < sizeof(header)) goto out;
+  memcpy(&header, blob->data, sizeof(header));
+  if (header.version != SDE_MODE_CATALOG_VERSION ||
+      header.header_bytes != sizeof(header) ||
+      header.entry_bytes != sizeof(sde_mode_catalog_entry) ||
+      !header.generation || header.connector_id != drm_connector_->connector_id ||
+      (blob->length - sizeof(header)) % sizeof(sde_mode_catalog_entry) ||
+      header.count != (blob->length - sizeof(header)) / sizeof(sde_mode_catalog_entry) ||
+      blob->length != sizeof(header) + size_t(header.count) * sizeof(sde_mode_catalog_entry))
+    goto out;
+  /* The catalog carries driver-private caps and identities only; the public
+   * timing stays in the connector mode list and each row is bound to exactly
+   * one exported mode by its timing. */
+  for (uint32_t i = 0; i < header.count; i++) {
+    sde_mode_catalog_entry entry {};
+    memcpy(&entry,
+           static_cast<const char *>(blob->data) + sizeof(header) + size_t(i) * sizeof(entry),
+           sizeof(entry));
+    if (entry.row_id != i + 1 || entry.panel_kind > SDE_MODE_PANEL_COMMAND ||
+        entry.comp_type > SDE_MODE_COMP_VDC ||
+        (entry.comp_type != SDE_MODE_COMP_NONE && !entry.comp_ratio_denom) ||
+        entry.roi_merge > 1 || !entry.h_active || !entry.v_active ||
+        !entry.refresh_rate || !entry.pixel_clk_khz)
+      goto out;
+    DRMModeInfo *match = nullptr;
+    for (auto &item : info->modes) {
+      if (item.mode.hdisplay != entry.h_active || item.mode.vdisplay != entry.v_active ||
+          item.mode.vrefresh != entry.refresh_rate ||
+          item.mode.clock != entry.pixel_clk_khz)
+        continue;
+      if (match) {
+        /* Two rows with the same timing cannot be bound to one public mode;
+         * refuse instead of guessing which driver payload was selected. */
+        DRM_LOGE("Ambiguous mode catalog row %u on connector %d", entry.row_id,
+                 drm_connector_->connector_id);
+        goto out;
+      }
+      match = &item;
+    }
+    if (!match) {
+      DRM_LOGE("Mode catalog row %u has no exported mode on connector %d", entry.row_id,
+               drm_connector_->connector_id);
+      goto out;
+    }
+    match->mode_identity.generation = header.generation;
+    match->mode_identity.row_id = entry.row_id;
+    // Legacy panel discriminator stays only in driver-owned SDM records.
+    if (entry.panel_kind == SDE_MODE_PANEL_VIDEO) match->mode.flags |= (1U << 29);
+    if (entry.panel_kind == SDE_MODE_PANEL_COMMAND) match->mode.flags |= (1U << 30);
+    match->bit_clk_rate = (uint64_t(entry.bit_clk_hi) << 32) | entry.bit_clk_lo;
+    match->transfer_time_us = entry.transfer_time_us;
+    match->allowed_mode_switch = entry.allowed_mode_switch;
+    /* catalog v1 publishes the layer-mixer count, not the topology enum */
+    if (entry.num_lm == 1) match->topology = DRMTopology::SINGLE_LM;
+    else if (entry.num_lm == 2) match->topology = DRMTopology::DUAL_LM;
+    else if (entry.num_lm == 4) match->topology = DRMTopology::QUAD_LM_MERGE;
+    else match->topology = DRMTopology::UNKNOWN;
+    match->xstart = entry.roi_xstart; match->ystart = entry.roi_ystart;
+    match->walign = entry.roi_walign; match->halign = entry.roi_halign;
+    match->wmin = entry.roi_wmin; match->hmin = entry.roi_hmin;
+    match->roi_merge = entry.roi_merge != 0;
+  }
+  ret = 0;
+out:
+  drmModeFreePropertyBlob(blob);
+  return ret;
+}
