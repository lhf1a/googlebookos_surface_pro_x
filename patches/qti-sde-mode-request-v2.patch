+void DRMAtomicReq::ResetAtomicRequest() {
+  /* Drop the previous transaction's properties instead of only rewinding the
+   * cursor: a shorter follow-up transaction must not leave stale MODE_ID or
+   * mode request properties behind that a later commit would still apply. */
+  drmModeAtomicReq *fresh = drmModeAtomicAlloc();
+  if (!fresh) {
+    DRM_LOGE("Atomic request reset allocation failed; stale properties cannot be dropped");
+    if (drm_atomic_req_) {
+      drmModeAtomicSetCursor(drm_atomic_req_, 0);
+    }
+    return;
+  }
+  if (drm_atomic_req_) {
+    drmModeAtomicFree(drm_atomic_req_);
+  }
+  drm_atomic_req_ = fresh;
+}
