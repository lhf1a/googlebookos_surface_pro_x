+static int __init kgsl_worker_init(void)
+{
+	const struct sched_attr attr = {
+		.size = sizeof(attr),
+		.sched_policy = SCHED_FIFO,
+		.sched_priority = 2,
+	};
+	struct task_struct *thread;
+	int ret;
+
+	kthread_init_worker(&kgsl_driver.worker);
+	thread = kthread_create(kthread_worker_fn, &kgsl_driver.worker,
+		"kgsl_worker_thread");
+	if (IS_ERR(thread))
+		return PTR_ERR(thread);
+
+	/* Set the driver's original priority before the worker can execute. */
+	ret = sched_setattr_nocheck(thread, &attr);
+	if (ret) {
+		kthread_stop(thread);
+		return ret;
+	}
+
+	kgsl_driver.worker_thread = thread;
+	wake_up_process(thread);
+	return 0;
+}
+
+static void kgsl_worker_close(void)
+{
+	/* Device removal must have stopped all dispatcher/HWSCHED producers. */
+	if (kgsl_driver.worker_thread) {
+		kthread_flush_worker(&kgsl_driver.worker);
+		kthread_stop(kgsl_driver.worker_thread);
+		kgsl_driver.worker_thread = NULL;
+	}
+}
+
