--- a/kernel/drivers/base/power/main.c
+++ b/kernel/drivers/base/power/main.c
@@ -34,6 +34,7 @@
 #include <linux/cpufreq.h>
 #include <linux/devfreq.h>
 #include <linux/timer.h>
+#include <linux/moduleparam.h>
 
 #include "../base.h"
 #include "power.h"
@@ -65,6 +66,57 @@
 static pm_message_t pm_transition;
 
 static int async_error;
+
+/* Off by default; never a substitute for successful full suspend/resume. */
+extern bool sq1_pm_prefix_permitted(void);
+static bool sq1_pm_prefix;
+static unsigned int sq1_pm_prepare_limit, sq1_pm_suspend_limit;
+core_param(sq1_pm_prefix, sq1_pm_prefix, bool, 0444);
+core_param(sq1_pm_prepare_limit, sq1_pm_prepare_limit, uint, 0600);
+core_param(sq1_pm_suspend_limit, sq1_pm_suspend_limit, uint, 0600);
+static bool sq1_prefix_active;
+static unsigned int sq1_prepare_budget, sq1_suspend_budget;
+static unsigned int sq1_prepare_seen, sq1_suspend_seen;
+
+static int sq1_prefix_begin(void)
+{
+    sq1_prefix_active = false;
+    if (!sq1_pm_prefix)
+        return 0;
+    if (!sq1_pm_prefix_permitted())
+        return -EPERM;
+    if (pm_async_enabled)
+        return -EINVAL;
+    sq1_prepare_budget = READ_ONCE(sq1_pm_prepare_limit);
+    sq1_suspend_budget = READ_ONCE(sq1_pm_suspend_limit);
+    if (sq1_prepare_budget > 4096 || sq1_suspend_budget > 4096)
+        return -EINVAL;
+    sq1_prepare_seen = sq1_suspend_seen = 0;
+    sq1_prefix_active = true;
+    pr_info("SQ1_PREFIX_BEGIN prepare=%u suspend=%u\n",
+        sq1_prepare_budget, sq1_suspend_budget);
+    return 0;
+}
+
+static int sq1_prefix_gate(struct device *dev, bool preparing)
+{
+    unsigned int *seen = preparing ? &sq1_prepare_seen : &sq1_suspend_seen;
+    unsigned int budget = preparing ? sq1_prepare_budget : sq1_suspend_budget;
+    const char *phase = preparing ? "prepare" : "suspend";
+
+    if (!sq1_prefix_active)
+        return 0;
+    if (*seen >= budget) {
+        pr_info("SQ1_PREFIX_STOP %s index=%u dev=%s\n", phase, *seen,
+            dev_name(dev));
+        return -ECANCELED; /* Not -EAGAIN: dpm_prepare would retry forever. */
+    }
+    pr_info("SQ1_PREFIX_ENTER %s index=%u dev=%s\n", phase, *seen,
+        dev_name(dev));
+    ++*seen;
+    return 0;
+}
+
 
 static const char *pm_verb(int event)
 {
@@ -1772,7 +1824,9 @@
 
 		mutex_unlock(&dpm_list_mtx);
 
-		error = device_suspend(dev);
+		error = sq1_prefix_gate(dev, false);
+		if (!error)
+			error = device_suspend(dev);
 
 		mutex_lock(&dpm_list_mtx);
 
@@ -1910,7 +1964,9 @@
 		mutex_unlock(&dpm_list_mtx);
 
 		trace_device_pm_callback_start(dev, "", state.event);
-		error = device_prepare(dev, state);
+		error = sq1_prefix_gate(dev, true);
+		if (!error)
+			error = device_prepare(dev, state);
 		trace_device_pm_callback_end(dev, error);
 
 		mutex_lock(&dpm_list_mtx);
@@ -1949,12 +2005,16 @@
 	ktime_t starttime = ktime_get();
 	int error;
 
+	error = sq1_prefix_begin();
+	if (error)
+		return error;
 	error = dpm_prepare(state);
 	if (error) {
 		suspend_stats.failed_prepare++;
 		dpm_save_failed_step(SUSPEND_PREPARE);
 	} else
 		error = dpm_suspend(state);
+	sq1_prefix_active = false;
 	dpm_show_time(starttime, state, error, "start");
 	return error;
 }
