+// Android graphics/common Dataspace documents the YUV KR/KB interpretation.
+// QTI color_metadata.h explicitly distinguishes adjusted/unadjusted BT.601.
+// RGB storage is identity; a primaries-only standard is not a YUV matrix contract.
+static bool GetSDMColorMatrix(int32_t dataspace, LayerBufferFormat format,
+                              MatrixCoEfficients *matrix) {
+  if (format == kFormatInvalid) return false;
+  *matrix = MatrixCoEff_Identity;
+  if (format < kFormatYCbCr420Planar) return true;
+  switch (dataspace & HAL_DATASPACE_STANDARD_MASK) {
+    case HAL_DATASPACE_STANDARD_BT709:
+      *matrix = MatrixCoEff_BT709_5;
+      return true;
+    case HAL_DATASPACE_STANDARD_BT601_525:
+      *matrix = MatrixCoEff_BT601_6_525;
+      return true;
+    case HAL_DATASPACE_STANDARD_BT601_625:
+      *matrix = MatrixCoEff_BT601_6_625;
+      return true;
+    case HAL_DATASPACE_STANDARD_BT601_525_UNADJUSTED:
+      *matrix = MatrixCoEff_SMPTE240M;  // Android: KR=0.212, KB=0.087.
+      return true;
+    case HAL_DATASPACE_STANDARD_BT601_625_UNADJUSTED:
+      *matrix = MatrixCoEff_BT601_6_Unadjusted;  // QTI: KR=0.222, KB=0.071.
+      return true;
+    case HAL_DATASPACE_STANDARD_BT2020:
+      *matrix = MatrixCoEff_BT2020;  // Non-constant luminance.
+      return true;
+    default:
+      return false;
+  }
+}
