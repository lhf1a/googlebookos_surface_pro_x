+/* SPDX-License-Identifier: MIT */
+#ifndef _UAPI_SDE_MODE_REQUEST_H_
+#define _UAPI_SDE_MODE_REQUEST_H_
+/* SDE_MODE_REQUEST: upper32 MODE_ID blob id, lower32 request bits.
+ * The final atomic state validates the binding, independent of set order.
+ * This staging ABI requires matching userspace and a completed DSI consumer port.
+ */
+#define SDE_MODE_REQUEST_PROPERTY "SDE_MODE_REQUEST"
+#define SDE_MODE_REQ_SEAMLESS (1U << 0)
+#define SDE_MODE_REQ_VIDEO (1U << 1)
+#define SDE_MODE_REQ_COMMAND (1U << 2)
+#define SDE_MODE_REQ_ALL (SDE_MODE_REQ_SEAMLESS | SDE_MODE_REQ_VIDEO | SDE_MODE_REQ_COMMAND)
+#endif
