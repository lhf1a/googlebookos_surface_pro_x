+int DRMCrtc::SetMode(drmModeAtomicReq *req, const drmModeModeInfo *mode) {
+  uint32_t obj_id = drm_crtc_->crtc_id;
+  uint32_t prop_id = prop_mgr_.GetPropertyId(DRMProperty::MODE_ID);
+  uint32_t blob_id = 0, request = 0;
+  drmModeModeInfo timing = {};
+  const drmModeModeInfo *submitted = mode;
+  if (!prop_id || !req)
+    return -EINVAL;
+  if (mode_request_property_ && mode) {
+    int ret = SDEPrepareModeRequest(mode, &timing, &request);
+    if (ret)
+      return ret;
+    submitted = &timing;
+  }
+  /* Missing property is legacy compatibility, not silently stripped flags. */
+  if (submitted && drmModeCreatePropertyBlob(fd_, submitted,
+                                             sizeof(*submitted), &blob_id))
+    return errno ? -errno : -EIO;
+  int cursor = drmModeAtomicGetCursor(req);
+  int ret = 0;
+  if (mode_request_property_)
+    ret = drmModeAtomicAddProperty(req, obj_id, mode_request_property_,
+                                  (uint64_t(blob_id) << 32) | request);
+  if (ret >= 0)
+    ret = drmModeAtomicAddProperty(req, obj_id, prop_id, blob_id);
+  if (ret < 0) {
+    drmModeAtomicSetCursor(req, cursor);
+    if (blob_id)
+      drmModeDestroyPropertyBlob(fd_, blob_id);
+    return ret;
+  }
+  tmp_prop_val_map_[prop_id] = blob_id;
+  if (mode_request_property_)
+    tmp_prop_val_map_[mode_request_property_] = (uint64_t(blob_id) << 32) | request;
+  SetModeBlobID(blob_id);
+  return 0;
+}
+
+int DRMCrtcManager::SetMode(uint32_t obj_id, drmModeAtomicReq *req,
+                            const drmModeModeInfo *mode) {
+  lock_guard<mutex> lock(lock_);
+  auto it = crtc_pool_.find(obj_id);
+  if (it == crtc_pool_.end())
+    return -EINVAL;
+  return it->second->SetMode(req, mode);
+}
