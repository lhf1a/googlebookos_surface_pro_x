+static int arm_smmu_tlb_inv_walk_s1_checked(unsigned long iova, size_t size,
+					  size_t granule, void *cookie)
+{
+	struct arm_smmu_domain *domain = cookie;
+	struct arm_smmu_device *smmu = domain->smmu;
+	struct arm_smmu_cfg *cfg = &domain->cfg;
+	unsigned long flags;
+	int ret;
+
+	if (!READ_ONCE(domain->checked_unmap)) {
+		arm_smmu_tlb_inv_walk_s1(iova, size, granule, cookie);
+		return 0;
+	}
+
+	/* map/unmap hold runtime PM; the io-pgtable callback cannot sleep. */
+	spin_lock_irqsave(&domain->cb_lock, flags);
+	wmb();
+	arm_smmu_cb_write(smmu, cfg->cbndx, ARM_SMMU_CB_S1_TLBIASID, cfg->asid);
+	ret = smmu->impl->tlb_sync_checked(smmu,
+			ARM_SMMU_CB(smmu, cfg->cbndx),
+			ARM_SMMU_CB_TLBSYNC, ARM_SMMU_CB_TLBSTATUS);
+	spin_unlock_irqrestore(&domain->cb_lock, flags);
+	return ret;
+}
