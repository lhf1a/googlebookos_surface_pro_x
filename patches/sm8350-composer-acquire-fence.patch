+  // Pin the sync_file before validation; an errored sync_file is still a valid fence.
+  Error readFence(shared_ptr<Fence>* fence, const string &name) {
+    fence->reset();
+    int32_t index = readSigned();
+    if (index == static_cast<int32_t>(IQtiComposerClient::HandleIndex::EMPTY)) {
+      return Error::NONE;
+    }
+    if (index < 0 || static_cast<size_t>(index) >= mDataHandles.size()) {
+      return Error::BAD_PARAMETER;
+    }
+    const auto *handle = mDataHandles[index].getNativeHandle();
+    if (!handle || handle->numInts != 0) return Error::BAD_PARAMETER;
+    if (handle->numFds == 0) return Error::NONE;
+    if (handle->numFds != 1) return Error::BAD_PARAMETER;
+
+    int fd;
+    do { fd = fcntl(handle->data[0], F_DUPFD_CLOEXEC, 0); } while (fd < 0 && errno == EINTR);
+    if (fd < 0) return errno == EBADF ? Error::BAD_PARAMETER : Error::NO_RESOURCES;
+    struct sync_file_info info = {};
+    int result;
+    do { result = ioctl(fd, SYNC_IOC_FILE_INFO, &info); } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+      const int error = errno;
+      close(fd);
+      return error == ENOMEM ? Error::NO_RESOURCES : Error::BAD_PARAMETER;
+    }
+    *fence = Fence::Create(fd, name);
+    return *fence ? Error::NONE : Error::NO_RESOURCES;
   }
 
