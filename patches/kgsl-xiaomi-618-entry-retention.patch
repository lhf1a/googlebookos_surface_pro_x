+/* Do not replay failed unmaps: a backend may have removed only a prefix. */
+static LIST_HEAD(kgsl_retained_entries);
+static DEFINE_MUTEX(kgsl_retained_lock);
+
+static void kgsl_mem_entry_retain(struct kgsl_mem_entry *entry, int error)
+{
+	mutex_lock(&kgsl_retained_lock);
+	if (!entry->release_error) {
+		entry->release_error = error;
+		entry->retained_pt = entry->memdesc.pagetable;
+		if (entry->retained_pt)
+			kref_get(&entry->retained_pt->refcount);
+		__module_get(THIS_MODULE);
+		list_add_tail(&entry->retained_node, &kgsl_retained_entries);
+		pr_err("KGSL: retaining failed release gpuaddr=%llx size=%llu error=%d\n",
+			entry->memdesc.gpuaddr, entry->memdesc.size, error);
+	}
+	mutex_unlock(&kgsl_retained_lock);
+}
+
+int kgsl_retained_mem_show(struct seq_file *s, void *unused)
+{
+	struct kgsl_mem_entry *entry;
+
+	seq_puts(s, "pagetable gpuaddr size error\n");
+	mutex_lock(&kgsl_retained_lock);
+	list_for_each_entry(entry, &kgsl_retained_entries, retained_node)
+		seq_printf(s, "%u %llx %llu %d\n",
+			entry->retained_pt ? entry->retained_pt->name : 0,
+			entry->memdesc.gpuaddr, entry->memdesc.size,
+			entry->release_error);
+	mutex_unlock(&kgsl_retained_lock);
+	return 0;
+}
+
+/* Allocation errors have not yet charged the process accounting. */
+static void kgsl_mem_entry_free_unattached(struct kgsl_mem_entry *entry)
+{
+	int ret;
+
+	if (entry->release_error)
+		return;
+	ret = kgsl_sharedmem_free(&entry->memdesc);
+	if (ret) {
+		kgsl_mem_entry_retain(entry, ret);
+		return;
+	}
+	kfree(entry);
+}
