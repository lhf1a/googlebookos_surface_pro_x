+static int kgsl_request_gpu_irq(struct kgsl_device *device)
+{
+	struct platform_device *pdev = device->pdev;
+	int irq, ret;
+
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,adreno-680.1"))
+		irq = platform_get_irq(pdev, 0);
+	else
+		irq = platform_get_irq_byname(pdev, "kgsl_3d0_irq");
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(&pdev->dev, irq, kgsl_irq_handler,
+		IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN, "kgsl_3d0_irq", device);
+	return ret ? ret : irq;
+}
