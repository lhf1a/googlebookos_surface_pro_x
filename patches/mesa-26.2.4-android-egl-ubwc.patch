@@ -227,6 +227,41 @@ droid_window_cancel_buffer(struct dri2_egl_surface *dri2_surf)
    close_in_fence_fd(dri2_surf);
 }
 
+#ifndef SQ2_GRALLOC_USAGE_PRIVATE_ALLOC_UBWC
+#define SQ2_GRALLOC_USAGE_PRIVATE_ALLOC_UBWC 0x10000000U
+#endif
+
+static bool
+droid_format_supports_qti_ubwc(int format)
+{
+   switch (format) {
+   case HAL_PIXEL_FORMAT_RGBA_8888:
+   case HAL_PIXEL_FORMAT_RGBX_8888:
+   case HAL_PIXEL_FORMAT_RGBA_FP16:
+   case HAL_PIXEL_FORMAT_RGBA_1010102:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+droid_wants_qti_ubwc(const struct dri2_egl_display *dri2_dpy, int format)
+{
+   if (!dri2_dpy || !dri2_dpy->driver_name)
+      return false;
+   if (strcmp(dri2_dpy->driver_name, "msm") != 0 &&
+       strcmp(dri2_dpy->driver_name, "freedreno") != 0)
+      return false;
+   if (!droid_format_supports_qti_ubwc(format))
+      return false;
+   char val[PROP_VALUE_MAX] = "";
+   if (__system_property_get("vendor.gralloc.disable_ubwc", val) > 0 &&
+       strcmp(val, "1") == 0)
+      return false;
+   return true;
+}
