-	ret = _iommu_map_sg(pt, addr, memdesc->sgt->sgl, memdesc->sgt->nents,
+	/* Map physical entries, not the DMA-coalesced attachment count. */
+	ret = _iommu_map_sg(pt, addr, memdesc->sgt->sgl, memdesc->sgt->orig_nents,
 			flags);
 	if (ret)
 		return ret;
