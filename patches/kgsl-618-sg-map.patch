--- a/drivers/gpu/msm/kgsl_iommu.c
+++ b/drivers/gpu/msm/kgsl_iommu.c
@@ -515,11 +515,14 @@
 		size_t mapped = 0;
 
 		ret = _iommu_map_scatterlist(pt, addr, s, flags, &mapped);
-		if (ret || mapped == 0)
-			break;
-
+		/* Include this entry's partial mapping in failure rollback. */
 		total_mapped += mapped;
