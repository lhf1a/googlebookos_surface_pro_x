+/* SQ2_EL2_PREBOOT_DESTINATION: qebspil runs in the late EBS callback and
+ * needs the final DT copy address before ExitBootServices().
+ */
+static efi_status_t sq2_preboot_set_destination(void *source, void *dest)
+{
+	const fdt64_t *property;
