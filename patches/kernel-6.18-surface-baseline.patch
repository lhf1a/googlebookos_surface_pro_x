+
+// Permission check functions
+bool only_manager(void)
+{
+	return is_manager();
+}
+
+bool only_root(void)
+{
+	return current_uid().val == 0;
+}
+
+bool manager_or_root(void)
+{
+	return current_uid().val == 0 || is_manager();
+}
+
+bool always_allow(void)
+{
+	return true; // No permission check
+}
