+
+		input-enable;
+		bias-disable;
+	};
+
+	i2c9_active: i2c9-active-state {
+		pins = "gpio39", "gpio40";
+		function = "qup9";
+
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+
+	uart13_state: uart13-state {
+		cts {
+			pins = "gpio43";
+			function = "qup13";
+			bias-pull-down;
+		};
+
+		rts-tx {
+			pins = "gpio44", "gpio45";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rx {
+			pins = "gpio46";
+			function = "qup13";
+			bias-pull-up;
+		};
+	};
+
+	uart15_state: uart15-state {
