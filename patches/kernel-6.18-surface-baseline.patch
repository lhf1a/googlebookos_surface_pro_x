+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Based on:
+ % - sc8180x-primus.dts
+ % - sc8180x-lenovo-flex-5g.dts
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/spmi/spmi.h>
+#include <dt-bindings/iio/qcom,spmi-vadc.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include "sc8180x.dtsi"
+#include "sc8180x-wcd9340.dtsi"
+
+
+/ {
+	model = "Microsoft Surface Pro X (SQ2)";
+
+	/* SQ2_EL2_PREBOOT_DT: the EFI stage fills these in before ExitBootServices. */
+	microsoft,el2-kernel-fdt = <0 0>;
+	microsoft,ipa-lab-once = <1>;
+	microsoft,el2-venus-prepared = <0 9 0x8c000000 0x500000>;
+	compatible = "microsoft,surface-pro-x", "qcom,sc8180x";
+
+	aliases {
+		serial0 = &uart15;
+		serial1 = &uart13;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+
+		pwms = <&pmc8180c_lpg 4 5000000>;
+		enable-gpios = <&pmc8180e_gpios 1 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&bl_pwm_default_state &bl_en_default_state>;
+	};
+
+	gpio-keys-volume {
+		compatible = "gpio-keys";
+		label = "Volume Buttons";
+		autorepeat;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_down_gpio &volume_up_gpio>;
+
+		volume-down {
+			label = "Volume Down";
+			gpios = <&pmc8180a_gpios 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+
+		volume-up {
+			label = "Volume Up";
+			gpios = <&pmc8180a_gpios 6 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+		};
+	};
+
+	chosen {
+	};
+
+	reserved-memory {
+		// Sources for memory regions:
+		// - Windows Device Manager/ACPI
+		// - Windows Registry/driver .inf files
+
+		// Windows Registry entries:
+		//
+		// - ADSP:
+		//   - alignment:     0x100000
+		//   - reservation:  0x1a00000
+		//
+		// - CDSP:
+		//   - alignment:     0x100000
+		//   - reservation:   0x800000
+		//
+		// - GFXSUC:
+		//   - alignment:       0x1000
+		//   - reservation:     0x5000
+		//
+		// - MPSS/MODEM:
+		//   - address:     0x8d800000
+		//   - alignment:     0x400000
+		//   - reservation:  0x9600000
+		//
+		// - SCSS/SLPI:
+		//   - alignment:     0x100000
+		//   - reservation:  0x1400000
+		//
+		// - IPA (no firmware?):
+		//   - alignment:     0x100000
+		//   - reservation:   0x100000
+		//
+		// - SPSS (no firmware?):
+		//   - alignment:     0x100000
+		//   - reservation:   0x100000
+		//
+		// - MBA (bogus?):
+		//   - alignment:     0x100000
+		//
+		// - VENUS (bogus?):
+		//   - alignment:          0x0
+		//   - reservation:   0x500000
+		//
+		// - WCNSS (bogus?):
+		//   - alignment:     0x100000
+		//   - reservation:        0x0
+
+		// Windows Device Manager memory map:
+		//
+		// [...]
+		// 0x85d00000 ++  0x200000	RMTFS
+		// 0x85f00000 ++ 0x5d00000	<free>
+		// 0x8b700000 ++  0x500000	CAMERA
+		// 0x8bc00000 ++  0x180000	WLAN
+		// 0x8bd80000 ++ 0xe780000	<free for image loader>
+		// 0x9a500000 ++  0x600000	QSM
+		// [...]
+
+		// Resulting memory map:
+		//
+		// [...]
+		// 0x85500000 ++  0x200000	RMTFS
+		// 0x85700000
+		// 0x85f00000 ++ 0x5d00000	<reserved>
+		// 0x8b700000 ++  0x500000	CAMERA
+		// 0x8bc00000 ++  0x180000	WLAN
+		// 0x8bd80000 ++ 0x1a80000	<free>
+		// 0x8d800000 ++ 0x9600000	MPSS
+		// 0x96e00000 ++ 0x1a00000	ADSP
+		// 0x98800000 ++  0x800000	CDSP
+		// 0x99000000 ++ 0x1400000	SCSS
+		// 0x9a400000 ++    0x5000	GFXSUC
+		// 0x9a405000 ++   0xfb000	<free>
+		// 0x9a500000 ++  0x600000	QSM
+		// [...]
+
+		// Notes:
+		// - RMTFS doesn't work at 0x85d00000, but does work at
+		//   0x85500000 (same as Lenovo Flex 5G).
+		// - An 8MB region for CDSP seems a bit small. Similarly, the
+		//   MPSS region seems to be a bit large... do we need to resize
+		//   things?
+
+		rmtfs_mem: memory@85500000 {
+			/* SQ2_EL2_PREBOOT_DT */
+			microsoft,el2-preboot-rmtfs;
+			microsoft,el2-preboot-complete = <0>;
+			microsoft,el2-preboot-status = <0 0 0 0 0 0>;
+			compatible = "qcom,rmtfs-mem";
+			reg = <0x0 0x85500000 0x0 0x200000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <15>;
+		};
+
+		wlan_mem: memory@8bc00000 {
+			reg = <0x0 0x8bc00000 0x0 0x180000>;
+			no-map;
+		};
+
+		mpss_mem: memory@8d800000 {
+			reg = <0x0 0x8d800000 0x0 0x9600000>;
+			no-map;
+		};
+
+		adsp_mem: memory@96e00000 {
+			reg = <0x0 0x96e00000 0x0 0x1a00000>;
+			no-map;
+		};
+
+		cdsp_mem: memory@98800000 {
+			reg = <0x0 0x98800000 0x0 0x800000>;
+			no-map;
+		};
+
+		scss_mem: memory@99000000 {
+			reg = <0x0 0x99000000 0x0 0x1400000>;
+			no-map;
+		};
+
+		gfxsuc_mem: memory@9a400000 {
+			reg = <0x0 0x9a400000 0x0 0x5000>;
+			no-map;
+		};
+	};
+
+	thermal-zones {
+		pmc8180a-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <0>;
+
+			thermal-sensors = <&pmc8180a_temp>;
+
+			trips {
+				trip0 {
+					temperature = <95000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				trip1 {
+					temperature = <115000>;
+					hysteresis = <0>;
+					type = "hot";
+				};
+
+				trip2 {
+					temperature = <145000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		pmc8180c-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <0>;
+
+			thermal-sensors = <&pmc8180c_temp>;
+
+			trips {
+				trip0 {
+					temperature = <95000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				trip1 {
+					temperature = <115000>;
+					hysteresis = <0>;
+					type = "hot";
+				};
+
+				trip2 {
+					temperature = <145000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+
+		pmc8180e-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <0>;
+
+			thermal-sensors = <&pmc8180e_temp>;
+
+			trips {
+				trip0 {
+					temperature = <95000>;
+					hysteresis = <0>;
+					type = "passive";
+				};
+
+				trip1 {
+					temperature = <115000>;
+					hysteresis = <0>;
+					type = "hot";
+				};
+
+				trip2 {
+					temperature = <145000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3300000>;	// TODO: measure this (see pm660.dtsi/vadc_vph_pwr)
+		regulator-max-microvolt = <3300000>;
+	};
+
+	vreg_s4a_1p8: pm8150-s4 {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_s4a_1p8";
+
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+
+		vin-supply = <&vph_pwr>;
+	};
+
+	/* copied from Flex 5G: wcd9340 GPIO 4 enables the amplifier battery rail (UNVERIFIED on Pro X) */
+	vreg_spkr_bat: regulator-speaker-bat {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_speaker_bat";
+
+		gpio = <&wcdgpio 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		regulator-always-on;
+		regulator-boot-on;
+
+		vin-supply = <&vph_pwr>;
+	};
+
+	vreg_ts_5p0: ts-5p0-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_ts_5p0";
+
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+
+		gpio = <&pmc8180e_gpios 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_5v_en_default_state>;
+	};
+};
+
