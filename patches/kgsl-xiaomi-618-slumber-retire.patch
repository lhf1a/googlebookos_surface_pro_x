+/* GPU IRQs are off and checked shutdown has completed; device->mutex is held. */
+static int a6xx_gmu_retire_contexts(struct adreno_device *adreno_dev)
+{
+	struct kgsl_device *device = KGSL_DEVICE(adreno_dev);
+	struct a6xx_gmu_device *gmu = to_a6xx_gmu(adreno_dev);
+	int ret;
+
+	ret = kgsl_mmu_set_pt(&device->mmu, device->mmu.defaultpagetable);
+	if (ret)
+		goto fail;
+	ret = a6xx_preemption_reset_records(adreno_dev);
+	if (ret)
+		goto fail;
+
+	adreno_drawctxt_retire_switches(adreno_dev);
+	adreno_set_active_ctxs_null(adreno_dev);
+	return 0;
+fail:
+	/* Hardware is off, but its old owners must survive incomplete retirement. */
+	if (!gmu->power_error)
+		gmu->power_error = ret;
+	if (!READ_ONCE(device->pwrctrl.transition_error))
+		WRITE_ONCE(device->pwrctrl.transition_error, ret);
+	return ret;
+}
