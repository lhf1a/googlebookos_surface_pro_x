--- a/drivers/gpu/msm/adreno.c
+++ b/drivers/gpu/msm/adreno.c
@@ -6,6 +6,7 @@
 #include <linux/component.h>
 #include <linux/delay.h>
 #include <linux/firmware.h>
+#include <linux/unaligned.h>
 #include <linux/input.h>
 #include <linux/interconnect.h>
 #include <linux/io.h>
@@ -67,17 +68,27 @@
 /* Number of milliseconds to stay active active after a wake on touch */
 unsigned int adreno_wake_timeout = 100;
 
-static u32 get_ucode_version(const u32 *data)
-{
-	u32 version;
-
-	version = data[1];
-
-	if ((version & 0xf) != 0xa)
-		return version;
-
-	version &= ~0xfff;
-	return  version | ((data[3] & 0xfff000) >> 12);
+static int get_ucode_version(const struct firmware *fw, u32 *version)
+{
+	u32 value;
+
+	/* The first dword is not loaded; the second holds the version. */
+	if (!fw || !fw->data || fw->size < 2 * sizeof(u32) ||
+			!IS_ALIGNED(fw->size, sizeof(u32)))
+		return -EINVAL;
+
+	value = get_unaligned_le32(fw->data + sizeof(u32));
+	if ((value & 0xf) == 0xa) {
+		if (fw->size < 4 * sizeof(u32))
+			return -EINVAL;
+
+		value = (value & ~0xfff) |
+			((get_unaligned_le32(fw->data + 3 * sizeof(u32)) &
+			  0xfff000) >> 12);
+	}
+
+	*version = value;
+	return 0;
 }
 
 int adreno_get_firmware(struct adreno_device *adreno_dev,
@@ -85,6 +96,7 @@
 {
 	struct kgsl_device *device = KGSL_DEVICE(adreno_dev);
 	const struct firmware *fw = NULL;
+	u32 version;
 	int ret;
 
 	if (!IS_ERR_OR_NULL(firmware->memdesc))
@@ -98,6 +110,10 @@
 		return ret;
 	}
 
+	ret = get_ucode_version(fw, &version);
+	if (ret)
+		goto out;
+
 	firmware->memdesc = kgsl_allocate_global(device, fw->size - 4, 0,
 				KGSL_MEMFLAGS_GPUREADONLY, KGSL_MEMDESC_UCODE,
 				"ucode");
@@ -106,9 +122,10 @@
 	if (!ret) {
 		memcpy(firmware->memdesc->hostptr, &fw->data[4], fw->size - 4);
 		firmware->size = (fw->size - 4) / sizeof(u32);
-		firmware->version = get_ucode_version((u32 *)fw->data);
-	}
-
+		firmware->version = version;
+	}
+
+out:
 	release_firmware(fw);
 	return ret;
 }
