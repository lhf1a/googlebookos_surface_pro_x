--- /dev/null
+++ b/techpack/display/msm/dp/dp_link_helpers.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Driver-owned DP link transactions using the current DRM AUX API. */
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <drm/display/drm_dp_helper.h>
+#include "dp_link_helpers.h"
+
+int sde_dp_link_configure(struct drm_dp_aux *aux, const struct dp_link_info *link)
+{
+	u8 values[2];
+	int ret;
+
+	if (!aux || !link)
+		return -EINVAL;
+	if (link->num_lanes != 1 && link->num_lanes != 2 && link->num_lanes != 4)
+		return -EINVAL;
+	if (link->capabilities & ~DP_LINK_INFO_ENHANCED_FRAMING)
+		return -EOPNOTSUPP;
+
+	/*
+	 * This path programs legacy LINK_BW_SET only. eDP supported-link-rate
+	 * tables/DP_LINK_RATE_SET and UHBR require separate negotiated paths;
+	 * never round an unsupported rate down to a legacy bandwidth code.
+	 */
+	switch (link->rate) {
+	case 162000:
+	case 270000:
+	case 540000:
+	case 810000:
+		values[0] = drm_dp_link_rate_to_bw_code(link->rate);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	values[1] = link->num_lanes;
+	if (link->capabilities & DP_LINK_INFO_ENHANCED_FRAMING)
+		values[1] |= DP_LANE_COUNT_ENHANCED_FRAME_EN;
+
+	ret = drm_dp_dpcd_write(aux, DP_LINK_BW_SET, values, sizeof(values));
+	if (ret < 0)
+		return ret;
+	return ret == sizeof(values) ? 0 : -EIO;
+}
+
+static int sde_dp_link_set_power(struct drm_dp_aux *aux,
+	const struct dp_link_info *link, bool up)
+{
+	u8 value;
+	int ret;
+
+	if (!aux || !link || link->revision < 0x10)
+		return -EINVAL;
+	/* DP 1.0 has no SET_POWER register. */
+	if (link->revision < 0x11)
+		return 0;
+
+	ret = drm_dp_dpcd_readb(aux, DP_SET_POWER, &value);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	value &= ~DP_SET_POWER_MASK;
+	value |= up ? DP_SET_POWER_D0 : DP_SET_POWER_D3;
+	ret = drm_dp_dpcd_writeb(aux, DP_SET_POWER, value);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	/* Keep the DP 1.1 sink's required 1 ms D0 exit interval. */
+	if (up)
+		usleep_range(1000, 2000);
+	return 0;
+}
+
+int sde_dp_link_power_up(struct drm_dp_aux *aux, const struct dp_link_info *link)
+{
+	return sde_dp_link_set_power(aux, link, true);
+}
+
+int sde_dp_link_power_down(struct drm_dp_aux *aux, const struct dp_link_info *link)
+{
+	return sde_dp_link_set_power(aux, link, false);
+}
