+#ifndef _SDE_DP_LINK_HELPERS_H_
+#define _SDE_DP_LINK_HELPERS_H_
+
+#include <linux/types.h>
+#include <linux/bits.h>
+
+struct drm_dp_aux;
+
+/* Driver-owned legacy 8b/10b link state, not an extension of DRM core types. */
+#define DP_LINK_INFO_ENHANCED_FRAMING BIT(0)
+struct dp_link_info {
+	u8 revision;
+	unsigned int rate;
+	unsigned int num_lanes;
+	unsigned long capabilities;
+};
+
+int sde_dp_link_configure(struct drm_dp_aux *aux, const struct dp_link_info *link);
+int sde_dp_link_power_up(struct drm_dp_aux *aux, const struct dp_link_info *link);
+int sde_dp_link_power_down(struct drm_dp_aux *aux, const struct dp_link_info *link);
