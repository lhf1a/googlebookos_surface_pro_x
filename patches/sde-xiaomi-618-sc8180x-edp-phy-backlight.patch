 #include <linux/of_device.h>
 #include "dp_debug.h"
 #include "dp_pll.h"
+#include "sde_generic_phy_owner.h"
+
+struct dp_pll_generic_phy {
+	struct sde_phy_owner owner;
+	struct phy_configure_opts_dp last_opts;
+	bool is_edp;
+	bool aux_active;
+};
+
+static int dp_pll_generic_aux_prepare(struct dp_pll *pll, bool is_edp)
+{
+	struct dp_pll_generic_phy *priv;
+	struct sde_phy_owner_status st = { 0 };
+	int rc;
+
+	if (!pll || !pll->priv)
+		return -EINVAL;
+	priv = pll->priv;
+	priv->is_edp = is_edp;
+	priv->aux_active = true;
+	rc = sde_phy_owner_status(&priv->owner, &st);
+	if (rc)
+		return rc;
+	if (st.initialized)
+		return 0;
+	return sde_phy_owner_prepare(&priv->owner, is_edp);
+}
+
+static void dp_pll_generic_aux_unprepare(struct dp_pll *pll)
+{
+	struct dp_pll_generic_phy *priv;
+
+	if (!pll || !pll->priv)
+		return;
+	priv = pll->priv;
+	priv->aux_active = false;
+	sde_phy_owner_stop(&priv->owner);
+}
+
+static int dp_pll_generic_cfg(struct dp_pll *pll, unsigned long rate)
+{
+	struct dp_pll_generic_phy *priv;
+	struct sde_phy_owner_status st = { 0 };
+	struct phy_configure_opts_dp opts = { 0 };
+	u8 lanes;
+	int rc;
+
+	if (!pll || !pll->priv)
+		return -EINVAL;
+	priv = pll->priv;
+	rc = sde_phy_owner_status(&priv->owner, &st);
+	if (rc)
+		return rc;
+	if (!st.initialized) {
+		rc = sde_phy_owner_prepare(&priv->owner, priv->is_edp);
+		if (rc)
+			return rc;
+	} else if (st.powered) {
+		rc = sde_phy_owner_stop(&priv->owner);
+		if (rc)
+			return rc;
+		rc = sde_phy_owner_prepare(&priv->owner, priv->is_edp);
+		if (rc)
+			return rc;
+	}
+
+	lanes = pll->pll_db.lane_cnt ? pll->pll_db.lane_cnt : 4;
+	opts.lanes = lanes;
+	opts.link_rate = rate / 100;
+	opts.ssc = pll->ssc_en ? 1 : 0;
+	opts.set_rate = 1;
+	opts.set_lanes = 1;
+	priv->last_opts = opts;
+	return sde_phy_owner_configure(&priv->owner, &opts);
+}
+
+static int dp_pll_generic_prepare(struct dp_pll *pll)
+{
+	struct dp_pll_generic_phy *priv;
+	struct sde_phy_owner_status st = { 0 };
+	int rc;
+
+	if (!pll || !pll->priv)
+		return -EINVAL;
+	priv = pll->priv;
+	rc = sde_phy_owner_status(&priv->owner, &st);
+	if (rc)
+		return rc;
+	if (st.powered)
+		return 0;
+	return sde_phy_owner_power_on(&priv->owner);
+}
+
+static int dp_pll_generic_unprepare(struct dp_pll *pll)
+{
+	struct dp_pll_generic_phy *priv;
+	struct sde_phy_owner_status st = { 0 };
+	int rc;
+
+	if (!pll || !pll->priv)
+		return -EINVAL;
+	priv = pll->priv;
+	rc = sde_phy_owner_status(&priv->owner, &st);
+	if (rc)
+		return rc;
+	if (!st.powered)
+		return 0;
+	rc = sde_phy_owner_stop(&priv->owner);
+	if (rc)
+		return rc;
+	if (priv->aux_active)
+		rc = sde_phy_owner_prepare(&priv->owner, priv->is_edp);
+	return rc;
+}
+
+static int dp_pll_generic_update_vx_px(struct dp_pll *pll,
+		u8 v_level, u8 p_level)
+{
+	struct dp_pll_generic_phy *priv;
+	struct phy_configure_opts_dp opts;
+	unsigned int i;
+
+	if (!pll || !pll->priv)
+		return -EINVAL;
+	priv = pll->priv;
+	if (v_level > 3)
+		v_level = 3;
+	if (p_level > 3)
+		p_level = 3;
+	if (v_level + p_level > 3)
+		p_level = 3 - v_level;
+
+	opts = priv->last_opts;
+	opts.set_rate = 0;
+	opts.set_lanes = 0;
+	opts.set_voltages = 1;
+	for (i = 0; i < opts.lanes && i < 4; i++) {
+		opts.voltage[i] = v_level;
+		opts.pre[i] = p_level;
+	}
+	priv->last_opts = opts;
+	return sde_phy_owner_configure(&priv->owner, &opts);
+}
 
