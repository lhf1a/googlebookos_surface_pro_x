+/* Called only before GPU boot or after a future verified retirement protocol. */
+static int kgsl_iommu_release_parent(struct kgsl_pagetable *pt)
+{
+	struct kgsl_device *device = KGSL_MMU_DEVICE(pt->mmu);
+	struct kgsl_iommu *iommu = _IOMMU_PRIV(pt->mmu);
+	struct kgsl_iommu_pt *priv = pt->priv;
+	struct adreno_smmu_priv *smmu = &device->smmu;
+	int ret;
+
+	if (iommu->started || priv->poisoned)
+		return -EBUSY;
+	if (refcount_read(&pt->refcount.refcount) != (priv->bootstrap ? 2 : 1))
+		return -EBUSY;
+	if (priv->bootstrap_enabled) {
+		ret = smmu->set_ttbr0_cfg(smmu->cookie, NULL);
+		if (ret)
+			return ret;
+		priv->bootstrap_enabled = false;
+	}
+	if (priv->bootstrap) {
+		ret = kgsl_iommu_table_destroy(priv->bootstrap);
+		if (ret)
+			return ret;
+		priv->bootstrap = NULL;
+	}
+	if (priv->attached) {
+		if (!smmu->cookie || !smmu->flush_tlb)
+			return -ENODEV;
+		ret = smmu->flush_tlb(smmu->cookie);
+		if (ret)
+			return ret;
+		iommu_detach_device(priv->domain, &device->pdev->dev);
+		if (iommu_get_domain_for_dev(&device->pdev->dev) == priv->domain)
+			return -EBUSY;
+		priv->attached = false;
+	}
+	/* Caller holds SMMU runtime PM through detach and domain free. */
+	iommu_domain_free(priv->domain);
+	memset(smmu, 0, sizeof(*smmu));
+	kfree(priv);
+	pt->priv = NULL;
+	return 0;
 }
 
