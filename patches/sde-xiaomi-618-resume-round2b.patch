+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MINIMAL COMPATIBILITY HEADER - NOT A VENDOR-EQUIVALENT HEADER
+ *
+ * Round2 KGSL+SDE 6.18 port, sde-hw-encoder-dp agent.
+ *
+ * The 6.18 prepared kernel has no public <soc/qcom/minidump.h>.  The only
+ * in-tree consumer is techpack/display/msm/sde_dbg.c (sibling "dbg" scope),
+ * which uses exactly:
+ *   struct md_region md_entry;
+ *   strscpy(md_entry.name, name, sizeof(md_entry.name));
+ *   md_entry.virt_addr = (uintptr_t)virt_addr;
+ *   md_entry.phys_addr = virt_to_phys(virt_addr);
+ *   md_entry.size = size;
+ *   return msm_minidump_add_region(&md_entry);    (CONFIG_QCOM_VA_MINIDUMP)
+ *
+ * The prepared KOUT .config does NOT set CONFIG_QCOM_VA_MINIDUMP, so this
+ * header mirrors the vendor convention of a no-op inline helper when the
+ * config is disabled.  In that configuration the display driver does not
+ * publish any minidump region; that behaviour is unvalidated but is not a
+ * fake success path (it returns 0 exactly like the vendor stub).
+ *
+ * PROVENANCE / LIMITS (recorded in STATUS.json):
+ *  - Struct shape is derived from the call site; when CONFIG_QCOM_VA_MINIDUMP
+ *    is enabled a real kernel provider must be supplied (none exists in the
+ *    6.18 prepared tree), which is listed as a remaining blocker.
+ *  - The file is created under the display include path so sibling-owned
+ *    sde_dbg.c can compile; sde-hw-encoder-dp does not modify sde_dbg.c.
+ *  - hardware_validated = false; minidump capture is unvalidated.
+ */
+#ifndef __SOC_QCOM_MINIDUMP_COMPAT_H
+#define __SOC_QCOM_MINIDUMP_COMPAT_H
+
+#include <linux/types.h>
+
+#define MAX_NAME_LENGTH 20
+
+struct md_region {
+	char name[MAX_NAME_LENGTH];
+	uintptr_t virt_addr;
+	uintptr_t phys_addr;
+	u64 size;
+	u32 id;
+};
+
+#if IS_ENABLED(CONFIG_QCOM_VA_MINIDUMP)
+int msm_minidump_add_region(const struct md_region *entry);
+#else
+static inline int msm_minidump_add_region(const struct md_region *entry)
+{
+	return 0;
+}
+#endif
+
+#endif /* __SOC_QCOM_MINIDUMP_COMPAT_H */
