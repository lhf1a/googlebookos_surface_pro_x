+ *   static int dp_audio_info_setup(struct platform_device *,
+ *       struct msm_ext_disp_audio_setup_params *params) -> params->num_of_channels
+ *   static int dp_audio_get_edid_blk(struct platform_device *,
+ *       struct msm_ext_disp_audio_edid_blk *blk) -> blk->audio_data_blk,
+ *       audio_data_blk_size, spk_alloc_data_blk, spk_alloc_data_blk_size
+ *   EXT_DISPLAY_TYPE_DP, EXT_DISPLAY_CABLE_CONNECT,
+ *   EXT_DISPLAY_CABLE_DISCONNECT
+ *   msm_ext_disp_register_intf()/deregister_intf() (guarded by
+ *   #if defined(CONFIG_MSM_EXT_DISPLAY), which is not set here)
+ *
+ * PROVENANCE / LIMITS (recorded in STATUS.json):
+ *  - Member types/layout are inferred from the call-site assignments only;
+ *    they are NOT copied from the absent vendor header.
+ *  - The external-display audio bridge does not exist in the 6.18 kernel, so
+ *    this header only restores compilability.  The coded paths are compiled
+ *    out by the absent CONFIG_MSM_EXT_DISPLAY; feature is unvalidated.
+ *  - hardware_validated = false.
