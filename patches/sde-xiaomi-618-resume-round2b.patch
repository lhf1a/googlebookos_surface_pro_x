@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Driver-owned downstream Qualcomm format modifiers (Round2 6.18 port).
+ *
+ * 6.18's <drm/drm_fourcc.h> only carries the mainline QCOM codes:
+ *     DRM_FORMAT_MOD_QCOM_COMPRESSED   fourcc_mod_code(QCOM, 1)
+ *     DRM_FORMAT_MOD_QCOM_TILED2       fourcc_mod_code(QCOM, 2)
+ *     DRM_FORMAT_MOD_QCOM_TILED3       fourcc_mod_code(QCOM, 3)
+ * The downstream SDE format tables (sde/sde_hw_catalog_format.h, and the
+ * sibling-owned sde/sde_formats.c matcher) compose the vendor UBWC modifier as
+ * a bit field of COMPRESSED | DX | TIGHT | TILE, so they need the vendor-only
+ * TILE/DX/TIGHT bits that mainline never took.
+ *
+ * DONOR VALUES (fourcc_mod_code(QCOM, n) = vendor 0x05 << 56 | n):
+ *     DRM_FORMAT_MOD_QCOM_COMPRESSED = 0x1  (also present in 6.18 core)
+ *     DRM_FORMAT_MOD_QCOM_DX         = 0x2
+ *     DRM_FORMAT_MOD_QCOM_TIGHT      = 0x4
+ *     DRM_FORMAT_MOD_QCOM_TILE       = 0x8
+ *
+ * PROVENANCE: the same values are used by the captured SQ2 Android display
+ * stack that this driver serves:
+ *   <workspace>/work/qualcomm-618/sde-resume-20261111/mode-userland-inputs/
+ *       references/kernel-uapi/drm/drm_fourcc.h  (lines 448-472:
+ *       COMPRESSED 1, DX 0x2, TIGHT 0x4, TILE 0x8)
+ *   <same>/source/sdm/libs/core/drm/hw_device_drm.cpp  (lines 112-116 local
+ *       fallbacks define DX as fourcc_mod_code(QCOM, 0x2) and TIGHT as
+ *       fourcc_mod_code(QCOM, 0x4); format selection at lines 274-294)
+ * This mirrors what the vendor kernel uapi carried; it is NOT a core-header
+ * edit and NOT a re-definition of the mainline TILED2/TILED3 codes.
+ *
+ * LIMITS:
+ *  - DRM_FORMAT_MOD_QCOM_DX (0x2) is numerically equal to mainline
+ *    DRM_FORMAT_MOD_QCOM_TILED2 (0x2), and COMPRESSED|DX (0x3) is numerically
+ *    equal to mainline TILED3.  The downstream tables only ever use the
+ *    vendor bit-field encoding and never mix it with the mainline TILED2/3
+ *    symbolic names; do not compare a vendor-derived modifier against the
+ *    mainline TILED2/TILED3 semantics.
+ *  - These constants only restore the downstream tables' compilability.  The
+ *    actual UBWC modifier acceptance path is unvalidated (hardware_validated =
+ *    false); the 6.18 core must not be assumed to understand these bits.
+ *  - The #ifndef guards keep this header safe if a future core header starts
+ *    defining the same vendor names.
+ */
+#ifndef __DRM_SDE_DRM_FOURCC_H__
+#define __DRM_SDE_DRM_FOURCC_H__
+
+#include <drm/drm_fourcc.h>
+
+#ifndef DRM_FORMAT_MOD_QCOM_DX
+#define DRM_FORMAT_MOD_QCOM_DX fourcc_mod_code(QCOM, 0x2)
+#endif
+
+#ifndef DRM_FORMAT_MOD_QCOM_TIGHT
+#define DRM_FORMAT_MOD_QCOM_TIGHT fourcc_mod_code(QCOM, 0x4)
+#endif
+
+#ifndef DRM_FORMAT_MOD_QCOM_TILE
+#define DRM_FORMAT_MOD_QCOM_TILE fourcc_mod_code(QCOM, 0x8)
+#endif
+
+#endif /* __DRM_SDE_DRM_FOURCC_H__ */
