+static void msm_dp_display_ensure_kms_phy_sel(struct msm_dp_display_private *dp)
+{
+	struct device *kms_dev;
+
+	if (dp->msm_dp_display.is_edp || !dp->drm_dev)
+		return;
+
+	kms_dev = dp->drm_dev->dev;
+	if (!kms_dev)
+		return;
+
+	/*
+	 * On platforms such as SC8180X where MDP_DP_PHY_INTF_SEL lives inside
+	 * DPU_TOP (under MDSS_GDSC), waking an external DP controller while the
+	 * sibling DPU KMS device is still runtime-suspended after an MDSS_GDSC
+	 * collapse leaves MDP_DP_PHY_INTF_SEL cleared to 0, breaking DP AUX.
+	 * Transiently resume DPU while DP holds MDSS_GDSC active so
+	 * dpu_runtime_resume() restores MDP_DP_PHY_INTF_SEL before AUX runs.
+	 */
+	if (pm_runtime_resume_and_get(kms_dev) == 0)
+		pm_runtime_put_sync(kms_dev);
+}
