+int HWCBufferAllocator::GetBufferLayout(const AllocatedBufferInfo &buf_info,
+                                        uint32_t stride[4], uint32_t offset[4],
+                                        uint32_t *num_planes) {
+  if (!stride || !offset || !num_planes || !buf_info.native_handle) return -EINVAL;
+  *num_planes = 0;
+  int err = GetGrallocInstance();
+  if (err) return err;
+  auto native = static_cast<const native_handle_t *>(buf_info.native_handle);
+  uint64_t size = 0, modifier = 0;
+  int32_t format = 0;
+  if (!ReadMetadata<Metadata::ALLOCATION_SIZE>(mapper_, native, &size) ||
+      !ReadMetadata<Metadata::PIXEL_FORMAT_MODIFIER>(mapper_, native, &modifier) ||
+      !ReadMetadata<Metadata::PIXEL_FORMAT_REQUESTED>(mapper_, native, &format) ||
+      AllocatedFormat(format, modifier) != buf_info.format) return -EINVAL;
+
+  // Pass the real imported handle: the newer SM8350 struct is not the donor's full ABI.
+  auto handle = reinterpret_cast<private_handle_t *>(const_cast<native_handle_t *>(native));
+  err = gralloc::GetBufferLayout(handle, stride, offset, num_planes);
+  if (err || !*num_planes || *num_planes > 4) {
+    *num_planes = 0;
+    return err ? err : -EINVAL;
+  }
+  for (uint32_t i = 0; i < *num_planes; ++i) {
+    if (!stride[i] || offset[i] >= size) {
+      *num_planes = 0;
+      return -EINVAL;
+    }
+  }
+  return 0;
+}
