+int MapperError(AIMapper_Error error) {
+  switch (error) {
+    case AIMAPPER_ERROR_NONE: return 0;
+    case AIMAPPER_ERROR_BAD_BUFFER: case AIMAPPER_ERROR_BAD_VALUE: return -EINVAL;
+    case AIMAPPER_ERROR_UNSUPPORTED: return -ENOTSUP;
+    default: return -ENOMEM;
+  }
+}
+template<Metadata T, class Value>
+bool ReadMetadata(AIMapper *mapper, buffer_handle_t handle, Value *out) {
+  int32_t size = mapper->v5.getStandardMetadata(handle, int64_t(T), nullptr, 0);
+  if (size <= 0 || size > 4096) return false;
+  std::vector<uint8_t> bytes(size);
+  if (mapper->v5.getStandardMetadata(handle, int64_t(T), bytes.data(), bytes.size()) != size)
+    return false;
+  auto value = android::hardware::graphics::mapper::StandardMetadata<T>::value::decode(
+      bytes.data(), bytes.size());
+  if (!value) return false;
+  *out = static_cast<Value>(*value);
+  return true;
+}
+
+LayerBufferFormat AllocatedFormat(int format, uint64_t modifier) {
+  if (modifier == 0x0500000000000001ULL) {
+    switch (format) {
+      case HAL_PIXEL_FORMAT_RGBA_8888: return kFormatRGBA8888Ubwc;
+      case HAL_PIXEL_FORMAT_RGBX_8888: return kFormatRGBX8888Ubwc;
+      case HAL_PIXEL_FORMAT_RGBA_1010102: return kFormatRGBA1010102Ubwc;
+      default: return kFormatInvalid;
+    }
+  }
