--- a/drivers/gpu/msm/kgsl_pwrscale.c
+++ b/drivers/gpu/msm/kgsl_pwrscale.c
@@ -878,7 +878,29 @@
 
 	devfreq = devfreq_add_device(&pdev->dev, &gpu_profile->profile,
