+				governor, gov_err);
+			devfreq = devfreq_add_device(&pdev->dev,
+					&gpu_profile->profile,
+					"simple_ondemand", NULL);
+		}
+	}
 	if (IS_ERR(devfreq)) {
+		destroy_workqueue(pwrscale->devfreq_wq);
+		pwrscale->devfreq_wq = NULL;
+		if (kgsl_midframe) {
+			hrtimer_cancel(&kgsl_midframe->timer);
+			kfree(kgsl_midframe);
+			kgsl_midframe = NULL;
+		}
+		srcu_cleanup_notifier_head(&pwrscale->nh);
