+
+static bool a6xx_reset_mem_valid(struct kgsl_memdesc *memdesc, u64 size)
+{
+	return !IS_ERR_OR_NULL(memdesc) && memdesc->hostptr &&
+		memdesc->size >= size;
+}
+
+/* Called with device->mutex and GPU IRQs off, after checked hard shutdown. */
+int a6xx_preemption_reset_records(struct adreno_device *adreno_dev)
+{
+	struct kgsl_device *device = KGSL_DEVICE(adreno_dev);
+	struct kgsl_iommu *iommu = KGSL_IOMMU_PRIV(device);
+	struct adreno_preemption *preempt = &adreno_dev->preempt;
+	struct adreno_ringbuffer *rb;
+	bool enabled = adreno_is_preemption_enabled(adreno_dev);
+	u32 cntl = A6XX_CP_RB_CNTL_DEFAULT |
+		(ADRENO_FEATURE(adreno_dev, ADRENO_APRIV) ? 0 : (1 << 27));
+	unsigned int i;
+
+	/* Secure restore records cannot be rewritten through a CPU mapping. */
+	if (device->mmu.secured)
+		return -EOPNOTSUPP;
+	if (IS_ERR_OR_NULL(device->mmu.defaultpagetable) ||
+		!MMU_DEFAULT_TTBR0(device))
+		return -ENODEV;
+	if (!adreno_dev->num_ringbuffers)
+		return -EINVAL;
+
+	/* Validate every buffer before changing any restore state. */
+	FOR_EACH_RINGBUFFER(adreno_dev, rb, i) {
+		if (!a6xx_reset_mem_valid(rb->pagetable_desc,
+				sizeof(struct adreno_ringbuffer_pagetable_info)))
+			return -EINVAL;
+		if (enabled && (!a6xx_reset_mem_valid(rb->preemption_desc,
+				sizeof(struct a6xx_cp_preemption_record)) ||
+				IS_ERR_OR_NULL(rb->buffer_desc)))
+			return -EINVAL;
+	}
+	if (enabled && (!a6xx_reset_mem_valid(iommu->smmu_info,
+			sizeof(struct a6xx_cp_smmu_info)) ||
+		!a6xx_reset_mem_valid(preempt->scratch,
+			adreno_dev->num_ringbuffers * sizeof(u64))))
+		return -EINVAL;
+
+	if (enabled) {
+		timer_delete_sync(&preempt->timer);
+		adreno_set_preempt_state(adreno_dev, ADRENO_PREEMPT_NONE);
+		memset(preempt->scratch->hostptr, 0, preempt->scratch->size);
+		memset(iommu->smmu_info->hostptr, 0, iommu->smmu_info->size);
+		kgsl_sharedmem_writel(iommu->smmu_info,
+			PREEMPT_SMMU_RECORD(magic), A6XX_CP_SMMU_INFO_MAGIC_REF);
+		kgsl_sharedmem_writeq(iommu->smmu_info,
+			PREEMPT_SMMU_RECORD(ttbr0), MMU_DEFAULT_TTBR0(device));
+		kgsl_sharedmem_writel(iommu->smmu_info,
+			PREEMPT_SMMU_RECORD(asid), 0xDECAFBAD);
+		kgsl_sharedmem_writel(iommu->smmu_info,
+			PREEMPT_SMMU_RECORD(context_idr), MMU_DEFAULT_CONTEXTIDR(device));
+	}
+
+	FOR_EACH_RINGBUFFER(adreno_dev, rb, i) {
+		if (enabled) {
+			memset(rb->preemption_desc->hostptr, 0, rb->preemption_desc->size);
+			kgsl_sharedmem_writel(rb->preemption_desc,
+				PREEMPT_RECORD(magic), A6XX_CP_CTXRECORD_MAGIC_REF);
+			kgsl_sharedmem_writel(rb->preemption_desc,
+				PREEMPT_RECORD(cntl), cntl);
+			kgsl_sharedmem_writeq(rb->preemption_desc,
+				PREEMPT_RECORD(rptr_addr), SCRATCH_RPTR_GPU_ADDR(device, rb->id));
+			kgsl_sharedmem_writeq(rb->preemption_desc,
+				PREEMPT_RECORD(rbase), rb->buffer_desc->gpuaddr);
+		}
+		memset(rb->pagetable_desc->hostptr, 0, rb->pagetable_desc->size);
+		adreno_ringbuffer_set_pagetable(rb, device->mmu.defaultpagetable);
+		rb->wptr = rb->_wptr = 0;
+		rb->skip_inline_wptr = false;
+	}
+	adreno_dev->next_rb = NULL;
+	adreno_dev->prev_rb = NULL;
+	adreno_dev->cur_rb = &adreno_dev->ringbuffers[0];
+	wmb();
+	return 0;
 }
 
