+/* Caller holds device->mutex; GPU is reset, roots and restore records replaced. */
+void adreno_drawctxt_retire_switches(struct adreno_device *adreno_dev)
+{
+	struct kgsl_device *device = KGSL_DEVICE(adreno_dev);
+	struct adreno_ringbuffer *rb;
+	struct adreno_context_switch *switch_ref, *tmp;
+	int i;
+
+	FOR_EACH_RINGBUFFER(adreno_dev, rb, i) {
+		LIST_HEAD(release);
+
+		spin_lock(&rb->events.lock);
+		list_for_each_entry_safe(switch_ref, tmp,
+				&rb->context_switches, node) {
+			if (switch_ref->event_pending)
+				switch_ref->stopped = true;
+			else
+				list_move_tail(&switch_ref->node, &release);
+		}
+		spin_unlock(&rb->events.lock);
+
+		/* Queued callbacks keep their records until they run. */
+		kgsl_cancel_events(device, &rb->events);
+		list_for_each_entry_safe(switch_ref, tmp, &release, node) {
+			list_del(&switch_ref->node);
+			kgsl_context_put(&switch_ref->drawctxt->base);
+			kfree(switch_ref);
+		}
+	}
 }
 
